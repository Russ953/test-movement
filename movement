-- ==========================================
-- MOVEMENT SCRIPT v6
-- ==========================================
print("[Movement] v6 loaded")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local mapPart = workspace:WaitForChild("Laser Game Map"):WaitForChild("Cylinder.005")
local lasersFolder = workspace:WaitForChild("Lasers"):WaitForChild("ActiveLasers")

local maxMapDimension = math.max(mapPart.Size.X, mapPart.Size.Y, mapPart.Size.Z)
local safeRadius = (maxMapDimension / 2) - 5
local mapCenter = mapPart.Position

local JUMP_TRIGGER_DISTANCE = 5.5
local AGGRO_DISTANCE = 15
local CLEARANCE_DISTANCE = 6
local JUMP_COOLDOWN = 0.1

local lastLaserCFrames = setmetatable({}, {__mode = "k"})
local lastJumpTime = 0

local lastDebugPrint = 0
local DEBUG_INTERVAL = 0.25

-- ==========================================
-- ARC VISUALIZER SETUP
-- ==========================================
local vizFolder = workspace:FindFirstChild("JumpArcVisualizer")
if not vizFolder then
	vizFolder = Instance.new("Folder")
	vizFolder.Name = "JumpArcVisualizer"
	vizFolder.Parent = workspace
end

local vizParts = {}
for i = 1, 15 do
	local p = Instance.new("Part")
	p.Size = Vector3.new(0.4, 0.4, 0.4)
	p.Anchored = true
	p.CanCollide = false
	p.Material = Enum.Material.Neon
	p.Shape = Enum.PartType.Ball
	p.Transparency = 1
	p.Parent = vizFolder
	vizParts[i] = p
end

local function hideVisualizer()
	for _, p in ipairs(vizParts) do
		p.Transparency = 1
	end
end

-- ==========================================
-- KINEMATIC TRAJECTORY PREDICTION
-- ==========================================
local function predictJumpSafety(laser, laserVelocity)
	if not laser then return false end

	local g = workspace.Gravity
	local jumpPower = humanoid.UseJumpPower and humanoid.JumpPower or math.sqrt(2 * g * humanoid.JumpHeight)
	local walkSpeed = humanoid.WalkSpeed

	local moveDir = humanoid.MoveDirection
	if moveDir.Magnitude == 0 then moveDir = rootPart.CFrame.LookVector end

	local timeInAir = (2 * jumpPower) / g
	local steps = 15
	local timeStep = timeInAir / steps

	local startPos = rootPart.Position
	local isSafe = true

	for i = 1, steps do
		local t = i * timeStep

		local pX = startPos.X + (moveDir.X * walkSpeed * t)
		local pZ = startPos.Z + (moveDir.Z * walkSpeed * t)
		local pY = startPos.Y + (jumpPower * t) - (0.5 * g * t * t)
		local trajectoryPoint = Vector3.new(pX, pY, pZ)

		local futureLaserPos = laser.Position + (laserVelocity * t)
		local futureLaserCFrame = laser.CFrame - laser.Position + futureLaserPos

		local localPoint = futureLaserCFrame:PointToObjectSpace(trajectoryPoint)

		local boundX = (laser.Size.X / 2) + 1.2
		local boundY = (laser.Size.Y / 2) + 2.6
		local boundZ = (laser.Size.Z / 2) + 1.2

		if math.abs(localPoint.X) < boundX and math.abs(localPoint.Y) < boundY and math.abs(localPoint.Z) < boundZ then
			isSafe = false
		end

		vizParts[i].Position = trajectoryPoint
		vizParts[i].Transparency = 0
	end

	local arcColor = isSafe and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
	for i = 1, steps do
		vizParts[i].Color = arcColor
	end

	return isSafe
end

-- ==========================================
-- MAIN LOGIC
-- ==========================================
local function clampToSafeZone(targetPos)
	local offset = targetPos - mapCenter
	local flatOffset = Vector3.new(offset.X, 0, offset.Z)
	if flatOffset.Magnitude > safeRadius then
		local clampedFlat = flatOffset.Unit * safeRadius
		return Vector3.new(mapCenter.X + clampedFlat.X, targetPos.Y, mapCenter.Z + clampedFlat.Z)
	end
	return targetPos
end

local function getClosestLaser(dt, now)
	local closestLaser = nil
	local minDistance = math.huge
	local closestTargetPos = nil
	local laserVelocity = Vector3.zero
	local canJumpClosest = false

	local playerPos = rootPart.Position
	local shouldPrint = (now - lastDebugPrint) >= DEBUG_INTERVAL

	for _, item in ipairs(lasersFolder:GetChildren()) do
		if item:IsA("BasePart") then
			item.CanCollide = false

			local objPos = item.CFrame:PointToObjectSpace(playerPos)
			local distToLine = math.abs(objPos.Z)

			local currentSide = math.sign(objPos.Z)
			if currentSide == 0 then currentSide = 1 end

			local oldCF = lastLaserCFrames[item]
			lastLaserCFrames[item] = item.CFrame

			local currentVel = Vector3.zero
			local isMovingAway = false
			local sweepDot = 0
			local transDot = 0

			if oldCF then
				-- World-space translation velocity
				local posDelta = item.Position - oldCF.Position
				currentVel = posDelta / dt

				local toPlayer = Vector3.new(
					playerPos.X - item.Position.X,
					0,
					playerPos.Z - item.Position.Z
				)

				if toPlayer.Magnitude > 0.01 then
					local toPlayerUnit = toPlayer.Unit

					-- CHECK 1: Translation (for lasers that slide)
					local flatVel = Vector3.new(currentVel.X, 0, currentVel.Z)
					transDot = flatVel:Dot(toPlayerUnit)

					-- CHECK 2: Rotation / sweep (for pivot lasers whose position never changes)
					-- The laser's local Z axis points along its length.
					-- We compare where that Z axis pointed last frame vs this frame
					-- relative to the player direction to see which way it is sweeping.
					local oldFwd = Vector3.new(oldCF.LookVector.X, 0, oldCF.LookVector.Z)
					local newFwd = Vector3.new(item.CFrame.LookVector.X, 0, item.CFrame.LookVector.Z)

					if oldFwd.Magnitude > 0.01 and newFwd.Magnitude > 0.01 then
						-- Angular velocity direction via cross product (Y component = rotation around Y axis)
						local cross = oldFwd:Cross(newFwd)
						-- If cross.Y > 0 the laser rotated counter-clockwise, < 0 clockwise
						-- The tip of the laser moves in the direction perpendicular to LookVector
						-- We need to know if that sweep is carrying the beam AWAY from the player
						-- Tip velocity direction = cross(up, lookVector) * sign(cross.Y)
						local up = Vector3.new(0, 1, 0)
						local sweepDir = up:Cross(newFwd) * math.sign(cross.Y + 1e-9)
						if sweepDir.Magnitude > 0.01 then
							sweepDot = sweepDir.Unit:Dot(toPlayerUnit)
						end
					end

					-- Moving away if EITHER translation is going away OR sweep is going away
					-- Use a small threshold to filter noise
					local isTransAway = transDot < -0.05
					local isSweepAway = sweepDot < -0.1
					isMovingAway = isTransAway or isSweepAway
				end
			end

			if shouldPrint and distToLine <= AGGRO_DISTANCE then
				print(string.format(
					"[DBG] '%s' dist=%.2f side=%d transDot=%.3f sweepDot=%.3f away=%s canJump=%s",
					item.Name, distToLine, currentSide,
					transDot, sweepDot,
					tostring(isMovingAway), tostring(not isMovingAway)
				))
			end

			local isEscaping = false
			if isMovingAway then
				if distToLine < CLEARANCE_DISTANCE then
					isEscaping = true
				else
					continue
				end
			end

			if distToLine < minDistance then
				minDistance = distToLine
				closestLaser = item
				laserVelocity = currentVel
				canJumpClosest = not isMovingAway

				local targetSide = isEscaping and currentSide or -currentSide
				local walkThroughZ = targetSide * 15
				closestTargetPos = item.CFrame * Vector3.new(objPos.X, 0, walkThroughZ)
			end
		end
	end

	if shouldPrint then
		lastDebugPrint = now
	end

	return closestLaser, closestTargetPos, minDistance, laserVelocity, canJumpClosest
end

RunService.Heartbeat:Connect(function(dt)
	if not character or humanoid.Health <= 0 then
		hideVisualizer()
		return
	end

	local now = tick()
	local laser, targetPos, dist, laserVelocity, canJump = getClosestLaser(dt, now)
	local currentState = humanoid:GetState()
	local isInAir = (currentState == Enum.HumanoidStateType.Freefall or currentState == Enum.HumanoidStateType.Jumping)

	if (now - lastJumpTime) < JUMP_COOLDOWN then
		canJump = false
	end

	if laser and targetPos then
		if dist <= AGGRO_DISTANCE then
			local safeTarget = clampToSafeZone(targetPos)
			humanoid:MoveTo(safeTarget)

			if canJump and dist <= JUMP_TRIGGER_DISTANCE + 5 and not isInAir then
				local jumpIsSafe = predictJumpSafety(laser, laserVelocity)

				if dist <= JUMP_TRIGGER_DISTANCE and jumpIsSafe then
					print(string.format(
						"[JUMP] Firing! laser='%s' dist=%.2f canJump=%s safe=%s",
						laser.Name, dist, tostring(canJump), tostring(jumpIsSafe)
					))
					lastJumpTime = now
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			elseif isInAir or not canJump then
				hideVisualizer()
			end
		else
			hideVisualizer()
			if not isInAir then humanoid:MoveTo(mapCenter) end
		end
	else
		hideVisualizer()
		if not isInAir then
			humanoid:MoveTo(mapCenter)
		end
	end
end)
