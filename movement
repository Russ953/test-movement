-- Draws the arc, optionally with a dive at diveFrac of tAir
-- Returns: landPos
local function drawJumpArc(step, startPos, dir, jp, tAir, g, ws, diveFrac)
    local pool = arcPools[step]
    local fade = 0.1 + 0.25*(step-1)/MAX_PLAN_STEPS
    local md   = Vector3.new(dir.X, 0, dir.Z).Unit

    if diveFrac then
        -- Phase 1: normal arc up to diveFrac * tAir
        local tDive = diveFrac * tAir
        local phase1Steps = math.floor(ARC_DOTS * diveFrac)
        local divePos
        for i = 1, phase1Steps do
            local t = tDive * (i / phase1Steps)
            pool[i].Position = Vector3.new(
                startPos.X + md.X*ws*t,
                startPos.Y + jp*t - 0.5*g*t*t,
                startPos.Z + md.Z*ws*t)
            pool[i].Transparency = fade
            if i == phase1Steps then
                divePos = pool[i].Position
            end
        end
        -- Mark dive trigger point
        if divePos then
            diveDots[step].Position = divePos
            diveDots[step].Transparency = 0.2
        end
        -- Phase 2: straight down after dive
        -- velocity at dive point: vY = jp - g*tDive, horizontal stops
        local vYatDive = jp - g * tDive
        local phase2Steps = ARC_DOTS - phase1Steps
        local tFallTotal = (vYatDive + math.sqrt(vYatDive*vYatDive + 2*g*(divePos.Y - FLOOR_Y))) / g
        for i = 1, phase2Steps do
            local tf = tFallTotal * (i / phase2Steps)
            local idx = phase1Steps + i
            if pool[idx] then
                pool[idx].Position = Vector3.new(
                    divePos.X,
                    divePos.Y + vYatDive*tf - 0.5*g*tf*tf,
                    divePos.Z)
                pool[idx].Transparency = fade
            end
        end
        local landP = clampArena and clampArena(Vector3.new(divePos.X, FLOOR_Y+0.5, divePos.Z))
            or Vector3.new(divePos.X, FLOOR_Y+0.5, divePos.Z)
        landDots[step].Position = landP; landDots[step].Transparency = fade
        return landP
    else
        -- Normal arc
        local ts = tAir / ARC_DOTS
        for i = 1, ARC_DOTS do
            local t = i * ts
            pool[i].Position = Vector3.new(
                startPos.X + md.X*ws*t,
                startPos.Y + jp*t - 0.5*g*t*t,
                startPos.Z + md.Z*ws*t)
            pool[i].Transparency = fade
        end
        diveDots[step].Transparency = 1
        local lp = Vector3.new(startPos.X+md.X*ws*tAir, FLOOR_Y+0.5, startPos.Z+md.Z*ws*tAir)
        landDots[step].Position = lp; landDots[step].Transparency = fade
        return lp
    end
end

