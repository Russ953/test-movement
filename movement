-- Draw a live arc from startPos in dir, optionally with a dive
local function drawLiveArc(startPos, dir, diveFrac)
    if not dir or dir.Magnitude < 0.01 then
        for _, p in ipairs(liveArcParts) do p.Transparency = 1 end
        liveLandDot.Transparency = 1; liveCrossDot.Transparency = 1
        return
    end
    local g  = workspace.Gravity
    local jp = hum.UseJumpPower and hum.JumpPower or math.sqrt(2*g*hum.JumpHeight)
    local tAir = (2*jp)/g
    local ws = hum.WalkSpeed
    local md = Vector3.new(dir.X, 0, dir.Z).Unit

    if diveFrac then
        local tDive = diveFrac * tAir
        local p1    = math.floor(LIVE_ARC_DOTS * diveFrac)
        local divePos
        for i = 1, p1 do
            local t = tDive * (i / p1)
            liveArcParts[i].Position = Vector3.new(
                startPos.X + md.X*ws*t,
                startPos.Y + jp*t - 0.5*g*t*t,
                startPos.Z + md.Z*ws*t)
            liveArcParts[i].Transparency = 0.15
            liveArcParts[i].Color = COL_ARC
            if i == p1 then divePos = liveArcParts[i].Position end
        end
        if divePos then
            local vY = jp - g*tDive
            local h  = divePos.Y - FLOOR_Y
            local disc = vY*vY + 2*g*h
            local tF = disc >= 0 and (vY + math.sqrt(disc))/g or 0
            local p2 = LIVE_ARC_DOTS - p1
            for i = 1, p2 do
                local tf = tF * (i/p2)
                local idx = p1 + i
                if liveArcParts[idx] then
                    liveArcParts[idx].Position = Vector3.new(
                        divePos.X,
                        divePos.Y + vY*tf - 0.5*g*tf*tf,
                        divePos.Z)
                    liveArcParts[idx].Transparency = 0.15
                    liveArcParts[idx].Color = Color3.fromRGB(255,80,200)
                end
            end
            liveLandDot.Position = Vector3.new(divePos.X, FLOOR_Y+0.5, divePos.Z)
            liveLandDot.Transparency = 0.2
        end
    else
        local ts = tAir / LIVE_ARC_DOTS
        for i = 1, LIVE_ARC_DOTS do
            local t = i * ts
            liveArcParts[i].Position = Vector3.new(
                startPos.X + md.X*ws*t,
                startPos.Y + jp*t - 0.5*g*t*t,
                startPos.Z + md.Z*ws*t)
            liveArcParts[i].Transparency = 0.15
            liveArcParts[i].Color = COL_ARC
        end
        local lp = Vector3.new(startPos.X+md.X*ws*tAir, FLOOR_Y+0.5, startPos.Z+md.Z*ws*tAir)
        liveLandDot.Position = lp; liveLandDot.Transparency = 0.2
    end
end

local function hideLiveArc()
    for _, p in ipairs(liveArcParts) do p.Transparency = 1 end
    liveLandDot.Transparency = 1; liveCrossDot.Transparency = 1
end

