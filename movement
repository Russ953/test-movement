-- ==========================================
-- ARC VISUALIZER
-- ==========================================
local vizFolder = workspace:FindFirstChild("JumpArcVisualizer")
if not vizFolder then
	vizFolder        = Instance.new("Folder")
	vizFolder.Name   = "JumpArcVisualizer"
	vizFolder.Parent = workspace
end

local VIZ_STEPS = 20
local vizParts  = {}
for i = 1, VIZ_STEPS do
	local p        = Instance.new("Part")
	p.Size         = Vector3.new(0.35, 0.35, 0.35)
	p.Anchored     = true
	p.CanCollide   = false
	p.Material     = Enum.Material.Neon
	p.Shape        = Enum.PartType.Ball
	p.Transparency = 1
	p.Parent       = vizFolder
	vizParts[i]    = p
end

local function hideVisualizer()
	for _, p in ipairs(vizParts) do p.Transparency = 1 end
end

-- ==========================================
-- ARENA CHECK
-- ==========================================
local function checkOnArena()
	local pos  = rootPart.Position
	local flat = Vector3.new(pos.X - mapCenter.X, 0, pos.Z - mapCenter.Z)
	local inXZ = flat.Magnitude <= ARENA_XZ_RADIUS
	local inY  = pos.Y >= ARENA_TOP - 1 and pos.Y <= ARENA_TOP + ARENA_Y_MARGIN
	return inXZ and inY
end

-- ==========================================
-- ANGULAR VELOCITY HELPER
-- ==========================================
local function getLaserTipVelocity(item, oldCF, dt)
	if not oldCF then return Vector3.zero end
	local transVel = (item.Position - oldCF.Position) / dt
	local oldFwd   = Vector3.new(oldCF.LookVector.X,       0, oldCF.LookVector.Z)
	local newFwd   = Vector3.new(item.CFrame.LookVector.X, 0, item.CFrame.LookVector.Z)
	if oldFwd.Magnitude < 0.01 or newFwd.Magnitude < 0.01 then return transVel end
	local cross    = oldFwd:Cross(newFwd)
	local angSpeed = cross.Y / dt
	local halfLen  = item.Size.Z / 2
	local perpDir  = Vector3.new(newFwd.Z, 0, -newFwd.X) * math.sign(angSpeed + 1e-9)
	local rotVel   = perpDir * math.abs(angSpeed) * halfLen
	return transVel + rotVel
end

-- ==========================================
-- TRAJECTORY + LANDING PREDICTION
-- Returns: isSafe (bool), minGap (number)
-- ==========================================
local function predictTrajectory(laser, laserVelocity, actualMoveDir)
	if not laser then return false, -1 end

	local g         = workspace.Gravity
	local jumpPower = humanoid.UseJumpPower
		and humanoid.JumpPower
		or  math.sqrt(2 * g * humanoid.JumpHeight)
	local walkSpeed = humanoid.WalkSpeed

	-- Use the direction toward the far side of the laser as move direction
	-- so the prediction matches where MoveTo is actually sending the player
	local moveDir = actualMoveDir
	if not moveDir or moveDir.Magnitude < 0.01 then
		moveDir = rootPart.CFrame.LookVector
	end
	moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
	if moveDir.Magnitude > 0.01 then moveDir = moveDir.Unit end

	local timeInAir = (2 * jumpPower) / g
	local steps     = VIZ_STEPS
	local timeStep  = timeInAir / steps
	local startPos  = rootPart.Position
	local isSafe    = true
	local minGap    = math.huge

	for i = 1, steps do
		local t  = i * timeStep
		local tp = Vector3.new(
			startPos.X + moveDir.X * walkSpeed * t,
			startPos.Y + jumpPower * t - 0.5 * g * t * t,
			startPos.Z + moveDir.Z * walkSpeed * t
		)

		local futureCF = laser.CFrame - laser.Position + (laser.Position + laserVelocity * t)
		local lp       = futureCF:PointToObjectSpace(tp)
		local bX = laser.Size.X / 2 + 1.2
		local bY = laser.Size.Y / 2 + 2.6
		local bZ = laser.Size.Z / 2 + 1.2

		if math.abs(lp.X) < bX and math.abs(lp.Y) < bY and math.abs(lp.Z) < bZ then
			isSafe = false
		end
		local gap = math.min(bX - math.abs(lp.X), bY - math.abs(lp.Y), bZ - math.abs(lp.Z))
		minGap = math.min(minGap, math.abs(gap))

		vizParts[i].Position    = tp
		vizParts[i].Transparency = 0
	end

	-- Landing zone check
	if isSafe then
		local landT   = timeInAir
		local landPos = Vector3.new(
			startPos.X + moveDir.X * walkSpeed * landT,
			startPos.Y,
			startPos.Z + moveDir.Z * walkSpeed * landT
		)
		local futureCF = laser.CFrame - laser.Position + (laser.Position + laserVelocity * landT)
		local lp       = futureCF:PointToObjectSpace(landPos)
		if math.abs(lp.X) < laser.Size.X / 2 + 1.4 and math.abs(lp.Z) < laser.Size.Z / 2 + 1.4 then
			isSafe = false
			print(string.format("[LAND-UNSAFE] '%s' will be at landing zone", laser.Name))
		end
	end

	local col
	if not isSafe then
		col = Color3.fromRGB(255, 50, 50)
	elseif minGap < TIGHT_CLEARANCE then
		col = Color3.fromRGB(255, 160, 30)
	else
		col = Color3.fromRGB(60, 220, 100)
	end
	for i = 1, steps do vizParts[i].Color = col end

	return isSafe, minGap
end

-- ==========================================
-- HELPERS
-- ==========================================
local function clampToSafeZone(pos)
	local off  = pos - mapCenter
	local flat = Vector3.new(off.X, 0, off.Z)
	if flat.Magnitude > safeRadius then
		local c = flat.Unit * safeRadius
		return Vector3.new(mapCenter.X + c.X, pos.Y, mapCenter.Z + c.Z)
	end
	return pos
end

local function timeToImpact(localZ, laserSpeed)
	if laserSpeed < 0.1 then return localZ end
	return localZ / laserSpeed
end

-- ==========================================
-- LASER SELECTION
-- ==========================================
local function getBestLaser(dt, now)
	local bestLaser     = nil
	local bestTTI       = math.huge
	local bestTargetPos = nil
	local bestVelocity  = Vector3.zero
	local bestLocalZ    = math.huge
	local bestObjPos    = nil

	local playerPos   = rootPart.Position
	local shouldPrint = (now - lastDebugPrint) >= DEBUG_INTERVAL

	for _, item in ipairs(lasersFolder:GetChildren()) do
		if not item:IsA("BasePart") then continue end
		item.CanCollide = false

		local objPos      = item.CFrame:PointToObjectSpace(playerPos)
		local localZ      = math.abs(objPos.Z)
		local currentSide = math.sign(objPos.Z)
		if currentSide == 0 then currentSide = 1 end

		local worldDist = (item.Position - playerPos).Magnitude

		local oldCF = lastLaserCFrames[item]
		lastLaserCFrames[item] = item.CFrame

		local tipVel = getLaserTipVelocity(item, oldCF, dt)
		local speed  = tipVel.Magnitude

		-- RESET
		if worldDist > RESET_WORLD_DIST then
			if laserPassedFlag[item] then
				print(string.format("[RESET] '%s' worldDist=%.1f", item.Name, worldDist))
			end
			laserPassedFlag[item] = false
			lastLaserSide[item]   = nil
			continue
		end

		-- PASSED DETECTION
		if not laserPassedFlag[item] then
			if speed > LASER_MOVE_THRESHOLD then
				local toPlayer = Vector3.new(
					playerPos.X - item.Position.X, 0,
					playerPos.Z - item.Position.Z)
				local flatVel = Vector3.new(tipVel.X, 0, tipVel.Z)
				local dot = toPlayer.Magnitude > 0.01 and flatVel:Dot(toPlayer.Unit) or 0

				if dot < -0.3 and localZ < PASS_CONFIRM_DIST then
					laserPassedFlag[item] = true
					print(string.format("[PASSED-VEL] '%s' dot=%.2f localZ=%.1f", item.Name, dot, localZ))
				end

				local prevSide = lastLaserSide[item]
				if prevSide and prevSide ~= currentSide then
					laserPassedFlag[item] = true
					print(string.format("[PASSED-FLIP] '%s' %d->%d localZ=%.1f", item.Name, prevSide, currentSide, localZ))
				end
			end
		end

		lastLaserSide[item] = currentSide
		if laserPassedFlag[item] then continue end
		if localZ > AGGRO_DISTANCE then continue end

		local tti = timeToImpact(localZ, speed)

		if shouldPrint then
			print(string.format("[DBG] '%s' localZ=%.1f TTI=%.2f spd=%.1f", item.Name, localZ, tti, speed))
		end

		if tti < bestTTI then
			bestTTI       = tti
			bestLaser     = item
			bestVelocity  = tipVel
			bestLocalZ    = localZ
			bestObjPos    = objPos
			-- Far side of laser
			bestTargetPos = item.CFrame * Vector3.new(objPos.X, 0, -currentSide * 15)
		end
	end

	if shouldPrint then lastDebugPrint = now end
	return bestLaser, bestTargetPos, bestLocalZ, bestVelocity, bestObjPos
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
	if not character or humanoid.Health <= 0 then
		hideVisualizer()
		setStatus("◉ Dead", Color3.fromRGB(255,80,80))
		return
	end

	local now = tick()

	-- Arena check
	if not checkOnArena() then
		hideVisualizer()
		setStatus("◉ Off arena – idle", Color3.fromRGB(180,180,180))
		timerLabel.Text = string.format("⏱  %.1fs", now - runStart)
		lastRootPos = nil
		return
	end

	-- HUD
	timerLabel.Text = string.format("⏱  %.1fs", now - runStart)
	jumpLabel.Text  = string.format("🦘 Jumps: %d", jumpCount)

	-- Real movement direction from position delta (not humanoid.MoveDirection
	-- which is unreliable with MoveTo)
	local realMoveDir = Vector3.zero
	if lastRootPos then
		local delta = rootPart.Position - lastRootPos
		local flat  = Vector3.new(delta.X, 0, delta.Z)
		if flat.Magnitude > 0.005 then
			realMoveDir = flat.Unit
		end
	end
	lastRootPos = rootPart.Position

	local laser, targetPos, dist, laserVelocity, objPos = getBestLaser(dt, now)
	local state   = humanoid:GetState()
	local isInAir = state == Enum.HumanoidStateType.Freefall
	             or state == Enum.HumanoidStateType.Jumping
	local canJump = (now - lastJumpTime) >= JUMP_COOLDOWN

	if laser and targetPos then
		setStatus("◉ Reacting to laser", Color3.fromRGB(255, 160, 40))

		if not isInAir then
			if canJump and dist <= JUMP_TRIGGER_DISTANCE + 5 then
				-- Compute direction from player toward the far side target
				-- This is what we pass to arc prediction so it matches MoveTo
				local toTarget = targetPos - rootPart.Position
				local flatToTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
				local predictDir = flatToTarget.Magnitude > 0.01
					and flatToTarget.Unit or realMoveDir

				local safe, gap = predictTrajectory(laser, laserVelocity, predictDir)

				if dist <= JUMP_TRIGGER_DISTANCE and safe then
					-- JUMP
					print(string.format("[JUMP] '%s' dist=%.1f gap=%.2f", laser.Name, dist, gap or 0))
					lastJumpTime = now
					jumpCount    = jumpCount + 1
					jumpLabel.Text = string.format("🦘 Jumps: %d", jumpCount)
					humanoid:MoveTo(clampToSafeZone(targetPos))
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				elseif not safe then
					-- Arc unsafe: back away from the laser instead of walking into it
					if objPos then
						local currentSide = math.sign(objPos.Z)
						if currentSide == 0 then currentSide = 1 end
						-- Back-up target: same side the player is on, further away
						local backupTarget = laser.CFrame * Vector3.new(objPos.X, 0, currentSide * BACKUP_DIST)
						humanoid:MoveTo(clampToSafeZone(backupTarget))
						setStatus("◉ Backing up (unsafe arc)", Color3.fromRGB(255, 80, 80))
					else
						humanoid:MoveTo(mapCenter)
					end
				else
					-- In approach range but not close enough yet, keep walking
					humanoid:MoveTo(clampToSafeZone(targetPos))
				end
			else
				-- Outside jump prediction range, walk toward laser
				humanoid:MoveTo(clampToSafeZone(targetPos))
			end
		else
			-- In air, keep heading toward target
			humanoid:MoveTo(clampToSafeZone(targetPos))
			hideVisualizer()
		end
	else
		hideVisualizer()
		setStatus("◉ Safe – holding centre", Color3.fromRGB(80, 220, 160))
		if not isInAir then humanoid:MoveTo(mapCenter) end
	end
end)
