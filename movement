local mapPart      = workspace:WaitForChild("Laser Game Map"):WaitForChild("Cylinder.005")
local lasersFolder = workspace:WaitForChild("Lasers"):WaitForChild("ActiveLasers")

local maxMapDimension = math.max(mapPart.Size.X, mapPart.Size.Y, mapPart.Size.Z)
local safeRadius      = (maxMapDimension / 2) - 5
local mapCenter       = mapPart.Position
-- Arena floor check: player is "on arena" if their Y is within this many
-- studs above the map cylinder's top surface.
local ARENA_TOP       = mapPart.Position.Y + mapPart.Size.Y / 2
local ARENA_Y_MARGIN  = 6   -- studs above the top surface still counts as "on arena"
local ARENA_XZ_RADIUS = (maxMapDimension / 2) + 4  -- a little extra tolerance

-- ── Tuning ──────────────────────────────────────────────────────────────────
local JUMP_TRIGGER_DISTANCE = 5.5    -- local-Z studs: fire jump
local AGGRO_DISTANCE        = 15     -- local-Z studs: start reacting
local JUMP_COOLDOWN         = 0.35   -- seconds (raised so we don't double-jump)
local PASS_CONFIRM_DIST     = 8      -- local-Z studs: must be this close to confirm passed
local LASER_MOVE_THRESHOLD  = 0.4    -- studs/s: below this the laser is "stationary"
local RESET_WORLD_DIST      = 22     -- world studs: passed flag resets here
local STRAFE_OFFSET         = 6      -- studs sideways when strafing
local TIGHT_CLEARANCE       = 1.8    -- bounding-box clearance below which arc is "orange"

-- ── State ───────────────────────────────────────────────────────────────────
local lastLaserCFrames = setmetatable({}, {__mode = "k"})
local lastLaserSide    = setmetatable({}, {__mode = "k"})
local laserPassedFlag  = setmetatable({}, {__mode = "k"})
local lastJumpTime     = 0
local jumpCount        = 0
local runStart         = tick()
local isOnArena        = false

local lastDebugPrint = 0
local DEBUG_INTERVAL = 0.3

