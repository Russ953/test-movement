-- ==========================================
-- MOVEMENT SCRIPT v12
-- ==========================================
-- BUG IN v11:
--   The jump gate used humanoid.MoveDirection to check if the player was
--   walking toward the laser. But Roblox's MoveTo() does NOT update
--   humanoid.MoveDirection reliably - it stays at Vector3.zero most of
--   the time when the bot is in control. So towardLaser was always false
--   and the jump NEVER fired. The bot just walked straight into the laser.
--
-- FIX IN v12:
--   Jump gate replaced with a simple position-delta check:
--   compare rootPart position this frame vs last frame to get actual
--   movement direction. Also removed the strafe-on-unsafe-arc behaviour
--   (it made things worse) - instead back up away from the laser.
--   Arc prediction and landing check are kept intact.
-- ==========================================
print("[Movement] v12 loaded")

local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")

local player    = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local rootPart  = character:WaitForChild("HumanoidRootPart")

local mapPart      = workspace:WaitForChild("Laser Game Map"):WaitForChild("Cylinder.005")
local lasersFolder = workspace:WaitForChild("Lasers"):WaitForChild("ActiveLasers")

local maxMapDimension = math.max(mapPart.Size.X, mapPart.Size.Y, mapPart.Size.Z)
local safeRadius      = (maxMapDimension / 2) - 5
local mapCenter       = mapPart.Position
local ARENA_TOP       = mapPart.Position.Y + mapPart.Size.Y / 2
local ARENA_Y_MARGIN  = 6
local ARENA_XZ_RADIUS = (maxMapDimension / 2) + 4

-- Tuning
local JUMP_TRIGGER_DISTANCE = 5.5
local AGGRO_DISTANCE        = 15
local JUMP_COOLDOWN         = 0.35
local PASS_CONFIRM_DIST     = 8
local LASER_MOVE_THRESHOLD  = 0.4
local RESET_WORLD_DIST      = 22
local TIGHT_CLEARANCE       = 1.8
-- How far behind the laser to back up to when arc is unsafe
local BACKUP_DIST           = 12

-- State
local lastLaserCFrames = setmetatable({}, {__mode = "k"})
local lastLaserSide    = setmetatable({}, {__mode = "k"})
local laserPassedFlag  = setmetatable({}, {__mode = "k"})
local lastJumpTime     = 0
local jumpCount        = 0
local runStart         = tick()
local lastRootPos      = nil   -- for position-delta movement direction

local lastDebugPrint = 0
local DEBUG_INTERVAL = 0.3

