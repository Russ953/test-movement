-- LaserTracerBot v4.0.0
-- Fixed: laser pivots on EDGE, wide flat plane detection, center-hugging
print("[LaserBot] v4.0.0 loaded")

local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local lp           = Players.LocalPlayer

-- =====================
-- TUNING
-- =====================
local ARENA_CENTER = Vector3.new(-178.238647, 45, 12.4262772)
-- Lasers pivot from the EDGE and sweep a wide flat plane across the arena.
-- We stay near center and dodge into the gaps between sweeps.
local LASER_HALF_W = 9        -- half-width of the pink laser plane in studs
local LOOKAHEAD    = 1.2      -- seconds ahead to predict
local ANGLE_STEP   = 8        -- degrees between candidate slots
local PROX_TRIGGER = 14       -- studs ahead of laser to start fleeing
local TWEEN_TIME   = 0.20     -- seconds per walk step (human-like)
local STEP_SIZE    = 5        -- studs per path step
local VIS_ENABLED  = true     -- set false to hide debug visuals

-- =====================
-- LASER FETCH
-- =====================
local function getLasers()
    local out = {}
    local root = workspace:FindFirstChild("Lasers")
    if not root then return out end
    local active = root:FindFirstChild("ActiveLasers")
    if not active then return out end
    for _, p in ipairs(active:GetChildren()) do
        if p:IsA("BasePart") then table.insert(out, p) end
    end
    return out
end

-- =====================
-- ANGULAR VELOCITY
-- =====================
local prevAng = {}
local function getAngVel(laser)
    local id  = laser:GetDebugId()
    local lv  = laser.CFrame.LookVector
    local ang = math.atan2(lv.Z, lv.X)
    if prevAng[id] then
        local d = ang - prevAng[id]
        if d >  math.pi then d = d - 2*math.pi end
        if d < -math.pi then d = d + 2*math.pi end
        prevAng[id] = ang
        return d  -- radians per Heartbeat frame
    end
    prevAng[id] = ang
    return 0
end

-- =====================
-- DANGER CHECK
-- Laser pivots at laser.Position (on the arena edge wall).
-- The laser is a wide flat plane sweeping in LookVector direction.
-- We compute perpendicular distance from the point to the predicted sweep line.
-- frontDot > 0 ensures we only flag points that are IN FRONT of the pivot.
-- =====================
local function isDangerous(px, pz, laser, ahead, av)
    local lv    = laser.CFrame.LookVector
    local cur   = math.atan2(lv.Z, lv.X)
    local pred  = cur + av * 60 * ahead  -- predicted angle after `ahead` seconds

    local ox    = laser.Position.X
    local oz    = laser.Position.Z
    local dx    = px - ox
    local dz    = pz - oz

    -- unit vector along predicted laser direction
    local lineX =  math.cos(pred)
    local lineZ =  math.sin(pred)
    -- perpendicular (rotate 90°)
    local perpX = -lineZ
    local perpZ =  lineX

    local perp     = math.abs(dx * perpX + dz * perpZ)
    local frontDot = dx * lineX + dz * lineZ   -- positive = ahead of pivot

    return perp < LASER_HALF_W and frontDot > 0
end

local function anyDanger(px, pz, lasers, avs, ahead)
    for i, l in ipairs(lasers) do
        if isDangerous(px, pz, l, ahead, avs[i]) then return true end
    end
    return false
end

-- =====================
-- SAFE SLOT FINDER
-- Searches a multi-radius grid around center.
-- Strongly rewards being close to center (most escape routes).
-- =====================
local function findSafe(lasers, avs)
    local best, bestPos = -math.huge, nil
    -- search increasing radii: try to stay as close to center as possible
    for _, r in ipairs({3, 6, 9, 13, 17, 21}) do
        for deg = 0, 359, ANGLE_STEP do
            local rad = math.rad(deg)
            local cx  = ARENA_CENTER.X + math.cos(rad) * r
            local cz  = ARENA_CENTER.Z + math.sin(rad) * r

            if not anyDanger(cx, cz, lasers, avs, 0) then
                local score = 0
                -- heavy penalty if predicted to be dangerous
                if anyDanger(cx, cz, lasers, avs, LOOKAHEAD) then score = score - 600 end
                -- strong reward: stay near center
                local dx = cx - ARENA_CENTER.X
                local dz = cz - ARENA_CENTER.Z
                score = score - math.sqrt(dx*dx + dz*dz) * 3
                -- small reward: far from laser pivots
                for i, l in ipairs(lasers) do
                    local ldx = cx - l.Position.X
                    local ldz = cz - l.Position.Z
                    score = score + math.sqrt(ldx*ldx + ldz*ldz) * 0.2
                end
                if score > best then
                    best    = score
                    bestPos = Vector3.new(cx, ARENA_CENTER.Y, cz)
                end
            end
        end
        -- if we found a safe spot at this radius, stop searching further out
        if bestPos then break end
    end
    return bestPos
end

-- =====================
-- PATHFINDING
-- Straight-line path with per-step danger checks.
-- If any midpoint is dangerous, skips directly to goal.
-- =====================
local function buildPath(startPos, goalPos, lasers, avs)
    local path = {}
    local dx   = goalPos.X - startPos.X
    local dz   = goalPos.Z - startPos.Z
    local dist = math.sqrt(dx*dx + dz*dz)
    if dist < STEP_SIZE then
        table.insert(path, goalPos)
        return path
    end
    local steps = math.ceil(dist / STEP_SIZE)
    for i = 1, steps do
        local t  = i / steps
        local px = startPos.X + dx * t
        local pz = startPos.Z + dz * t
        if anyDanger(px, pz, lasers, avs, 0) then
            -- midpoint blocked — jump direct to goal
            table.insert(path, goalPos)
            return path
        end
        table.insert(path, Vector3.new(px, ARENA_CENTER.Y, pz))
    end
    return path
end

-- =====================
-- VISUALISATION
-- Green dot  = safe target
-- Yellow dots = path waypoints
-- Red slabs   = predicted laser danger planes
-- =====================
local visFolder = Instance.new("Folder")
visFolder.Name   = "LaserBotVis"
visFolder.Parent = workspace

local function makePart(name, color, size)
    local p = Instance.new("Part")
    p.Name         = name
    p.Anchored     = true
    p.CanCollide   = false
    p.CastShadow   = false
    p.Size         = size or Vector3.new(1, 0.2, 1)
    p.Color        = color
    p.Material     = Enum.Material.Neon
    p.Transparency = 0.5
    p.Parent       = visFolder
    return p
end

local targetDot   = makePart("TargetDot",  Color3.fromRGB(0, 255, 80),  Vector3.new(2.5, 0.4, 2.5))
local pathParts   = {}
local dangerSlabs = {}

local function updateVis(safePt, path, lasers, avs)
    if not VIS_ENABLED then return end

    -- green target dot
    if safePt then
        targetDot.CFrame        = CFrame.new(safePt + Vector3.new(0, 0.3, 0))
        targetDot.Transparency  = 0.15
    else
        targetDot.Transparency  = 1
    end

    -- yellow path dots
    for _, p in ipairs(pathParts) do p:Destroy() end
    pathParts = {}
    if path then
        for i, pt in ipairs(path) do
            local d = makePart("P"..i, Color3.fromRGB(255, 220, 0), Vector3.new(0.8, 0.3, 0.8))
            d.CFrame = CFrame.new(pt + Vector3.new(0, 0.25, 0))
            d.Transparency = 0.3
            table.insert(pathParts, d)
        end
    end

    -- red predicted danger slabs (match real laser plane width)
    for _, p in ipairs(dangerSlabs) do p:Destroy() end
    dangerSlabs = {}
    if lasers then
        for i, laser in ipairs(lasers) do
            local lv   = laser.CFrame.LookVector
            local av   = avs and avs[i] or 0
            local pred = math.atan2(lv.Z, lv.X) + av * 60 * LOOKAHEAD
            local len  = 90  -- long enough to span whole arena
            local dirX = math.cos(pred)
            local dirZ = math.sin(pred)
            local mid  = laser.Position + Vector3.new(dirX, 0, dirZ) * (len / 2)
            local slab = makePart("Danger"..i, Color3.fromRGB(255, 50, 50),
                Vector3.new(LASER_HALF_W * 2, 0.25, len))
            -- orient slab along predicted direction
            slab.CFrame        = CFrame.new(mid, laser.Position + Vector3.new(dirX, 0, dirZ) * len)
            slab.Transparency  = 0.4
            table.insert(dangerSlabs, slab)
        end
    end
end

-- =====================
-- HUMAN-LIKE TWEEN WALK
-- TweenService on HumanoidRootPart → smooth movement, animations fire normally
-- =====================
local moving = false

local function walkPath(path)
    if moving then return end
    moving = true
    local c = lp.Character
    if not c then moving = false; return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then moving = false; return end

    hum.AutoRotate = false

    for _, pt in ipairs(path) do
        c = lp.Character
        if not c then break end
        hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then break end

        local dir = (pt - hrp.Position) * Vector3.new(1, 0, 1)
        if dir.Magnitude > 0.2 then
            local tw = TweenService:Create(
                hrp,
                TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
                { CFrame = CFrame.new(pt, pt + dir.Unit) }
            )
            tw:Play()
            tw.Completed:Wait()
        end
    end

    if hum then hum.AutoRotate = true end
    moving = false
end

-- emergency only — laser is literally on the player this frame
local function emergencyTp(pos)
    local c = lp.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.CFrame = CFrame.new(pos) end
end

-- =====================
-- MAIN LOOP
-- =====================
local lastCheck = 0

RunService.Heartbeat:Connect(function()
    local c = lp.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local lasers = getLasers()
    if #lasers == 0 then return end

    local avs = {}
    for i, l in ipairs(lasers) do avs[i] = getAngVel(l) end

    local px  = hrp.Position.X
    local pz  = hrp.Position.Z
    local now = tick()

    -- EMERGENCY: laser plane is on player RIGHT NOW
    if anyDanger(px, pz, lasers, avs, 0) then
        local safe = findSafe(lasers, avs)
        if safe then
            emergencyTp(safe)
            updateVis(safe, nil, lasers, avs)
        end
        moving = false
        return
    end

    if (now - lastCheck) < 0.12 then return end
    lastCheck = now

    -- proactive: flee if we'll be hit soon OR laser tip is approaching
    local shouldMove = anyDanger(px, pz, lasers, avs, LOOKAHEAD)
    if not shouldMove then
        for i, l in ipairs(lasers) do
            local lv   = l.CFrame.LookVector
            local av   = avs[i]
            -- predict laser tip position in 0.35s
            local pa   = math.atan2(lv.Z, lv.X) + av * 60 * 0.35
            local tipX = l.Position.X + math.cos(pa) * PROX_TRIGGER
            local tipZ = l.Position.Z + math.sin(pa) * PROX_TRIGGER
            local ddx  = px - tipX
            local ddz  = pz - tipZ
            if math.sqrt(ddx*ddx + ddz*ddz) < LASER_HALF_W + 3 then
                shouldMove = true; break
            end
        end
    end

    updateVis(nil, nil, lasers, avs)

    if shouldMove and not moving then
        local safe = findSafe(lasers, avs)
        if safe then
            local path = buildPath(hrp.Position, safe, lasers, avs)
            updateVis(safe, path, lasers, avs)
            task.spawn(walkPath, path)
        end
    end
end)

print("[LaserBot] v4.0.0 running")
