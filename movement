-- ==========================================
-- LaserTracerBot v5.0.0
-- Complete rewrite combining v20 inspiration + clean fixes
--
-- KEY MECHANICS (from screenshot analysis):
--   - Laser is a WIDE RED SLAB spinning from ARENA CENTER
--   - Bot must JUMP OVER the laser as it sweeps past
--   - NO teleporting ever - pure Humanoid movement
--   - Jumps at correct TTI, only when laser sweeps TOWARD player
--   - Pre-positions in scored safe gap between sweeps
--   - Looks human: natural walk speed, slight reaction delay
-- ==========================================
print("[LaserBot] v5.0.0 loaded")

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")

local lp        = Players.LocalPlayer
local character = lp.Character or lp.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local rootPart  = character:WaitForChild("HumanoidRootPart")

-- ==========================================
-- ARENA CONSTANTS  (edit these to match your map)
-- ==========================================
local MAP_X      = -178.238647
local MAP_Y      =   41.353       -- floor Y (approx ARENA_FLOOR_Y from v20)
local MAP_Z      =   12.4262772
local mapCenter  = Vector3.new(MAP_X, MAP_Y + 0.5, MAP_Z)
local ARENA_R    = 33.0           -- playable radius

-- ==========================================
-- TUNING
-- ==========================================
-- Laser geometry
local LASER_HALF_W   = 5.0    -- half-width of the red slab (studs)
local LASER_HALF_H   = 4.0    -- half-height for jump clearance check

-- Jump timing
local JUMP_TTI       = 0.55   -- trigger jump when laser is this many seconds away
local JUMP_COOLDOWN  = 0.4    -- min seconds between jumps
local SWEEP_CONFIRM  = 0.25   -- seconds ahead to confirm laser still approaching

-- Approach / safe positioning
local APPROACH_TTI   = 2.5    -- start walking to jump spot when TTI < this
local SAFE_RADIUS    = 18     -- orbit ring radius for safe pos search
local SAFE_ANGLES    = 36     -- candidates around the ring
local SAFE_RATE      = 0.15   -- seconds between safe pos recalculations

-- Human-feel
local REACT_DELAY    = 0.08   -- simulated human reaction lag (seconds)
local RETARGET_DIST  = 1.5    -- don't re-send MoveTo if target barely changed

-- Hitbox padding for jump arc check
local PAD_X = 0.5
local PAD_Y = 2.5
local PAD_Z = 0.8

-- ==========================================
-- STATE
-- ==========================================
local lastLaserCF   = setmetatable({}, {__mode="k"})
local lastLaserAV   = setmetatable({}, {__mode="k"})
local laserPassed   = setmetatable({}, {__mode="k"})
local lastJumpTime  = 0
local jumpCount     = 0
local lastMovePos   = nil
local lastSafePosT  = 0
local cachedSafe    = nil
local lastThinkTime = 0
local runStart      = tick()

-- ==========================================
-- LASER FOLDER
-- ==========================================
local lasersFolder = workspace:WaitForChild("Lasers"):WaitForChild("ActiveLasers")

local function getLasers()
    local out = {}
    for _, p in ipairs(lasersFolder:GetChildren()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            table.insert(out, p)
        end
    end
    return out
end

-- ==========================================
-- LASER MOTION
-- ==========================================
local function getLaserMotion(laser, dt)
    local oldCF = lastLaserCF[laser]
    lastLaserCF[laser] = laser.CFrame
    if not oldCF or dt < 0.001 then return Vector3.zero, 0 end

    local transVel = (laser.Position - oldCF.Position) / dt

    local oldFwd = Vector3.new(oldCF.LookVector.X, 0, oldCF.LookVector.Z)
    local newFwd = Vector3.new(laser.CFrame.LookVector.X, 0, laser.CFrame.LookVector.Z)
    local angVelY = 0
    if oldFwd.Magnitude > 0.01 and newFwd.Magnitude > 0.01 then
        local cross = oldFwd:Cross(newFwd)
        angVelY = cross.Y / dt
    end
    lastLaserAV[laser] = angVelY
    return transVel, angVelY
end

-- Future laser CFrame prediction
local function futureLaserCF(laser, vel, av, t)
    local fpos  = laser.Position + vel * t
    local base  = math.atan2(laser.CFrame.LookVector.X, laser.CFrame.LookVector.Z)
    local angle = base + av * t
    return CFrame.new(fpos) * CFrame.Angles(0, angle, 0)
end

-- ==========================================
-- THREAT DETECTION
-- Returns TTI (time to impact) for a laser vs player pos
-- Returns nil if not a real threat (passed, too far, moving away)
-- ==========================================
local function getTTI(laser, vel, av, playerPos, dt)
    local objPos = laser.CFrame:PointToObjectSpace(playerPos)
    local localZ = math.abs(objPos.Z)

    -- world distance safety cut
    if (laser.Position - playerPos).Magnitude > 80 then
        laserPassed[laser] = false
        return nil
    end

    -- detect if laser already passed
    local speed = vel.Magnitude
    if not laserPassed[laser] then
        if speed > 0.3 then
            local toP = Vector3.new(
                playerPos.X - laser.Position.X, 0,
                playerPos.Z - laser.Position.Z)
            local fv = Vector3.new(vel.X, 0, vel.Z)
            -- laser tip moving away from player
            if toP.Magnitude > 0.01 and fv.Magnitude > 0.01 then
                if fv:Dot(toP.Unit) < -0.4 and localZ < 10 then
                    laserPassed[laser] = true
                    return nil
                end
            end
        end
    end
    if laserPassed[laser] then return nil end

    -- TTI = localZ / tip speed (how fast slab edge is approaching)
    local halfLen = laser.Size.Z / 2
    local perpDir = Vector3.new(
        laser.CFrame.LookVector.Z, 0, -laser.CFrame.LookVector.X)
        * math.sign(av + 1e-9)
    local tipSpeed = (vel + perpDir * math.abs(av) * halfLen).Magnitude
    if tipSpeed < 0.05 then return nil end

    local tti = localZ / tipSpeed

    -- Confirm threat still valid SWEEP_CONFIRM seconds ahead
    -- (avoids false triggers when laser barely grazing past)
    if tipSpeed > 0.1 then
        local fcf = futureLaserCF(laser, vel, av, SWEEP_CONFIRM)
        local futObj = fcf:PointToObjectSpace(playerPos)
        -- if future localZ is bigger → laser moving away, skip
        if math.abs(futObj.Z) > localZ + 2.0 then
            laserPassed[laser] = true
            return nil
        end
    end

    return tti, localZ, objPos
end

-- ==========================================
-- SWEEP DIRECTION: is laser sweeping TOWARD player?
-- ==========================================
local function sweepingToward(laser, av)
    local pp  = rootPart.Position
    local toP = Vector3.new(pp.X - laser.Position.X, 0, pp.Z - laser.Position.Z)
    if toP.Magnitude < 0.01 then return true end
    local fwd   = Vector3.new(laser.CFrame.LookVector.X, 0, laser.CFrame.LookVector.Z)
    if fwd.Magnitude < 0.01 then return true end
    -- right side of beam
    local right = Vector3.new(fwd.Z, 0, -fwd.X)
    -- player is to the right? if av>0 (CCW sweep) the beam sweeps left, so right side incoming
    return (av * right:Dot(toP)) > 0
end

-- ==========================================
-- JUMP ARC SAFETY CHECK
-- Simulates jump trajectory and checks if it clears all lasers
-- ==========================================
local VIZ_STEPS = 22
local vizFolder = workspace:FindFirstChild("BotArcViz") or Instance.new("Folder",workspace)
vizFolder.Name = "BotArcViz"
local vizParts = {}
for i = 1, VIZ_STEPS do
    local p = Instance.new("Part")
    p.Size=Vector3.new(0.3,0.3,0.3); p.Anchored=true; p.CanCollide=false
    p.Material=Enum.Material.Neon; p.Shape=Enum.PartType.Ball
    p.Transparency=1; p.CastShadow=false; p.Parent=vizFolder
    vizParts[i] = p
end

local function checkJumpArc(threats, jumpDir, startPos, showViz)
    local g  = workspace.Gravity
    local jp = humanoid.UseJumpPower
        and humanoid.JumpPower
        or  math.sqrt(2 * g * humanoid.JumpHeight)
    local ws   = humanoid.WalkSpeed
    local tAir = (2 * jp) / g
    local dt   = tAir / VIZ_STEPS

    local md = Vector3.new(jumpDir.X, 0, jumpDir.Z)
    if md.Magnitude < 0.01 then md = rootPart.CFrame.LookVector end
    md = Vector3.new(md.X, 0, md.Z).Unit

    local sp    = startPos or rootPart.Position
    local safe  = true
    local minGap = math.huge

    for i = 1, VIZ_STEPS do
        local t  = i * dt
        local tp = Vector3.new(
            sp.X + md.X * ws * t,
            sp.Y + jp * t - 0.5 * g * t * t,
            sp.Z + md.Z * ws * t)

        for _, thr in ipairs(threats) do
            local fcf = futureLaserCF(thr.laser, thr.vel, thr.av, t)
            local lp2 = fcf:PointToObjectSpace(tp)
            local bx  = thr.laser.Size.X / 2 + PAD_X
            local by  = thr.laser.Size.Y / 2 + PAD_Y
            local bz  = thr.laser.Size.Z / 2 + PAD_Z
            if math.abs(lp2.X) < bx and math.abs(lp2.Y) < by and math.abs(lp2.Z) < bz then
                safe = false
            end
            local gap = math.min(
                bx - math.abs(lp2.X),
                by - math.abs(lp2.Y),
                bz - math.abs(lp2.Z))
            minGap = math.min(minGap, math.abs(gap))
        end

        if showViz then vizParts[i].Position = tp; vizParts[i].Transparency = 0.1 end
    end

    if showViz then
        local col = safe and Color3.fromRGB(60,220,100) or Color3.fromRGB(255,50,50)
        for i = 1, VIZ_STEPS do vizParts[i].Color = col end
    end

    return safe, minGap, tAir
end

local function hideArc()
    for _, p in ipairs(vizParts) do p.Transparency = 1 end
end

-- ==========================================
-- SAFE POSITION SCORING
-- Score every candidate position; higher = safer
-- ==========================================
local safeMarker = Instance.new("Part")
safeMarker.Size=Vector3.new(1.5,1.5,1.5); safeMarker.Anchored=true
safeMarker.CanCollide=false; safeMarker.CastShadow=false
safeMarker.Material=Enum.Material.Neon; safeMarker.Shape=Enum.PartType.Ball
safeMarker.Color=Color3.fromRGB(0,255,120); safeMarker.Transparency=1
safeMarker.Parent = vizFolder

local function scorePos(pos, threats)
    local score = 0
    for _, thr in ipairs(threats) do
        local tti    = math.max(thr.tti, 0.05)
        local weight = 1 / tti
        -- perpendicular distance to laser beam (from center)
        local objPos = thr.laser.CFrame:PointToObjectSpace(pos)
        score = score + math.abs(objPos.Z) * weight
        -- future distance at half-TTI
        local fcf = futureLaserCF(thr.laser, thr.vel, thr.av, tti * 0.5)
        local fp  = fcf:PointToObjectSpace(pos)
        score = score + math.abs(fp.Z) * weight * 0.5
    end
    return score
end

local function getBestSafePos(threats, now)
    if cachedSafe and (now - lastSafePosT) < SAFE_RATE then
        return cachedSafe
    end
    if #threats == 0 then
        cachedSafe   = mapCenter
        lastSafePosT = now
        return mapCenter
    end

    local best, bestPos = -math.huge, mapCenter
    for i = 0, SAFE_ANGLES - 1 do
        local ang = (i / SAFE_ANGLES) * math.pi * 2
        local cx  = MAP_X + math.cos(ang) * SAFE_RADIUS
        local cz  = MAP_Z + math.sin(ang) * SAFE_RADIUS
        local pos = Vector3.new(cx, MAP_Y + 0.5, cz)
        local s   = scorePos(pos, threats)
        if s > best then best = s; bestPos = pos end
    end

    cachedSafe   = bestPos
    lastSafePosT = now
    return bestPos
end

-- ==========================================
-- MOVEMENT HELPERS
-- ==========================================
local function clampArena(pos)
    local dx  = pos.X - MAP_X
    local dz  = pos.Z - MAP_Z
    local mag = math.sqrt(dx*dx + dz*dz)
    if mag > ARENA_R - 2 then
        local s = (ARENA_R - 2) / mag
        return Vector3.new(MAP_X + dx*s, pos.Y, MAP_Z + dz*s)
    end
    return pos
end

local function smartMove(pos)
    pos = clampArena(pos)
    if lastMovePos then
        local dd = (pos - lastMovePos).Magnitude
        if dd < RETARGET_DIST then return end
    end
    lastMovePos = pos
    humanoid:MoveTo(pos)
end

-- jump direction: toward the far side of the laser (over it)
local function getJumpTarget(laser, side)
    local fwd  = Vector3.new(laser.CFrame.LookVector.X, 0, laser.CFrame.LookVector.Z)
    if fwd.Magnitude < 0.01 then fwd = Vector3.new(1,0,0) end
    fwd = fwd.Unit
    -- go in the direction the laser came FROM (opposite of its approach)
    local target = laser.Position + fwd * (-side * 20)
    return clampArena(Vector3.new(target.X, MAP_Y + 0.5, target.Z))
end

