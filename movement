-- ==========================================
-- MOVEMENT SCRIPT v10
-- ==========================================
-- ROOT CAUSE OF v9 BUG:
--   Side-flip detection (prevSide ~= currentSide) fired when the PLAYER
--   walked across the laser's local-Z plane, not just when the laser swept
--   past the player. This caused un-jumped lasers to be falsely marked as
--   passed, so the bot walked straight into them.
--
-- FIX IN v10:
--   "Passed" is now determined by the LASER'S OWN VELOCITY, not by a
--   side-flip of the player's relative position.
--   A laser is marked passed when:
--     1. The laser's velocity dot the player-to-laser vector is NEGATIVE
--        (laser is genuinely moving away from the player), AND
--     2. The laser is already very close (< PASS_CONFIRM_DIST) so we know
--        it really did go past, not just that it's far away and moving.
--   Side-flip is kept as a secondary confirmation but ONLY when the laser
--   is actually moving (speed > LASER_MOVE_THRESHOLD) to filter out noise
--   from the player's own movement.
--
--   RESET uses world-space distance so it reliably clears regardless of
--   how the laser is oriented.
-- ==========================================
print("[Movement] v10 loaded")

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")

local player    = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local rootPart  = character:WaitForChild("HumanoidRootPart")

local mapPart      = workspace:WaitForChild("Laser Game Map"):WaitForChild("Cylinder.005")
local lasersFolder = workspace:WaitForChild("Lasers"):WaitForChild("ActiveLasers")

local maxMapDimension = math.max(mapPart.Size.X, mapPart.Size.Y, mapPart.Size.Z)
local safeRadius      = (maxMapDimension / 2) - 5
local mapCenter       = mapPart.Position

-- Tuning constants
local JUMP_TRIGGER_DISTANCE = 5.5   -- local-Z studs, fire jump
local AGGRO_DISTANCE        = 15    -- local-Z studs, start reacting
local JUMP_COOLDOWN         = 0.1   -- seconds between jumps

-- A laser is confirmed passed when it is THIS close AND moving away.
-- Keeps false-positives from far lasers that happen to move away briefly.
local PASS_CONFIRM_DIST     = 8     -- local-Z studs

-- Minimum laser speed (studs/s) required for the velocity check to count.
-- Below this we treat the laser as stationary / noise.
local LASER_MOVE_THRESHOLD  = 0.5

-- WORLD-SPACE distance at which the passed flag resets.
-- Using world-space so it works regardless of laser orientation.
-- Must be large enough that the laser is no longer a threat.
local RESET_WORLD_DIST      = 22    -- world studs

local lastLaserCFrames = setmetatable({}, {__mode = "k"})
local lastLaserSide    = setmetatable({}, {__mode = "k"})
local laserPassedFlag  = setmetatable({}, {__mode = "k"})
local lastJumpTime     = 0

local lastDebugPrint = 0
local DEBUG_INTERVAL = 0.25

-- ==========================================
-- ARC VISUALIZER
-- ==========================================
local vizFolder = workspace:FindFirstChild("JumpArcVisualizer")
if not vizFolder then
	vizFolder      = Instance.new("Folder")
	vizFolder.Name = "JumpArcVisualizer"
	vizFolder.Parent = workspace
end

local vizParts = {}
for i = 1, 15 do
	local p          = Instance.new("Part")
	p.Size           = Vector3.new(0.4, 0.4, 0.4)
	p.Anchored       = true
	p.CanCollide     = false
	p.Material       = Enum.Material.Neon
	p.Shape          = Enum.PartType.Ball
	p.Transparency   = 1
	p.Parent         = vizFolder
	vizParts[i]      = p
end

local function hideVisualizer()
	for _, p in ipairs(vizParts) do p.Transparency = 1 end
end

-- ==========================================
-- KINEMATIC TRAJECTORY PREDICTION
-- ==========================================
local function predictJumpSafety(laser, laserVelocity)
	if not laser then return false end

	local g         = workspace.Gravity
	local jumpPower = humanoid.UseJumpPower
		and humanoid.JumpPower
		or  math.sqrt(2 * g * humanoid.JumpHeight)
	local walkSpeed = humanoid.WalkSpeed

	local moveDir = humanoid.MoveDirection
	if moveDir.Magnitude == 0 then moveDir = rootPart.CFrame.LookVector end

	local timeInAir = (2 * jumpPower) / g
	local steps     = 15
	local timeStep  = timeInAir / steps
	local startPos  = rootPart.Position
	local isSafe    = true

	for i = 1, steps do
		local t  = i * timeStep
		local pX = startPos.X + moveDir.X * walkSpeed * t
		local pZ = startPos.Z + moveDir.Z * walkSpeed * t
		local pY = startPos.Y + jumpPower * t - 0.5 * g * t * t
		local tp = Vector3.new(pX, pY, pZ)

		local futureLaserPos = laser.Position + laserVelocity * t
		local futureCF       = laser.CFrame - laser.Position + futureLaserPos
		local lp             = futureCF:PointToObjectSpace(tp)

		if math.abs(lp.X) < laser.Size.X / 2 + 1.2
		and math.abs(lp.Y) < laser.Size.Y / 2 + 2.6
		and math.abs(lp.Z) < laser.Size.Z / 2 + 1.2 then
			isSafe = false
		end

		vizParts[i].Position    = tp
		vizParts[i].Transparency = 0
	end

	local col = isSafe and Color3.new(0,1,0) or Color3.new(1,0,0)
	for i = 1, steps do vizParts[i].Color = col end
	return isSafe
end

-- ==========================================
-- HELPERS
-- ==========================================
local function clampToSafeZone(pos)
	local off  = pos - mapCenter
	local flat = Vector3.new(off.X, 0, off.Z)
	if flat.Magnitude > safeRadius then
		local c = flat.Unit * safeRadius
		return Vector3.new(mapCenter.X + c.X, pos.Y, mapCenter.Z + c.Z)
	end
	return pos
end

-- ==========================================
-- CLOSEST LASER DETECTION
-- ==========================================
local function getClosestLaser(dt, now)
	local closestLaser     = nil
	local minDistance      = math.huge
	local closestTargetPos = nil
	local laserVelocity    = Vector3.zero

	local playerPos   = rootPart.Position
	local shouldPrint = (now - lastDebugPrint) >= DEBUG_INTERVAL

	for _, item in ipairs(lasersFolder:GetChildren()) do
		if not item:IsA("BasePart") then continue end
		item.CanCollide = false

		-- localZ: how far the player is in front of / behind the laser face
		local objPos     = item.CFrame:PointToObjectSpace(playerPos)
		local localZ     = math.abs(objPos.Z)
		local currentSide = math.sign(objPos.Z)
		if currentSide == 0 then currentSide = 1 end

		-- World-space distance for the reset check
		local worldDist = (item.Position - playerPos).Magnitude

		-- CFrame delta → laser velocity in world space
		local oldCF = lastLaserCFrames[item]
		lastLaserCFrames[item] = item.CFrame
		local vel = Vector3.zero
		if oldCF then
			vel = (item.Position - oldCF.Position) / dt
		end
		local speed = vel.Magnitude

		-- ── RESET (world-space) ────────────────────────────────────────────
		-- Use world-space so orientation doesn't matter.
		-- Flag clears only once the laser is physically far from the player.
		if worldDist > RESET_WORLD_DIST then
			if laserPassedFlag[item] then
				print(string.format("[RESET] '%s' worldDist=%.2f", item.Name, worldDist))
			end
			laserPassedFlag[item] = false
			lastLaserSide[item]   = nil
			continue
		end

		-- ── PASSED DETECTION (velocity-based) ─────────────────────────────
		-- Only mark passed when the laser is ACTUALLY MOVING away from the
		-- player. This filters out false positives caused by the player
		-- walking across the laser's local-Z plane themselves.
		if not laserPassedFlag[item] then
			if speed > LASER_MOVE_THRESHOLD then
				-- Vector from laser to player (flat, world space)
				local toPlayer = Vector3.new(
					playerPos.X - item.Position.X,
					0,
					playerPos.Z - item.Position.Z
				)
				local flatVel = Vector3.new(vel.X, 0, vel.Z)

				-- dot < 0 means laser is moving AWAY from player
				local dot = (toPlayer.Magnitude > 0.01)
					and flatVel:Dot(toPlayer.Unit)
					or 0

				-- Require: laser moving away AND the player is already very
				-- close (localZ < PASS_CONFIRM_DIST) so we know it just passed.
				if dot < -0.3 and localZ < PASS_CONFIRM_DIST then
					laserPassedFlag[item] = true
					print(string.format(
						"[PASSED-VEL] '%s' dot=%.3f localZ=%.2f speed=%.2f",
						item.Name, dot, localZ, speed))
				end

				-- Secondary: side-flip while laser is moving (genuine crossing)
				local prevSide = lastLaserSide[item]
				if prevSide and prevSide ~= currentSide then
					laserPassedFlag[item] = true
					print(string.format(
						"[PASSED-FLIP] '%s' %d->%d localZ=%.2f speed=%.2f",
						item.Name, prevSide, currentSide, localZ, speed))
				end
			end
			-- If laser is barely moving we do NOT set the flag on a side-flip
			-- because that flip came from the player walking, not the laser.
		end

		lastLaserSide[item] = currentSide

		local isPassed = laserPassedFlag[item] == true

		if shouldPrint and localZ <= AGGRO_DISTANCE then
			print(string.format(
				"[DBG] '%s' localZ=%.2f worldDist=%.2f passed=%s spd=%.2f",
				item.Name, localZ, worldDist, tostring(isPassed), speed))
		end

		-- Completely ignore passed lasers - no movement target, no jump
		if isPassed then continue end

		-- Only react within AGGRO_DISTANCE (local-Z)
		if localZ > AGGRO_DISTANCE then continue end

		if localZ < minDistance then
			minDistance      = localZ
			closestLaser     = item
			laserVelocity    = vel
			-- Walk to the far side of the laser
			closestTargetPos = item.CFrame * Vector3.new(objPos.X, 0, -currentSide * 15)
		end
	end

	if shouldPrint then lastDebugPrint = now end
	return closestLaser, closestTargetPos, minDistance, laserVelocity
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
	if not character or humanoid.Health <= 0 then
		hideVisualizer()
		return
	end

	local now = tick()
	local laser, targetPos, dist, laserVelocity = getClosestLaser(dt, now)
	local state   = humanoid:GetState()
	local isInAir = state == Enum.HumanoidStateType.Freefall
	             or state == Enum.HumanoidStateType.Jumping

	local canJump = (now - lastJumpTime) >= JUMP_COOLDOWN

	if laser and targetPos then
		humanoid:MoveTo(clampToSafeZone(targetPos))

		if canJump and dist <= JUMP_TRIGGER_DISTANCE + 5 and not isInAir then
			local safe = predictJumpSafety(laser, laserVelocity)
			if dist <= JUMP_TRIGGER_DISTANCE and safe then
				print(string.format("[JUMP] '%s' dist=%.2f", laser.Name, dist))
				lastJumpTime = now
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		elseif isInAir or not canJump then
			hideVisualizer()
			end
	else
		hideVisualizer()
		if not isInAir then humanoid:MoveTo(mapCenter) end
	end
end)
