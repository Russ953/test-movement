local ARENA_Y_MARGIN  = 6
local ARENA_XZ_RADIUS = (maxMapDimension / 2) + 4

-- ---- Tuning ----
local JUMP_TRIGGER_DISTANCE = 5.5
local APPROACH_START        = 12
local AGGRO_DISTANCE        = 20
local JUMP_COOLDOWN         = 0.35
local PASS_CONFIRM_DIST     = 8
local LASER_MOVE_THRESHOLD  = 0.4
local RESET_WORLD_DIST      = 24
local TIGHT_CLEARANCE       = 1.8
local FAST_TTI              = 0.55   -- seconds: trigger early jump for lasers this fast
local AIRDASH_COOLDOWN      = 0.6    -- min gap between airdashes per jump
local AIRDASH_CHECK_START   = 0.15   -- seconds into air before checking for airdash

-- Crossing
local MAX_CROSS_DIST  = 14
local CROSS_BOTH_DIST = 18
local CROSS_OVERSHOOT = 5

-- Lookahead planner
local PLAN_INTERVAL  = 0.25   -- re-plan every N seconds
local PLAN_STEPS     = 3      -- how many jumps ahead to plan
local PLAN_CANDIDATES = 6     -- angular candidates to test per step

