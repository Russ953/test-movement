local function makePool(count, size, shape)
    local pool = {}
    for i = 1, count do
        local p = Instance.new("Part")
        p.Size       = Vector3.new(size,size,size)
        p.Anchored   = true
        p.CanCollide = false
        p.CastShadow = false
        p.Material   = Enum.Material.Neon
        p.Shape      = shape or Enum.PartType.Ball
        p.Transparency = 1
        p.Parent     = vizRoot
        pool[i]      = p
    end
    return pool
end

local function makeCylPool(count)
