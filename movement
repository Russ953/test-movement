-- ARENA CHECK
-- ==========================================
local function checkOnArena()
    local pos = rootPart.Position
    local dx  = pos.X - MAP_CENTER_X
    local dz  = pos.Z - MAP_CENTER_Z
    return math.sqrt(dx*dx+dz*dz) <= ARENA_XZ_RADIUS
        and pos.Y >= ARENA_FLOOR_Y - 1
        and pos.Y <= ARENA_FLOOR_Y + ARENA_Y_MARGIN
end

-- ==========================================
-- LASER PHYSICS
-- ==========================================
local function getLaserMotion(item, oldCF, dt)
    if not oldCF then return Vector3.zero, 0 end
    local transVel = (item.Position - oldCF.Position) / dt
    local oldFwd = Vector3.new(oldCF.LookVector.X, 0, oldCF.LookVector.Z)
    local newFwd = Vector3.new(item.CFrame.LookVector.X, 0, item.CFrame.LookVector.Z)
    local angVelY = 0
    if oldFwd.Magnitude>0.01 and newFwd.Magnitude>0.01 then
        local cross = oldFwd:Cross(newFwd)
        angVelY = cross.Y / dt
    end
    local halfLen = item.Size.Z / 2
    local perpDir = Vector3.new(newFwd.Z, 0, -newFwd.X) * math.sign(angVelY + 1e-9)
    local tipVel  = transVel + perpDir * math.abs(angVelY) * halfLen
    return tipVel, angVelY
end

local function futureLaserCF(laser, vel, angVelY, t)
    local futurePos   = laser.Position + vel * t
    local baseAngle   = math.atan2(laser.CFrame.LookVector.X, laser.CFrame.LookVector.Z)
    local futureAngle = baseAngle + angVelY * t
    return CFrame.new(futurePos) * CFrame.Angles(0, futureAngle, 0)
end

-- ==========================================
-- SAFE ZONE SCORING
-- ==========================================
local function scorePosition(pos, threats)
    local score = 0
    for _, t in ipairs(threats) do
        local laser   = t.laser
        local vel     = t.velocity
        local angVelY = t.angVelY
        local tti     = math.max(t.tti, 0.05)
        local weight  = 1 / tti

        local objPos  = laser.CFrame:PointToObjectSpace(pos)
        local distZ   = math.abs(objPos.Z)

        local halfT   = tti * 0.5
        local fcf     = futureLaserCF(laser, vel, angVelY, halfT)
        local fop     = fcf:PointToObjectSpace(pos)
        local fDistZ  = math.abs(fop.Z)

        local laserFwd = Vector3.new(laser.CFrame.LookVector.X, 0, laser.CFrame.LookVector.Z)
        local toPos    = Vector3.new(pos.X - laser.Position.X, 0, pos.Z - laser.Position.Z)
        local angSep   = 0
        if laserFwd.Magnitude>0.01 and toPos.Magnitude>0.01 then
            local dot = math.clamp(laserFwd.Unit:Dot(toPos.Unit), -1, 1)
            angSep = math.acos(dot)
        end

        score = score + (distZ*0.6 + fDistZ*0.4 + angSep*2.0) * weight
    end
    return score
end

local function getBestSafePos(threats, now)
    -- FIX v21: invalidate cache when threat count changes
    local tCount = #threats
    if cachedSafePos
       and (now - lastSafePosTime) < SCORE_UPDATE_RATE
       and tCount == lastThreatCount then
        return cachedSafePos
    end
    lastThreatCount = tCount

    if tCount == 0 then
        cachedSafePos   = mapCenter
        lastSafePosTime = now
        return mapCenter
    end

    local bestScore = -math.huge
    local bestPos   = mapCenter
    local floorY    = ARENA_FLOOR_Y + 0.5

    for _, radius in ipairs({INNER_RADIUS, OUTER_RADIUS}) do
        local ringBest = -math.huge
        local ringPos  = mapCenter
        for i = 0, SCORE_ANGLES - 1 do
            local angle = (i / SCORE_ANGLES) * math.pi * 2
            local cand  = Vector3.new(
                MAP_CENTER_X + math.cos(angle) * radius,
                floorY,
                MAP_CENTER_Z + math.sin(angle) * radius
            )
            local s = scorePosition(cand, threats)
            if s > ringBest then ringBest=s; ringPos=cand end
        end
        local eff = (radius == INNER_RADIUS) and ringBest or (ringBest - OUTER_BONUS_THRESH)
        if eff > bestScore then bestScore=eff; bestPos=ringPos end
    end

    cachedSafePos   = bestPos
    lastSafePosTime = now
    return bestPos
end

-- ==========================================
-- HELPERS
-- ==========================================
local function clampToSafe(pos)
    local dx  = pos.X - MAP_CENTER_X
    local dz  = pos.Z - MAP_CENTER_Z
    local mag = math.sqrt(dx*dx + dz*dz)
    if mag > safeRadius then
        local scale = safeRadius / mag
        return Vector3.new(MAP_CENTER_X + dx*scale, pos.Y, MAP_CENTER_Z + dz*scale)
    end
    return pos
end

local function getJumpPhysics()
    local g  = workspace.Gravity
    local jp = humanoid.UseJumpPower
        and humanoid.JumpPower
        or  math.sqrt(2*g*humanoid.JumpHeight)
    local tAir = (2*jp)/g
    return jp, tAir, g, humanoid.WalkSpeed
end

local function farSideTarget(laser, side)
    local laserZ = Vector3.new(laser.CFrame.LookVector.X, 0, laser.CFrame.LookVector.Z)
    if laserZ.Magnitude < 0.01 then laserZ = Vector3.new(1,0,0) end
    laserZ = laserZ.Unit
    local tgt = laser.Position + laserZ * (-side * FAR_SIDE_DIST)
    return clampToSafe(Vector3.new(tgt.X, ARENA_FLOOR_Y+0.5, tgt.Z))
end

-- FIX v21: return true when angVelY near zero (safe default)
local function laserSweepingToward(laser, angVelY)
    if math.abs(angVelY) < 0.05 then return true end  -- FIX v21
    local playerPos = rootPart.Position
    local toPlayer  = Vector3.new(playerPos.X-laser.Position.X, 0, playerPos.Z-laser.Position.Z)
    if toPlayer.Magnitude < 0.01 then return true end
    local fwd = Vector3.new(laser.CFrame.LookVector.X, 0, laser.CFrame.LookVector.Z)
    if fwd.Magnitude < 0.01 then return true end
    local right = Vector3.new(fwd.Z, 0, -fwd.X)
    local playerRight = right:Dot(toPlayer)
    return (angVelY * playerRight) > 0
end

-- ==========================================
-- ARC PREDICTION
-- ==========================================
local function predictArc(lasers, vels, angVels, moveDir, startPos, timeOffset)
    if #lasers==0 then return true, math.huge end
    local jp, tAir, g, ws = getJumpPhysics()
    timeOffset = timeOffset or 0

    local md = moveDir
    if not md or md.Magnitude<0.01 then md=rootPart.CFrame.LookVector end
    md = Vector3.new(md.X,0,md.Z)
    if md.Magnitude>0.01 then md=md.Unit end

    local ts   = tAir/ARC_DOT_COUNT
    local sp   = startPos or rootPart.Position
    local safe = true
    local minGap = math.huge

    for i = 1, ARC_DOT_COUNT do
        local t  = i*ts
        local tp = Vector3.new(
            sp.X + md.X*ws*t,
            sp.Y + jp*t - 0.5*g*t*t,
            sp.Z + md.Z*ws*t
        )
        for li, laser in ipairs(lasers) do
            local fcf = futureLaserCF(laser, vels[li], angVels[li], t+timeOffset)
            local lp  = fcf:PointToObjectSpace(tp)
            local bX  = laser.Size.X/2 + PAD_X
            local bY  = laser.Size.Y/2 + PAD_Y
            local bZ  = laser.Size.Z/2 + PAD_Z
            if math.abs(lp.X)<bX and math.abs(lp.Y)<bY and math.abs(lp.Z)<bZ then safe=false end
            local gap = math.min(bX-math.abs(lp.X), bY-math.abs(lp.Y), bZ-math.abs(lp.Z))
            minGap = math.min(minGap, math.abs(gap))
        end
    end

    if safe then
        local landPos = clampToSafe(Vector3.new(sp.X+md.X*ws*tAir, sp.Y, sp.Z+md.Z*ws*tAir))
        for li, laser in ipairs(lasers) do
            local fcf = futureLaserCF(laser, vels[li], angVels[li], tAir+timeOffset)
            local lp  = fcf:PointToObjectSpace(landPos)
            if math.abs(lp.X)<laser.Size.X/2+PAD_X and math.abs(lp.Z)<laser.Size.Z/2+PAD_Z then
                safe=false
            end
        end
    end

    return safe, minGap
end

-- ==========================================
-- PATH VISUALIZER (v21 - runs every frame)
-- ==========================================
local function updatePathViz(threats, bestSafe, lasers, vels, avs)
    -- Safe pos marker
    if bestSafe then
        safePosMarker.Position    = bestSafe
        safePosMarker.Transparency = 0.25
    else
        safePosMarker.Transparency = 1
    end

    if #threats == 0 then
        for s = 1, PATH_STEPS do
            local pool = stepPools[s]
            for _, p in ipairs(pool.walkDots)  do p.Transparency=1 end
            for _, p in ipairs(pool.walkConns) do p.Transparency=1 end
            for _, p in ipairs(pool.arcDots)   do p.Transparency=1 end
            pool.landSphere.Transparency=1
        end
        return
    end

    local jp, tAir, g, ws = getJumpPhysics()
    local floorY    = ARENA_FLOOR_Y + 0.5
    local simPos    = rootPart.Position
    local timeOffset = 0

    for s = 1, PATH_STEPS do
        local pool = stepPools[s]

        -- Direction: toward best safe pos
        local toSafe = bestSafe
            and Vector3.new(bestSafe.X-simPos.X, 0, bestSafe.Z-simPos.Z)
            or  Vector3.new(1,0,0)
        local simDir = toSafe.Magnitude>0.01 and toSafe.Unit or Vector3.new(1,0,0)

        -- ---- Walk segment ----
        local stepDist   = WALK_SIM_DIST / WALK_DOT_COUNT
        local walkSpeed  = math.max(ws, 1)
        local prevWalkPos = simPos
        local walkDanger  = false

        for i = 1, WALK_DOT_COUNT do
            local t   = (i * stepDist) / walkSpeed
            local pos = Vector3.new(
                simPos.X + simDir.X * i * stepDist,
                floorY,
                simPos.Z + simDir.Z * i * stepDist
            )
            -- clamp to arena
            local dx  = pos.X - MAP_CENTER_X
            local dz  = pos.Z - MAP_CENTER_Z
            local mag = math.sqrt(dx*dx+dz*dz)
            if mag > safeRadius then
                local sc = safeRadius/mag
                pos = Vector3.new(MAP_CENTER_X+dx*sc, floorY, MAP_CENTER_Z+dz*sc)
            end

            -- Check danger at this walk step
            for li, laser in ipairs(lasers) do
                local fcf    = futureLaserCF(laser, vels[li], avs[li], t + timeOffset)
                local objPos = fcf:PointToObjectSpace(pos)
                local bX = laser.Size.X/2 + PAD_X
                local bY = laser.Size.Y/2 + PAD_Y
                local bZ = laser.Size.Z/2 + PAD_Z
                if math.abs(objPos.X)<bX and math.abs(objPos.Y)<bY and math.abs(objPos.Z)<bZ then
                    walkDanger = true
                end
            end

            local walkColor = walkDanger and COLOR_WALK_DANGER or COLOR_WALK_SAFE
            local dot = pool.walkDots[i]
            dot.Position    = pos
            dot.Color       = walkColor
            dot.Transparency = 0.2

            -- Connector line
            local conn = pool.walkConns[i]
            local diff = pos - prevWalkPos
            local len  = diff.Magnitude
            if len > 0.05 then
                conn.Size        = Vector3.new(0.12, 0.12, len)
                conn.CFrame      = CFrame.lookAt((prevWalkPos+pos)*0.5, pos)
                conn.Color       = walkColor
                conn.Transparency = 0.5
            else
                conn.Transparency = 1
            end
            prevWalkPos = pos
        end

        local walkTime = WALK_SIM_DIST / walkSpeed
        timeOffset = timeOffset + walkTime

        -- Walk end = last walk dot position
        local walkEnd = pool.walkDots[WALK_DOT_COUNT].Position

        -- ---- Find best jump direction (8 candidates) ----
        local bestJumpScore = -math.huge
        local bestJumpDir   = simDir
        local bestJumpSafe  = false
        local bestJumpGap   = 0

        for ci = 0, 7 do
            local angle = (ci / 8) * math.pi * 2
            local dir   = Vector3.new(math.cos(angle), 0, math.sin(angle))
            local safe, gap = predictArc(lasers, vels, avs, dir, walkEnd, timeOffset)
            local landX = walkEnd.X + dir.X * ws * tAir
            local landZ = walkEnd.Z + dir.Z * ws * tAir
            local cDist = math.sqrt((landX-MAP_CENTER_X)^2 + (landZ-MAP_CENTER_Z)^2)
            local score = (safe and 100 or 0) + gap - cDist*0.05
            if score > bestJumpScore then
                bestJumpScore = score
                bestJumpDir   = dir
                bestJumpSafe  = safe
                bestJumpGap   = gap
            end
        end

        -- ---- Simulate jump arc ----
        local arcColor
        if not bestJumpSafe then
            arcColor = COLOR_ARC_UNSAFE
        elseif bestJumpGap < TIGHT_CLEARANCE then
            arcColor = COLOR_ARC_TIGHT
        else
            arcColor = COLOR_ARC_SAFE
        end

        local ts2 = tAir / ARC_DOT_COUNT
        local landPos = walkEnd

        for i = 1, ARC_DOT_COUNT do
            local t   = i * ts2
            local pos = Vector3.new(
                walkEnd.X + bestJumpDir.X * ws * t,
                walkEnd.Y + jp*t - 0.5*g*t*t,
                walkEnd.Z + bestJumpDir.Z * ws * t
            )
            local dot = pool.arcDots[i]
            dot.Position    = pos
            dot.Color       = arcColor
            dot.Transparency = 0.1
            if i == ARC_DOT_COUNT then
                landPos = Vector3.new(pos.X, floorY, pos.Z)
            end
        end

        -- Landing sphere
        local clamped = clampToSafe(landPos)
        pool.landSphere.Position    = clamped
        pool.landSphere.Color       = bestJumpSafe and COLOR_LAND_SAFE or COLOR_LAND_UNSAFE
        pool.landSphere.Transparency = 0.15

        -- Advance sim to landing
        simPos     = clamped
        timeOffset = timeOffset + tAir + 0.05
    end
end

-- ==========================================
-- 2D LINE INTERSECTION
-- ==========================================
local function findLaserIntersection(laserA, laserB)
    local ax=laserA.Position.X; local az=laserA.Position.Z
    local adx=laserA.CFrame.LookVector.X; local adz=laserA.CFrame.LookVector.Z
    local bx=laserB.Position.X; local bz=laserB.Position.Z
    local bdx=laserB.CFrame.LookVector.X; local bdz=laserB.CFrame.LookVector.Z
    local denom = adx*bdz - adz*bdx
    if math.abs(denom)<0.01 then return nil end
    local dx=bx-ax; local dz=bz-az
    local t=(dx*bdz - dz*bdx)/denom
    return Vector3.new(ax+t*adx, ARENA_FLOOR_Y+0.5, az+t*adz), t
end

-- ==========================================
-- LASER COLLECTION
-- ==========================================
local function collectThreats(dt, now)
    local threats   = {}
    local playerPos = rootPart.Position
    local sp = (now-lastDebugPrint)>=DEBUG_INTERVAL

    for _, item in ipairs(lasersFolder:GetChildren()) do
        if not item:IsA("BasePart") then continue end
        item.CanCollide = false

        local objPos      = item.CFrame:PointToObjectSpace(playerPos)
        local localZ      = math.abs(objPos.Z)
        local currentSide = math.sign(objPos.Z); if currentSide==0 then currentSide=1 end
        local worldDist   = (item.Position-playerPos).Magnitude

        local oldCF = lastLaserCFrames[item]
        lastLaserCFrames[item] = item.CFrame
        local tipVel, angVelY = getLaserMotion(item, oldCF, dt)
        lastLaserAngVel[item] = angVelY
        local speed = tipVel.Magnitude

        if worldDist > RESET_WORLD_DIST then
            laserPassedFlag[item]=false; lastLaserSide[item]=nil; continue
        end

        if not laserPassedFlag[item] then
            if speed > LASER_MOVE_THRESHOLD then
                local toP = Vector3.new(playerPos.X-item.Position.X,0,playerPos.Z-item.Position.Z)
                local fv  = Vector3.new(tipVel.X,0,tipVel.Z)
                local dot = toP.Magnitude>0.01 and fv:Dot(toP.Unit) or 0
                if dot<-0.3 and localZ<PASS_CONFIRM_DIST then
                    laserPassedFlag[item]=true
                    if sp then print("[PASSED-VEL] "..item.Name) end
                end
                local prevSide=lastLaserSide[item]
                if prevSide and prevSide~=currentSide then
                    laserPassedFlag[item]=true
                    if sp then print("[PASSED-FLIP] "..item.Name) end
                end
            end
        end

        lastLaserSide[item]=currentSide
        if laserPassedFlag[item] then continue end
        if localZ > AGGRO_DISTANCE then continue end

        local tti = speed>0.1 and (localZ/speed) or localZ

        -- FIX v21: only apply lookahead confirmation when far enough away
        local confirmThreat = true
        if speed > 0.1 and localZ > 5 then
            local fcf = futureLaserCF(item, tipVel, angVelY, CONFIRM_TTI_LOOKAHEAD)
            local fop = fcf:PointToObjectSpace(playerPos)
            if math.abs(fop.Z) > localZ + 1.5 then
                confirmThreat = false
            end
        end
        if not confirmThreat then continue end

        if sp then
            print(string.format("[DBG] '%s' lZ=%.1f TTI=%.2f spd=%.1f",item.Name,localZ,tti,speed))
        end

        table.insert(threats, {
            laser=item, localZ=localZ, tti=tti,
            velocity=tipVel, angVelY=angVelY, objPos=objPos,
            side=currentSide, worldDist=worldDist, speed=speed,
        })
    end

    if sp then lastDebugPrint=now end
    return threats
end

-- ==========================================
-- CROSSING DETECTION
-- ==========================================
local function findCrossing(threats)
    local playerPos = rootPart.Position
    local bestDist  = MAX_CROSS_DIST
    local bestPt,bestA,bestB = nil,nil,nil

    for i=1,#threats do
        for j=i+1,#threats do
            local a=threats[i]; local b=threats[j]
            if a.worldDist>CROSS_BOTH_DIST or b.worldDist>CROSS_BOTH_DIST then continue end
            local pt,t = findLaserIntersection(a.laser, b.laser)
            if not pt then continue end
            if t and t<-5 then continue end
            local toP = Vector3.new(pt.X-playerPos.X, 0, pt.Z-playerPos.Z)
            if toP.Magnitude < MIN_CROSS_AHEAD then continue end
            local approachDir = Vector3.new(
                a.laser.Position.X-playerPos.X, 0, a.laser.Position.Z-playerPos.Z)
            if approachDir.Magnitude>0.01 then
                approachDir=approachDir.Unit
                if toP.Unit:Dot(approachDir)<0 then continue end
            end
            local d = toP.Magnitude
            if d<bestDist then bestDist=d; bestPt=pt; bestA=a; bestB=b end
        end
    end
    return bestPt,bestA,bestB
end

-- ==========================================
-- LOOKAHEAD PLANNER
-- ==========================================
local function runPlanner(threats)
    if #threats==0 then return nil end
    local _, tAir, _, ws = getJumpPhysics()
    local waypoints = {}
    local simPos    = rootPart.Position
    local timeAcc   = 0

    local allLasers={};  local allVels={};  local allAVs={}
    for _,t in ipairs(threats) do
        table.insert(allLasers, t.laser)
        table.insert(allVels,   t.velocity)
        table.insert(allAVs,    t.angVelY)
    end

    for _ = 1, PLAN_STEPS do
        local bestScore=-math.huge; local bestLand=nil
        for ci=0,PLAN_CANDIDATES-1 do
            local angle = (ci/PLAN_CANDIDATES)*math.pi*2
            local dir   = Vector3.new(math.cos(angle), 0, math.sin(angle))
            local safe,gap = predictArc(allLasers,allVels,allAVs, dir, simPos, timeAcc)
            if safe then
                local lp = clampToSafe(Vector3.new(
                    simPos.X+dir.X*ws*tAir, simPos.Y, simPos.Z+dir.Z*ws*tAir))
                local score = gap - (mapCenter-lp).Magnitude*0.1
                if score>bestScore then bestScore=score; bestLand=lp end
            end
        end
        if not bestLand then break end
        table.insert(waypoints, bestLand)
        simPos  = bestLand
        timeAcc = timeAcc + tAir + 0.1
    end

    return #waypoints>0 and {waypoints=waypoints} or nil
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
    if not character or humanoid.Health<=0 then
        hideAllViz()
        setStatus("\xe2\x97\x89 Dead", Color3.fromRGB(255,80,80))
        clearMoveTarget(); return
    end

    local now = tick()

    if not checkOnArena() then
        hideAllViz()
        setStatus("\xe2\x97\x89 Off arena", Color3.fromRGB(180,180,180))
        timerLabel.Text = string.format("\xe2\x8f\xb1  %.1fs", now-runStart)
        lastRootPos=nil; clearMoveTarget(); return
    end

    timerLabel.Text = string.format("\xe2\x8f\xb1  %.1fs", now-runStart)
    jumpLabel.Text  = string.format("\xf0\x9f\xa6\x98 Jumps: %d", jumpCount)

    local realMoveDir = Vector3.zero
    if lastRootPos then
        local flat = Vector3.new(
            rootPart.Position.X-lastRootPos.X, 0,
            rootPart.Position.Z-lastRootPos.Z)
        if flat.Magnitude>0.005 then realMoveDir=flat.Unit end
    end
    lastRootPos = rootPart.Position

    local threats = collectThreats(dt, now)

    -- Build flat laser arrays for viz/prediction
    local allLasers={};  local allVels={};  local allAVs={}
    for _,t in ipairs(threats) do
        table.insert(allLasers, t.laser)
        table.insert(allVels,   t.velocity)
        table.insert(allAVs,    t.angVelY)
    end

    local bestSafe = getBestSafePos(threats, now)

    -- Update HUD safe pos label
    local dxS = bestSafe.X - MAP_CENTER_X
    local dzS = bestSafe.Z - MAP_CENTER_Z
    safeLabel.Text = string.format("\xf0\x9f\x9f\xa2 SafePos: %.1f studs",
        math.sqrt(dxS*dxS+dzS*dzS))

    -- ---- PATH VISUALIZER (every frame) ----
    updatePathViz(threats, bestSafe, allLasers, allVels, allAVs)

    local state   = humanoid:GetState()
    local isInAir = state==Enum.HumanoidStateType.Freefall
                 or state==Enum.HumanoidStateType.Jumping
    local canJump = (now-lastJumpTime)>=JUMP_COOLDOWN

    if isInAir and jumpStartTime==0 then jumpStartTime=now end
    if not isInAir then jumpStartTime=0; didAirdash=false end

    local dashReady = not didAirdash and isInAir
        and (now-jumpStartTime)>=AIRDASH_CHECK_START
        and (now-lastAirdashTime)>=AIRDASH_COOLDOWN
    dashLabel.Text = dashReady
        and "\xe2\x9a\xa1 Dash: READY"
        or  "\xe2\x9a\xa1 Dash: "..(didAirdash and "used" or "wait")
    dashLabel.TextColor3 = dashReady
        and Color3.fromRGB(255,100,200) or Color3.fromRGB(120,120,120)

    if #threats==0 then
        crossLabel.Text       = "\xe2\x9c\x96 No crossing"
        crossLabel.TextColor3 = Color3.fromRGB(120,200,255)
        setStatus("\xe2\x97\x89 Safe \xe2\x80\x93 optimal pos", Color3.fromRGB(80,220,160))
        if not isInAir then smartMoveTo(bestSafe) end
        currentPlan=nil; return
    end

    local crossPoint,crossA,crossB = findCrossing(threats)
    if crossPoint then
        crossLabel.Text       = string.format("\xe2\x9c\x96 CROSS: %s+%s",crossA.laser.Name,crossB.laser.Name)
        crossLabel.TextColor3 = Color3.fromRGB(0,220,255)
        crossMarker.Position  = crossPoint; crossMarker.Transparency=0
    else
        crossLabel.Text       = "\xe2\x9c\x96 No crossing"
        crossLabel.TextColor3 = Color3.fromRGB(120,200,255)
        crossMarker.Transparency=1
    end

    table.sort(threats, function(a,b) return a.tti<b.tti end)
    local primary = threats[1]

    -- FIX v21: sweepingToward defaults true at angVelY~=0
    local sweepingToward = laserSweepingToward(primary.laser, primary.angVelY)

    if now-lastPlanTime >= PLAN_INTERVAL then
        lastPlanTime=now; currentPlan=runPlanner(threats)
    end

    -- ---- Air-dash ----
    -- FIX v21: no longer returns early if no dash found
    local didExecuteDash = false
    if isInAir and dashReady then
        local chkL={primary.laser}; local chkV={primary.velocity}; local chkA={primary.angVelY}
        local airSafe = predictArc(chkL,chkV,chkA, realMoveDir, nil, 0)
        if not airSafe then
            local dashTarget=nil
            local fwd = realMoveDir.Magnitude>0.01 and realMoveDir or rootPart.CFrame.LookVector
            fwd = Vector3.new(fwd.X,0,fwd.Z).Unit
            local right = Vector3.new(fwd.Z,0,-fwd.X)
            for _, testDir in ipairs({
                right,-right,fwd,-fwd,
                (fwd+right).Unit,(fwd-right).Unit,(-fwd+right).Unit,(-fwd-right).Unit
            }) do
                if predictArc(chkL,chkV,chkA, testDir, rootPart.Position, 0) then
                    dashTarget=clampToSafe(rootPart.Position+testDir*15); break
                end
            end
            if dashTarget then
                print("[AIRDASH] "..primary.laser.Name)
                lastAirdashTime=now; didAirdash=true
                clearMoveTarget()
                humanoid:MoveTo(dashTarget)
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                setStatus("\xe2\x97\x89 AIR DASH!", Color3.fromRGB(255,100,200))
                didExecuteDash = true
            end
        end
    end

    -- Already in air: steer to far side (only if no dash executed)
    if isInAir and not didExecuteDash then
        smartMoveTo(farSideTarget(primary.laser, primary.side))
        return
    end
    if isInAir then return end

    -- ---- On ground: pick jump target ----
    local jumpTarget
    local checkLasers={};  local checkVels={};  local checkAVs={}
    local isCrossing = crossPoint~=nil

    if isCrossing then
        local toC = Vector3.new(
            crossPoint.X-rootPart.Position.X, 0,
            crossPoint.Z-rootPart.Position.Z)
        if toC.Magnitude>0.01 then toC=toC.Unit end
        jumpTarget = clampToSafe(Vector3.new(
            crossPoint.X + toC.X*CROSS_OVERSHOOT,
            ARENA_FLOOR_Y+0.5,
            crossPoint.Z + toC.Z*CROSS_OVERSHOOT))
        table.insert(checkLasers, crossA.laser); table.insert(checkVels, crossA.velocity); table.insert(checkAVs, crossA.angVelY)
        table.insert(checkLasers, crossB.laser); table.insert(checkVels, crossB.velocity); table.insert(checkAVs, crossB.angVelY)
    else
        jumpTarget = farSideTarget(primary.laser, primary.side)
        table.insert(checkLasers, primary.laser); table.insert(checkVels, primary.velocity); table.insert(checkAVs, primary.angVelY)
    end

    local toTgt   = jumpTarget - rootPart.Position
    local flatTgt = Vector3.new(toTgt.X,0,toTgt.Z)
    -- FIX v21: always use computed predictDir, never zero vector
    local predictDir = flatTgt.Magnitude>0.01 and flatTgt.Unit
        or Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z).Unit

    local triggerNow = canJump and sweepingToward
        and (primary.localZ<=JUMP_TRIGGER_DISTANCE or primary.tti<=FAST_TTI)

    if triggerNow then
        local safe,gap = predictArc(checkLasers,checkVels,checkAVs, predictDir, nil, 0)
        if safe then
            print(string.format("[JUMP%s] %s lZ=%.2f TTI=%.2f gap=%.2f",
                isCrossing and "(X)" or "",
                primary.laser.Name, primary.localZ, primary.tti, gap or 0))
            lastJumpTime=now; jumpCount=jumpCount+1
            jumpLabel.Text = string.format("\xf0\x9f\xa6\x98 Jumps: %d", jumpCount)
            clearMoveTarget()
            humanoid:MoveTo(jumpTarget)
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            setStatus(
                isCrossing and "\xe2\x97\x89 CROSSING JUMP!" or "\xe2\x97\x89 Jumping!",
                Color3.fromRGB(60,220,100))
        else
            setStatus("\xe2\x97\x89 Waiting for safe arc\xe2\x80\xa6", Color3.fromRGB(255,120,40))
        end
    elseif primary.localZ<=APPROACH_START then
        local approachTarget = sweepingToward and jumpTarget or bestSafe
        smartMoveTo(approachTarget)
        setStatus("\xe2\x97\x89 Approaching", Color3.fromRGB(255,180,40))
    else
        smartMoveTo(bestSafe)
        setStatus("\xe2\x97\x89 Optimal pos", Color3.fromRGB(140,180,255))
    end
end)
