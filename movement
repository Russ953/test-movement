-- ==========================================
-- ARENA CHECK
-- ==========================================
local function checkOnArena()
	local pos  = rootPart.Position
	local flat = Vector3.new(pos.X - mapCenter.X, 0, pos.Z - mapCenter.Z)
	return flat.Magnitude <= ARENA_XZ_RADIUS
		and pos.Y >= ARENA_TOP - 1
		and pos.Y <= ARENA_TOP + ARENA_Y_MARGIN
end

-- ==========================================
-- ANGULAR VELOCITY
-- ==========================================
local function getLaserTipVelocity(item, oldCF, dt)
	if not oldCF then return Vector3.zero end
	local transVel = (item.Position - oldCF.Position) / dt
	local oldFwd   = Vector3.new(oldCF.LookVector.X, 0, oldCF.LookVector.Z)
	local newFwd   = Vector3.new(item.CFrame.LookVector.X, 0, item.CFrame.LookVector.Z)
	if oldFwd.Magnitude < 0.01 or newFwd.Magnitude < 0.01 then return transVel end
	local cross    = oldFwd:Cross(newFwd)
	local angSpeed = cross.Y / dt
	local halfLen  = item.Size.Z / 2
	local perpDir  = Vector3.new(newFwd.Z, 0, -newFwd.X) * math.sign(angSpeed + 1e-9)
	return transVel + perpDir * math.abs(angSpeed) * halfLen
end

-- ==========================================
-- 2D LINE INTERSECTION (XZ plane)
-- ==========================================
local function findLaserIntersection(laserA, laserB)
	local ax  = laserA.Position.X;  local az  = laserA.Position.Z
	local adx = laserA.CFrame.LookVector.X; local adz = laserA.CFrame.LookVector.Z
	local bx  = laserB.Position.X;  local bz  = laserB.Position.Z
	local bdx = laserB.CFrame.LookVector.X; local bdz = laserB.CFrame.LookVector.Z
	local denom = adx * bdz - adz * bdx
	if math.abs(denom) < 0.01 then return nil end
	local dx = bx - ax;  local dz = bz - az
	local t  = (dx * bdz - dz * bdx) / denom
	return Vector3.new(ax + t*adx, ARENA_TOP + 0.5, az + t*adz), t
end

-- ==========================================
-- MULTI-LASER ARC PREDICTION
-- ==========================================
local function predictTrajectoryMulti(lasers, velocities, actualMoveDir)
	if #lasers == 0 then return false, -1 end

	local g         = workspace.Gravity
	local jumpPower = humanoid.UseJumpPower
		and humanoid.JumpPower
		or  math.sqrt(2 * g * humanoid.JumpHeight)
	local walkSpeed = humanoid.WalkSpeed

	local moveDir = actualMoveDir
	if not moveDir or moveDir.Magnitude < 0.01 then
		moveDir = rootPart.CFrame.LookVector
	end
	moveDir = Vector3.new(moveDir.X, 0, moveDir.Z)
	if moveDir.Magnitude > 0.01 then moveDir = moveDir.Unit end

	local timeInAir = (2 * jumpPower) / g
	local timeStep  = timeInAir / VIZ_STEPS
	local startPos  = rootPart.Position
	local isSafe    = true
	local minGap    = math.huge

	for i = 1, VIZ_STEPS do
		local t  = i * timeStep
		local tp = Vector3.new(
			startPos.X + moveDir.X * walkSpeed * t,
			startPos.Y + jumpPower * t - 0.5 * g * t * t,
			startPos.Z + moveDir.Z * walkSpeed * t
		)
		for li, laser in ipairs(lasers) do
			local vel      = velocities[li]
			local futureCF = laser.CFrame - laser.Position + (laser.Position + vel * t)
			local lp       = futureCF:PointToObjectSpace(tp)
			local bX = laser.Size.X/2 + 1.2
			local bY = laser.Size.Y/2 + 2.6
			local bZ = laser.Size.Z/2 + 1.2
			if math.abs(lp.X) < bX and math.abs(lp.Y) < bY and math.abs(lp.Z) < bZ then
				isSafe = false
			end
			local gap = math.min(bX-math.abs(lp.X), bY-math.abs(lp.Y), bZ-math.abs(lp.Z))
			minGap = math.min(minGap, math.abs(gap))
		end
		vizParts[i].Position     = tp
		vizParts[i].Transparency = 0
	end

	-- Landing zone check
	if isSafe then
		local landT   = timeInAir
		local landPos = Vector3.new(
			startPos.X + moveDir.X * walkSpeed * landT,
			startPos.Y,
			startPos.Z + moveDir.Z * walkSpeed * landT
		)
		for li, laser in ipairs(lasers) do
			local vel      = velocities[li]
			local futureCF = laser.CFrame - laser.Position + (laser.Position + vel * landT)
			local lp       = futureCF:PointToObjectSpace(landPos)
			if math.abs(lp.X) < laser.Size.X/2+1.4 and math.abs(lp.Z) < laser.Size.Z/2+1.4 then
				isSafe = false
			end
		end
	end

	local col = isSafe
		and (minGap < TIGHT_CLEARANCE and Color3.fromRGB(255,160,30) or Color3.fromRGB(60,220,100))
		or  Color3.fromRGB(255,50,50)
	for i = 1, VIZ_STEPS do vizParts[i].Color = col end

	return isSafe, minGap
end

-- ==========================================
-- HELPERS
-- ==========================================
local function clampToSafeZone(pos)
	local off  = pos - mapCenter
	local flat = Vector3.new(off.X, 0, off.Z)
	if flat.Magnitude > safeRadius then
		local c = flat.Unit * safeRadius
		return Vector3.new(mapCenter.X + c.X, pos.Y, mapCenter.Z + c.Z)
	end
	return pos
end

-- ==========================================
-- LASER COLLECTION
-- ==========================================
local function collectThreats(dt, now)
	local threats   = {}
	local playerPos = rootPart.Position
	local shouldPrint = (now - lastDebugPrint) >= DEBUG_INTERVAL

	for _, item in ipairs(lasersFolder:GetChildren()) do
		if not item:IsA("BasePart") then continue end
		item.CanCollide = false

		local objPos      = item.CFrame:PointToObjectSpace(playerPos)
		local localZ      = math.abs(objPos.Z)
		local currentSide = math.sign(objPos.Z)
		if currentSide == 0 then currentSide = 1 end
		local worldDist = (item.Position - playerPos).Magnitude

		local oldCF = lastLaserCFrames[item]
		lastLaserCFrames[item] = item.CFrame

		local tipVel = getLaserTipVelocity(item, oldCF, dt)
		local speed  = tipVel.Magnitude

		if worldDist > RESET_WORLD_DIST then
			laserPassedFlag[item] = false
			lastLaserSide[item]   = nil
			continue
		end

		if not laserPassedFlag[item] then
			if speed > LASER_MOVE_THRESHOLD then
				local toPlayer = Vector3.new(playerPos.X-item.Position.X, 0, playerPos.Z-item.Position.Z)
				local flatVel  = Vector3.new(tipVel.X, 0, tipVel.Z)
				local dot = toPlayer.Magnitude > 0.01 and flatVel:Dot(toPlayer.Unit) or 0
				if dot < -0.3 and localZ < PASS_CONFIRM_DIST then
					laserPassedFlag[item] = true
					print(string.format("[PASSED-VEL] '%s' dot=%.2f", item.Name, dot))
				end
				local prevSide = lastLaserSide[item]
				if prevSide and prevSide ~= currentSide then
					laserPassedFlag[item] = true
					print(string.format("[PASSED-FLIP] '%s'", item.Name))
				end
			end
		end

		lastLaserSide[item] = currentSide
		if laserPassedFlag[item] then continue end
		if localZ > AGGRO_DISTANCE then continue end

		local tti = speed > 0.1 and (localZ / speed) or localZ

		if shouldPrint then
			print(string.format("[DBG] '%s' localZ=%.1f TTI=%.2f spd=%.1f", item.Name, localZ, tti, speed))
		end

		table.insert(threats, {
			laser    = item,
			localZ   = localZ,
			tti      = tti,
			velocity = tipVel,
			objPos   = objPos,
			side     = currentSide,
			worldDist = worldDist,
		})
	end

	if shouldPrint then lastDebugPrint = now end
	return threats
end

-- ==========================================
-- CROSSING DETECTION
-- ==========================================
local function findCrossing(threats)
	local playerPos = rootPart.Position
	local bestDist  = MAX_CROSS_DIST
	local bestPoint, bestA, bestB = nil, nil, nil

	for i = 1, #threats do
		for j = i+1, #threats do
			local a = threats[i];  local b = threats[j]
			if a.worldDist > CROSS_BOTH_DIST or b.worldDist > CROSS_BOTH_DIST then continue end
			local pt, t = findLaserIntersection(a.laser, b.laser)
			if not pt then continue end
			if t ~= nil and t < -5 then continue end
			local d = (Vector3.new(pt.X, playerPos.Y, pt.Z) - playerPos).Magnitude
			if d < bestDist then
				bestDist = d;  bestPoint = pt;  bestA = a;  bestB = b
			end
		end
	end
	return bestPoint, bestA, bestB
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
	if not character or humanoid.Health <= 0 then
		hideVisualizer()
		setStatus("\xe2\x97\x89 Dead", Color3.fromRGB(255,80,80))
		return
	end

	local now = tick()

	if not checkOnArena() then
		hideVisualizer()
		setStatus("\xe2\x97\x89 Off arena", Color3.fromRGB(180,180,180))
		timerLabel.Text = string.format("\xe2\x8f\xb1  %.1fs", now - runStart)
		lastRootPos = nil
		return
	end

	timerLabel.Text = string.format("\xe2\x8f\xb1  %.1fs", now - runStart)
	jumpLabel.Text  = string.format("\xf0\x9f\xa6\x98 Jumps: %d", jumpCount)

	-- Position-delta move dir
	local realMoveDir = Vector3.zero
	if lastRootPos then
		local flat = Vector3.new(
			rootPart.Position.X - lastRootPos.X, 0,
			rootPart.Position.Z - lastRootPos.Z)
		if flat.Magnitude > 0.005 then realMoveDir = flat.Unit end
	end
	lastRootPos = rootPart.Position

	local threats = collectThreats(dt, now)
	local state   = humanoid:GetState()
	local isInAir = state == Enum.HumanoidStateType.Freefall
	             or state == Enum.HumanoidStateType.Jumping
	local canJump = (now - lastJumpTime) >= JUMP_COOLDOWN

	if #threats == 0 then
		hideVisualizer()
		crossLabel.Text       = "\xe2\x9c\x96 No crossing"
		crossLabel.TextColor3 = Color3.fromRGB(120,200,255)
		setStatus("\xe2\x97\x89 Safe \xe2\x80\x93 holding centre", Color3.fromRGB(80,220,160))
		if not isInAir then humanoid:MoveTo(mapCenter) end
		return
	end

	local crossPoint, crossA, crossB = findCrossing(threats)
	local isCrossing = crossPoint ~= nil

	if isCrossing then
		crossLabel.Text       = string.format("\xe2\x9c\x96 CROSS: %s+%s", crossA.laser.Name, crossB.laser.Name)
		crossLabel.TextColor3 = Color3.fromRGB(0,220,255)
		crossMarker.Position     = crossPoint
		crossMarker.Transparency = 0
	else
		crossLabel.Text       = "\xe2\x9c\x96 No crossing"
		crossLabel.TextColor3 = Color3.fromRGB(120,200,255)
		crossMarker.Transparency = 1
	end

	table.sort(threats, function(a, b) return a.tti < b.tti end)
	local primary = threats[1]

	if isInAir then
		-- Keep heading to target while in air
		local farSide = primary.laser.CFrame * Vector3.new(primary.objPos.X, 0, -primary.side * 15)
		humanoid:MoveTo(clampToSafeZone(farSide))
		hideVisualizer()
		return
	end

	-- Decide jump target
	local jumpTarget
	local checkLasers     = {}
	local checkVelocities = {}

	if isCrossing then
		local playerPos   = rootPart.Position
		local towardCross = Vector3.new(crossPoint.X-playerPos.X, 0, crossPoint.Z-playerPos.Z)
		if towardCross.Magnitude > 0.01 then towardCross = towardCross.Unit end
		jumpTarget = Vector3.new(
			crossPoint.X + towardCross.X * CROSS_OVERSHOOT,
			crossPoint.Y,
			crossPoint.Z + towardCross.Z * CROSS_OVERSHOOT
		)
		table.insert(checkLasers,     crossA.laser);     table.insert(checkVelocities, crossA.velocity)
		table.insert(checkLasers,     crossB.laser);     table.insert(checkVelocities, crossB.velocity)
	else
		jumpTarget = primary.laser.CFrame * Vector3.new(primary.objPos.X, 0, -primary.side * 15)
		table.insert(checkLasers,     primary.laser);    table.insert(checkVelocities, primary.velocity)
	end

	local toTarget     = jumpTarget - rootPart.Position
	local flatToTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
	local predictDir   = flatToTarget.Magnitude > 0.01 and flatToTarget.Unit or realMoveDir

	if canJump and primary.localZ <= JUMP_TRIGGER_DISTANCE then
		-- LASER IS HERE - run arc check and jump immediately if safe
		local safe, gap = predictTrajectoryMulti(checkLasers, checkVelocities, predictDir)
		if safe then
			print(string.format("[JUMP%s] '%s' localZ=%.2f gap=%.2f",
				isCrossing and "(X)" or "", primary.laser.Name, primary.localZ, gap or 0))
			lastJumpTime = now
			jumpCount    = jumpCount + 1
			jumpLabel.Text = string.format("\xf0\x9f\xa6\x98 Jumps: %d", jumpCount)
			humanoid:MoveTo(clampToSafeZone(jumpTarget))
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			setStatus(isCrossing and "\xe2\x97\x89 CROSSING JUMP!" or "\xe2\x97\x89 Jumping!",
				Color3.fromRGB(60,220,100))
		else
			-- Arc not safe yet - STAND STILL and wait for laser to be jumpable
			-- Do NOT call MoveTo (no movement = stay in place)
			setStatus("\xe2\x97\x89 Waiting for safe arc\xe2\x80\xa6", Color3.fromRGB(255,120,40))
		end

	elseif primary.localZ <= APPROACH_START then
		-- Laser is nearby but not trigger distance yet - walk toward it
		humanoid:MoveTo(clampToSafeZone(jumpTarget))
		setStatus("\xe2\x97\x89 Approaching laser", Color3.fromRGB(255,180,40))
		-- Run prediction so arc colour updates live
		predictTrajectoryMulti(checkLasers, checkVelocities, predictDir)
	else
		-- Far away - hold centre
		humanoid:MoveTo(mapCenter)
		hideVisualizer()
		setStatus("\xe2\x97\x89 Holding centre", Color3.fromRGB(140,180,255))
	end
end)
