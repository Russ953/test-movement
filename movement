    l.Font=bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.TextSize=13; l.TextXAlignment=Enum.TextXAlignment.Left
    l.Parent=frame; return l
end

local lbl_timer  = mkLabel(4,  Color3.fromRGB(80,220,160),  true)
local lbl_jumps  = mkLabel(26, Color3.fromRGB(255,200,60),  true)
local lbl_status = mkLabel(48, Color3.fromRGB(200,200,200), false)
local lbl_tti    = mkLabel(68, Color3.fromRGB(120,200,255), false)
local lbl_safe   = mkLabel(88, Color3.fromRGB(160,255,160), false)

lbl_timer.Text  = "⏱  0.0s"
lbl_jumps.Text  = "🦘 Jumps: 0"
lbl_status.Text = "● Waiting…"
lbl_tti.Text    = "TTI: —"
lbl_safe.Text   = "Safe: center"

local function setStatus(txt, col)
    lbl_status.Text      = txt
    lbl_status.TextColor3 = col or Color3.fromRGB(200,200,200)
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
local pendingJump = false  -- human reaction delay
local pendingJumpTime = 0
local pendingJumpDir  = nil
local pendingJumpThreats = nil

RunService.Heartbeat:Connect(function(dt)
    if not character or humanoid.Health <= 0 then
        hideArc()
        setStatus("● Dead", Color3.fromRGB(255,80,80))
        return
    end

    local now = tick()
    lbl_timer.Text = string.format("⏱  %.1fs", now - runStart)

    -- ---- Collect threats ----
    local threats = {}
    local pp      = rootPart.Position

    for _, laser in ipairs(getLasers()) do
        local vel, av = getLaserMotion(laser, dt)
        local tti, localZ, objPos = getTTI(laser, vel, av, pp, dt)
        if tti then
            local toward = sweepingToward(laser, av)
            table.insert(threats, {
                laser  = laser,
                vel    = vel,
                av     = av,
                tti    = tti,
                localZ = localZ,
                objPos = objPos,
                toward = toward,
                side   = math.sign(objPos.Z),
            })
        end
    end

    -- sort by TTI ascending (most urgent first)
    table.sort(threats, function(a,b) return a.tti < b.tti end)

    local primary   = threats[1]
    local safePt    = getBestSafePos(threats, now)
    safeMarker.Position    = safePt
    safeMarker.Transparency = 0.3

    local dxS = safePt.X - MAP_X
    local dzS = safePt.Z - MAP_Z
    lbl_safe.Text = string.format("Safe: %.1f studs out", math.sqrt(dxS*dxS+dzS*dzS))

    -- ---- Pending jump (reaction delay) ----
    if pendingJump and (now - pendingJumpTime) >= REACT_DELAY then
        pendingJump = false
        local safe, _, tAir = checkJumpArc(pendingJumpThreats, pendingJumpDir, nil, true)
        if safe then
            jumpCount    = jumpCount + 1
            lastJumpTime = now
            lbl_jumps.Text = string.format("🦘 Jumps: %d", jumpCount)
            lastMovePos = nil
            humanoid:MoveTo(clampArena(rootPart.Position + pendingJumpDir * humanoid.WalkSpeed * tAir))
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            setStatus("● JUMP!", Color3.fromRGB(60,220,100))
        else
            setStatus("● Blocked — repositioning", Color3.fromRGB(255,140,40))
        end
        return
    end

    -- ---- No threats ----
    if not primary then
        hideArc()
        setStatus("● Safe — optimal pos", Color3.fromRGB(80,220,160))
        lbl_tti.Text = "TTI: safe"
        -- walk to best scored position between laser sweeps
        local state = humanoid:GetState()
        if state ~= Enum.HumanoidStateType.Jumping
        and state ~= Enum.HumanoidStateType.Freefall then
            smartMove(safePt)
        end
        return
    end

    lbl_tti.Text = string.format("TTI: %.2fs | toward: %s",
        primary.tti, primary.toward and "YES" or "no")

    local state   = humanoid:GetState()
    local isAir   = state == Enum.HumanoidStateType.Jumping
               or state == Enum.HumanoidStateType.Freefall
    local canJump = (now - lastJumpTime) >= JUMP_COOLDOWN

    -- ---- In air: steer to far side ----
    if isAir then
        local target = getJumpTarget(primary.laser, primary.side)
        smartMove(target)
        setStatus("● In air — steering", Color3.fromRGB(255,200,60))
        return
    end

    -- ---- On ground ----
    -- Step 1: pre-position toward jump target during approach window
    if primary.tti <= APPROACH_TTI then
        local jTarget = getJumpTarget(primary.laser, primary.side)
        local toT     = Vector3.new(jTarget.X - pp.X, 0, jTarget.Z - pp.Z)
        if toT.Magnitude > 1.5 then
            smartMove(jTarget)
            setStatus(string.format("● Approach (TTI %.2f)", primary.tti),
                Color3.fromRGB(255,180,40))
        end
    else
        -- Stay in best safe gap
        smartMove(safePt)
        setStatus(string.format("● Optimal pos (TTI %.2f)", primary.tti),
            Color3.fromRGB(140,180,255))
    end

    -- Step 2: trigger jump at correct TTI, only if laser sweeping toward us
    if canJump and primary.toward and primary.tti <= JUMP_TTI and not pendingJump then
        -- Find best jump direction (try 8 directions)
        local bestDir = nil
        local bestGap = -math.huge
        local fwd = rootPart.CFrame.LookVector
        local dirs = {}
        for i = 0, 7 do
            local a = (i / 8) * math.pi * 2
            table.insert(dirs, Vector3.new(math.cos(a), 0, math.sin(a)))
        end
        for _, d in ipairs(dirs) do
            local ok, gap = checkJumpArc(threats, d, nil, false)
            if ok and gap > bestGap then bestGap = gap; bestDir = d end
        end

        if bestDir then
            -- Queue jump with human reaction delay
            pendingJump       = true
            pendingJumpTime   = now
            pendingJumpDir    = bestDir
            pendingJumpThreats = threats
            setStatus("● Queuing jump…", Color3.fromRGB(255,220,80))
            print(string.format("[JUMP] TTI=%.2f gap=%.2f", primary.tti, bestGap))
        else
            setStatus("● No safe arc — waiting", Color3.fromRGB(255,100,40))
        end
    end
end)

print("[LaserBot] v5.0.0 running — jump-over laser, human movement, no teleport")
