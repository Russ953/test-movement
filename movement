-- ==========================================
-- MOVEMENT SCRIPT v14
-- ==========================================
-- FIX in v14:
--   v13 backed the player away from the laser when the arc was unsafe.
--   This pushed them to the arena edge, then the laser was too far away
--   to ever trigger JUMP_TRIGGER_DISTANCE, so the bot just fell off.
--
--   New behaviour:
--   - When arc is unsafe: STAND STILL at current position and wait.
--     The laser will come to the player. No more retreating to the wall.
--   - Jump trigger is now purely "laser localZ <= JUMP_TRIGGER_DISTANCE".
--     The player does NOT need to be walking toward the laser - the laser
--     is moving toward the player, so just wait.
--   - While waiting, keep running predictTrajectory every frame so the
--     moment the arc clears (laser angle changes), the jump fires instantly.
--   - Approach walk is still used when the laser is far away (> APPROACH_START)
--     so the bot positions itself centrally before the laser arrives.
-- ==========================================
print("[Movement] v14 loaded")

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")

local player    = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid  = character:WaitForChild("Humanoid")
local rootPart  = character:WaitForChild("HumanoidRootPart")

local mapPart      = workspace:WaitForChild("Laser Game Map"):WaitForChild("Cylinder.005")
local lasersFolder = workspace:WaitForChild("Lasers"):WaitForChild("ActiveLasers")

local maxMapDimension = math.max(mapPart.Size.X, mapPart.Size.Y, mapPart.Size.Z)
local safeRadius      = (maxMapDimension / 2) - 5
local mapCenter       = mapPart.Position
local ARENA_TOP       = mapPart.Position.Y + mapPart.Size.Y / 2
local ARENA_Y_MARGIN  = 6
local ARENA_XZ_RADIUS = (maxMapDimension / 2) + 4

-- Tuning
local JUMP_TRIGGER_DISTANCE = 5.5   -- laser localZ <= this  →  jump (if arc safe)
local APPROACH_START        = 12    -- laser localZ <= this  →  start walking toward it
local AGGRO_DISTANCE        = 18
local JUMP_COOLDOWN         = 0.35
local PASS_CONFIRM_DIST     = 8
local LASER_MOVE_THRESHOLD  = 0.4
local RESET_WORLD_DIST      = 22
local TIGHT_CLEARANCE       = 1.8

-- Crossing detection tuning
local MAX_CROSS_DIST  = 14
local CROSS_BOTH_DIST = 18
local CROSS_OVERSHOOT = 5

-- State
local lastLaserCFrames = setmetatable({}, {__mode = "k"})
local lastLaserSide    = setmetatable({}, {__mode = "k"})
local laserPassedFlag  = setmetatable({}, {__mode = "k"})
local lastJumpTime     = 0
local jumpCount        = 0
local runStart         = tick()
local lastRootPos      = nil

local lastDebugPrint = 0
local DEBUG_INTERVAL = 0.4

