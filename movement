local function updateLaserViz(laser, tti, dist, isPassed, isWarmup)
    local v = getOrCreateViz(laser)
    local col
    if isWarmup then
        col = Color3.fromRGB(100,100,255)
        v.ttiLbl.Text  = "reading..."
        v.distLbl.Text = string.format("%.1f",dist)
    elseif isPassed then
        col = COL_PASSED; v.ttiLbl.Text = "PASSED"
        v.distLbl.Text = string.format("%.1f",dist)
    elseif tti < TTI_DANGER then
        col = COL_DANGER; v.ttiLbl.Text = string.format("TTI %.2fs!",tti)
        v.distLbl.Text = string.format("%.1f",dist)
    elseif tti < TTI_WARN then
        col = COL_WARN;   v.ttiLbl.Text = string.format("TTI %.2fs",tti)
        v.distLbl.Text = string.format("%.1f",dist)
    else
        col = COL_SAFE;   v.ttiLbl.Text = string.format("TTI %.1fs",tti)
        v.distLbl.Text = string.format("%.1f",dist)
    end
    v.box.Color3 = col; v.box.SurfaceColor3 = col
    v.nameLbl.TextColor3 = col; v.ttiLbl.TextColor3 = col
    v.billboard.StudsOffset = Vector3.new(0, laser.Size.Y/2+3.5, 0)
end

