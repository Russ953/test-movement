-- ==========================================
-- ARENA CONSTANTS  (edit to match your map)
-- ==========================================
local MAP_X = -178.238647
local MAP_Y =   40.161911
local MAP_Z =   12.4262772
local FLOOR_Y     = MAP_Y + (2.381 / 2)
local ARENA_R     = 33.0
local mapCenter   = Vector3.new(MAP_X, FLOOR_Y + 0.5, MAP_Z)

-- ==========================================
-- TUNING
-- ==========================================
-- Jump timing window (seconds until laser hits)
local JUMP_MAX_TTI   = 0.80   -- start considering jump
local JUMP_MIN_TTI   = 0.20   -- must jump by now
local JUMP_COOLDOWN  = 0.40   -- min gap between jumps

-- How much to overshoot past the laser center
local JUMP_OVERSHOOT = 8.0    -- studs past laser center

-- Angle search when straight perp is unsafe
local ANGLE_STEPS    = {0, 15, -15, 30, -30, 45, -45}

-- Reposition: if closest threat TTI < this, find new safe spot
local REPOSITION_TTI   = 3.5
local SAFE_RADIUS_RING = 16    -- preferred orbit ring
local SAFE_SCORE_ANGLES = 48
local SAFE_UPDATE_HZ    = 0.15  -- seconds between safe pos recalculations

-- Human-feel
local REACT_DELAY_MIN = 0.05
local REACT_DELAY_MAX = 0.12

-- Hitbox padding for arc check
local PAD_X = 0.7
local PAD_Y = 2.8
local PAD_Z = 1.0

-- Passed detection
local PASS_DIST      = 7.0
local PASS_VEL_DOT   = -0.25
local AGGRO_DIST     = 65
local LASER_MIN_SPD  = 0.3
local WORLD_RESET    = 130

-- Viz
local ARC_DOTS     = 24
local ARC_DOT_SIZE = 0.40

-- ==========================================
-- STATE
-- ==========================================
local lastCF    = setmetatable({}, {__mode="k"})
local lastSide  = setmetatable({}, {__mode="k"})
local passed    = setmetatable({}, {__mode="k"})

local lastJumpTime  = 0
local jumpCount     = 0
local runStart      = tick()

local jumpPending       = false
local jumpPendingTime   = 0   -- when to actually fire the jump (after react delay)
local jumpPendingDir    = Vector3.new(1,0,0)
local jumpPendingTarget = Vector3.new(0,0,0)

local lastSafeTime  = 0
local cachedSafe    = nil
local lastMovePos   = nil
local MOVE_THRESH   = 0.5

local lastRootPos   = nil
local realMoveDir   = Vector3.zero

