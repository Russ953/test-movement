-- ==========================================
-- PHYSICS HELPERS
-- ==========================================
local function getJump()
    local g=workspace.Gravity
    local jp=hum.UseJumpPower and hum.JumpPower or math.sqrt(2*g*hum.JumpHeight)
    return jp,(2*jp)/g,g,hum.WalkSpeed
end

local function clampArena(pos)
    local dx=pos.X-MAP_X; local dz=pos.Z-MAP_Z
    local m=math.sqrt(dx*dx+dz*dz)
    if m>ARENA_R then return Vector3.new(MAP_X+dx*(ARENA_R/m),pos.Y,MAP_Z+dz*(ARENA_R/m)) end
    return pos
end

-- FIX 1: signed angular velocity — use Y component of cross product directly
local function futureCF(laser, vel, av, t)
    local fp = laser.Position + vel * t
    local ba = math.atan2(laser.CFrame.LookVector.X, laser.CFrame.LookVector.Z)
    return CFrame.new(fp) * CFrame.Angles(0, ba + av * t, 0)
end

local function getLaserMotion(laser, oldCF, dt)
    if not oldCF or dt < 0.001 then return Vector3.zero, 0 end
    local tv = (laser.Position - oldCF.Position) / dt
    local of = Vector3.new(oldCF.LookVector.X, 0, oldCF.LookVector.Z)
    local nf = Vector3.new(laser.CFrame.LookVector.X, 0, laser.CFrame.LookVector.Z)
    -- FIX 1: signed av — Y of cross product keeps correct sign through 180 degrees
    local av = 0
    if of.Magnitude > 0.01 and nf.Magnitude > 0.01 then
        av = of:Cross(nf).Y / dt   -- signed: positive = CCW, negative = CW
    end
    -- Velocity already linear; av is now signed so no sign(av) multiply needed
    local pd = Vector3.new(nf.Z, 0, -nf.X) * av
    return tv + pd * (laser.Size.Z / 2), av
end

-- ==========================================
-- ANGULAR TTI
-- ==========================================
local function computeTTI(laser, localZ, vel, av, spd)
    if math.abs(av) > MIN_AV then
        local halfLen = laser.Size.Z / 2
        local angleRem = math.abs(math.atan(localZ / math.max(halfLen * 0.1, 1)))
        local tti_ang  = angleRem / (math.abs(av) + 0.001)
        local tti_lin  = spd > 0.1 and (localZ / spd) or 999
        return math.min(tti_ang, tti_lin)
    end
    return spd > 0.1 and (localZ / spd) or 999
end

-- ==========================================
-- POINT-IN-LASER CHECK
-- ==========================================
local function pointHitsLaser(th, worldPos, futureT)
    local fcf = futureCF(th.laser, th.vel, th.av, futureT)
    local lp  = fcf:PointToObjectSpace(worldPos)
    return math.abs(lp.X) < th.laser.Size.X/2 + PAD_X
       and math.abs(lp.Y) < th.laser.Size.Y/2 + PAD_Y
       and math.abs(lp.Z) < th.laser.Size.Z/2 + PAD_Z
end

-- ==========================================
-- ARC SAFETY CHECK  (unchanged from v28 except DIVE_FALL_STEPS now 20)
-- Returns: safe(bool), minGap(studs), diveAt(nil or fraction)
-- ==========================================
local function arcSafeWithDive(threats, dir, startPos, timeOffset)
    if #threats == 0 then return true, 999, nil end
    local jp,tAir,g,ws = getJump()
    timeOffset = timeOffset or 0
    local sp  = startPos or root.Position
    local md  = Vector3.new(dir.X, 0, dir.Z)
    if md.Magnitude < 0.01 then return false, 0, nil end
    md = md.Unit

    local function anyHit(worldPos, t)
        for _, th in ipairs(threats) do
            if pointHitsLaser(th, worldPos, t + timeOffset) then return true end
        end
        return false
    end

    -- Option A: normal full arc
    local normalSafe = true
    local ts = tAir / ARC_DOTS
    for i = 1, ARC_DOTS do
        local t  = i * ts
        local tp = Vector3.new(sp.X+md.X*ws*t, sp.Y+jp*t-0.5*g*t*t, sp.Z+md.Z*ws*t)
        if anyHit(tp, t) then normalSafe = false; break end
    end
    if normalSafe then
        local landP = clampArena(Vector3.new(sp.X+md.X*ws*tAir, FLOOR_Y+0.5, sp.Z+md.Z*ws*tAir))
        if anyHit(landP, tAir) then normalSafe = false end
    end
    if normalSafe then return true, 999, nil end

    -- Options B/C/D: dive fractions
    for _, frac in ipairs(DIVE_FRACTIONS) do
        local tDive    = frac * tAir
        local diveSafe = true
        local steps1   = math.max(4, math.floor(ARC_DOTS * frac))
        local divePos

        for i = 1, steps1 do
            local t  = tDive * (i / steps1)
            local tp = Vector3.new(sp.X+md.X*ws*t, sp.Y+jp*t-0.5*g*t*t, sp.Z+md.Z*ws*t)
            if anyHit(tp, t) then diveSafe = false; break end
            if i == steps1 then divePos = tp end
        end
        if not diveSafe or not divePos then continue end

        local vYatDive = jp - g * tDive
        local h        = divePos.Y - FLOOR_Y
        local disc     = vYatDive*vYatDive + 2*g*h
        if disc < 0 then continue end
        local tFall = (vYatDive + math.sqrt(disc)) / g

        -- FIX 6: 20 steps instead of 8
        for i = 1, DIVE_FALL_STEPS do
            local tf = tFall * (i / DIVE_FALL_STEPS)
            local tp = Vector3.new(
                divePos.X,
                divePos.Y + vYatDive*tf - 0.5*g*tf*tf,
                divePos.Z)
            if anyHit(tp, tDive + tf) then diveSafe = false; break end
        end
        if not diveSafe then continue end

        local landP = clampArena(Vector3.new(divePos.X, FLOOR_Y+0.5, divePos.Z))
        if anyHit(landP, tDive + tFall) then continue end

        return true, 999, frac
    end

    return false, -1, nil
end

-- ==========================================
-- NECESSITY CHECK  (FIX 4: checks ALL threats)
-- ==========================================
local function mustJumpToAvoid(threats, currentPos, targetPos)
    local _,_,_,ws = getJump()
    local walkDir  = Vector3.zero
    local walkDist = 0
    if targetPos then
        local diff = Vector3.new(targetPos.X-currentPos.X, 0, targetPos.Z-currentPos.Z)
        walkDist = diff.Magnitude
        if walkDist > 0.5 then walkDir = diff.Unit end
    end

    -- FIX 4: loop over every threat, not just primary
    for _, threat in ipairs(threats) do
        if threat.spd <= MIN_SPD and math.abs(threat.av) <= MIN_AV then continue end
        local laser   = threat.laser
        local horizon = math.max(threat.tti * 1.8, 1.5)
        local dt2     = horizon / 30

        for i = 1, 30 do
            local t      = i * dt2
            local walked = math.min(ws*t, walkDist)
            local simPos = Vector3.new(
                currentPos.X+walkDir.X*walked, currentPos.Y,
                currentPos.Z+walkDir.Z*walked)
            local fcf = futureCF(laser, threat.vel, threat.av, t)
            local lp  = fcf:PointToObjectSpace(simPos)
            if math.abs(lp.X)<laser.Size.X/2+PAD_X
            and math.abs(lp.Y)<laser.Size.Y/2+PAD_Y
            and math.abs(lp.Z)<laser.Size.Z/2+PAD_Z then
                return true   -- this threat requires a jump
            end
        end
    end
    return false
end

-- ==========================================
-- BEST JUMP DIRECTION
-- Returns: dir, safe, gap, diveAt
-- ==========================================
local function getBestJumpDir(threats, fromPos, timeOffset)
    fromPos    = fromPos    or root.Position
    timeOffset = timeOffset or 0
    if #threats == 0 then return Vector3.new(1,0,0), true, 999, nil end

    local bestNormalDir = nil; local bestNormalGap = -math.huge
    local bestDiveDir   = nil; local bestDiveFrac  = nil; local bestDiveGap = -math.huge

    for _, dir in ipairs(SWEEP_DIRS) do
        local safe, gap, diveAt = arcSafeWithDive(threats, dir, fromPos, timeOffset)
        if safe then
            if diveAt == nil then
                if gap > bestNormalGap then bestNormalGap = gap; bestNormalDir = dir end
            else
                if gap > bestDiveGap then bestDiveGap = gap; bestDiveDir = dir; bestDiveFrac = diveAt end
            end
        end
    end

    if bestNormalDir then return bestNormalDir, true, bestNormalGap, nil end
    if bestDiveDir   then return bestDiveDir,   true, bestDiveGap,  bestDiveFrac end

    local leastBad = -math.huge; local leastDir = SWEEP_DIRS[1]
    for _, dir in ipairs(SWEEP_DIRS) do
        local _, gap, _ = arcSafeWithDive(threats, dir, fromPos, timeOffset)
        if gap > leastBad then leastBad = gap; leastDir = dir end
    end
    return leastDir, false, leastBad, nil
end

-- ==========================================
-- SAFE POSITION  (FIX 2 + FIX 3)
-- ==========================================

-- FIX 2: evaluate each threat at its actual arrival time, not a fixed fraction
local function scorePos(pos, threats)
    if #threats == 0 then return math.huge end
    local worstClearance = math.huge
    for _, th in ipairs(threats) do
        -- FIX 2: use clamped real TTI as the evaluation time
        local t   = math.max(math.min(th.tti, 2.0), 0.1)
        local fcf = futureCF(th.laser, th.vel, th.av, t)
        local op  = fcf:PointToObjectSpace(pos)
        local bX  = th.laser.Size.X/2 + PAD_X + 1.5
        local bZ  = th.laser.Size.Z/2 + PAD_Z + 1.5
        local clearX     = math.abs(op.X) - bX
        local clearZ     = math.abs(op.Z) - bZ
        local clearance  = math.min(clearX, clearZ)
        local weight     = 1.0 / math.max(th.tti, 0.1)
        worstClearance   = math.min(worstClearance, clearance / weight)
    end
    return worstClearance
end

-- FIX 3: invalidate cache if any threat laser has moved significantly since last fill
local function cacheStale(threats)
    for _, th in ipairs(threats) do
        local prev = cachePos[th.laser]
        if prev then
            local d = (th.laser.Position - prev).Magnitude
            if d > SAFE_MOVE_INVAL then return true end
        else
            return true  -- new laser, never cached
        end
    end
    return false
end

local function getBestSafe(threats, now)
    -- FIX 3: invalidate on movement in addition to time
    if cachedSafe and (now - lastSafeTime) < SAFE_HZ and not cacheStale(threats) then
        return cachedSafe
    end
    if #threats == 0 then
        cachedSafe = mapCenter; lastSafeTime = now; return mapCenter
    end
    local best    = -math.huge
    local bestPos = mapCenter
    local fy      = FLOOR_Y + 0.5
    for _, radius in ipairs({SAFE_RING_1, SAFE_RING_2, SAFE_RING_3}) do
        for i = 0, SAFE_ANGLES - 1 do
            local a = (i / SAFE_ANGLES) * math.pi * 2
            local c = Vector3.new(MAP_X+math.cos(a)*radius, fy, MAP_Z+math.sin(a)*radius)
            local dx=c.X-MAP_X; local dz=c.Z-MAP_Z
            if math.sqrt(dx*dx+dz*dz) <= ARENA_R then
                local s = scorePos(c, threats)
                if s > best then best = s; bestPos = c end
            end
        end
    end
    local sc = scorePos(mapCenter, threats)
    if sc > best then bestPos = mapCenter end
    -- FIX 3: snapshot laser positions for next stale check
    for _, th in ipairs(threats) do
        cachePos[th.laser] = th.laser.Position
    end
    cachedSafe = bestPos; lastSafeTime = now
    return bestPos
end

-- ==========================================
-- MULTI-STEP PATH PLANNER
-- ==========================================
local function planAndDrawPath(threats, now)
    if #threats == 0 then hidePath(); return {} end
    local jp,tAir,g,ws = getJump()
    local plan   = {}
    local curPos = root.Position
    local timeAcc = 0

    for step = 1, MAX_PLAN_STEPS do
        local bestThreat = nil; local bestTTI = math.huge
        for _,th in ipairs(threats) do
            local fcf  = futureCF(th.laser, th.vel, th.av, timeAcc)
            local objP = fcf:PointToObjectSpace(curPos)
            local lZ   = math.abs(objP.Z)
            local tti  = computeTTI(th.laser, lZ, th.vel, th.av, th.spd)
            if not passed[th.laser] and tti < bestTTI then
                bestTTI = tti; bestThreat = th
            end
        end
        if not bestThreat or bestTTI > REPOSITION_TTI then break end

        local safePos = getBestSafe(threats, now)
        drawWalkSeg(step, curPos, safePos)
        local dir, safe, _, diveAt = getBestJumpDir(threats, safePos, timeAcc)
        local landPos = drawJumpArc(step, safePos, dir, jp, tAir, g, ws, diveAt)
        landPos = clampArena(Vector3.new(landPos.X, FLOOR_Y+0.5, landPos.Z))
        table.insert(plan, {fromPos=safePos, dir=dir, landPos=landPos, safe=safe, tti=bestTTI, diveAt=diveAt})
        timeAcc = timeAcc + tAir + 0.25
        curPos  = landPos
    end

    for step = #plan+1, MAX_PLAN_STEPS do
        for _,p in ipairs(arcPools[step])  do p.Transparency=1 end
        for _,p in ipairs(walkPools[step]) do p.Transparency=1 end
        landDots[step].Transparency=1
        diveDots[step].Transparency=1
    end
    return plan
end

-- ==========================================
-- MOVEMENT HELPERS
-- ==========================================
local function moveTo(pos)
    if lastMovePos then
        local dx=pos.X-lastMovePos.X; local dz=pos.Z-lastMovePos.Z
        if dx*dx+dz*dz < MOVE_THRESH*MOVE_THRESH then return end
    end
    lastMovePos=pos; hum:MoveTo(pos)
end
local function clearMove() lastMovePos=nil end

local function onArena()
    local p=root.Position
    local dx=p.X-MAP_X; local dz=p.Z-MAP_Z
    return math.sqrt(dx*dx+dz*dz) <= (ARENA_R+6)
        and p.Y >= FLOOR_Y-1 and p.Y <= FLOOR_Y+9
end

-- ==========================================
-- COLLECT THREATS
-- ==========================================
local function collectThreats(dt)
    local out={}
    local pp=root.Position

    for _,item in ipairs(lasersFolder:GetChildren()) do
        if not item:IsA("BasePart") then continue end
        item.CanCollide=false

        local wd=(item.Position-pp).Magnitude
        if wd>WORLD_RESET then
            passed[item]=false; lastSide[item]=nil
            frameCount[item]=0; smoothedTTI[item]=nil
            updateLaserViz(item,999,wd,false,false)
            continue
        end

        local objPos=item.CFrame:PointToObjectSpace(pp)
        local localZ=math.abs(objPos.Z)
        local curSide=math.sign(objPos.Z); if curSide==0 then curSide=1 end

        local oldCF=lastCF[item]
        lastCF[item]=item.CFrame
        local vel,av=getLaserMotion(item,oldCF,dt)
        local spd=vel.Magnitude

        frameCount[item]=(frameCount[item] or 0)+1
        local warming=frameCount[item]<WARMUP_FRAMES

        if not passed[item] and not warming then
            if spd>MIN_SPD then
                local toP=Vector3.new(pp.X-item.Position.X,0,pp.Z-item.Position.Z)
                local fv=Vector3.new(vel.X,0,vel.Z)
                if toP.Magnitude>0.01 and fv:Dot(toP.Unit)<PASS_VEL_DOT and localZ<PASS_DIST then
                    passed[item]=true
                end
                local prev=lastSide[item]
                if prev and prev~=curSide then passed[item]=true end
            end
        end
        lastSide[item]=curSide

        if passed[item] then updateLaserViz(item,999,wd,true,false); continue end
        if localZ>AGGRO_DIST then updateLaserViz(item,999,wd,false,false); continue end

        local rawTTI=computeTTI(item,localZ,vel,av,spd)
        if not smoothedTTI[item] or smoothedTTI[item]>200 then
            smoothedTTI[item]=rawTTI
        else
            smoothedTTI[item]=smoothedTTI[item]*(1-TTI_ALPHA)+rawTTI*TTI_ALPHA
        end
        local tti=smoothedTTI[item]

        if spd>MIN_SPD then
            local fcf=futureCF(item,vel,av,0.1)
            local fop=fcf:PointToObjectSpace(pp)
            if math.abs(fop.Z)>localZ+2.0 then
                updateLaserViz(item,999,wd,false,warming); continue
            end
        end

        updateLaserViz(item,tti,wd,false,warming)
        if not warming then
            table.insert(out,{laser=item,localZ=localZ,tti=tti,vel=vel,av=av,
                               objPos=objPos,side=curSide,wd=wd,spd=spd})
        end
    end

    purgeDeadViz()
    table.sort(out,function(a,b) return a.tti<b.tti end)
    return out
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
    if not char or hum.Health<=0 then
        hidePath(); safeDot.Transparency=1
        setStatus("Dead", Color3.fromRGB(255,80,80))
        clearMove(); diveScheduled=false; diveRetryCount=0; return
    end

    local now = tick()
    lTimer.Text = string.format("[v29] %.1fs", now-runStart)

    if not onArena() then
        hidePath(); safeDot.Transparency=1
        setStatus("Off arena", Color3.fromRGB(180,180,180))
        clearMove(); diveScheduled=false; diveRetryCount=0; return
    end

    local threats = collectThreats(dt)
    local state   = hum:GetState()
    local inAir   = state==Enum.HumanoidStateType.Freefall
                 or state==Enum.HumanoidStateType.Jumping
    local canJump = (now-lastJumpTime) >= JUMP_COOLDOWN

    if #threats > 0 then
        lTTI.Text = string.format("TTI: %.2fs  n=%d", threats[1].tti, #threats)
    else
        lTTI.Text = "TTI: safe"
    end

    local bestSafe = getBestSafe(threats, now)
    safeDot.Position = bestSafe; safeDot.Transparency = 0.3
    planAndDrawPath(threats, now)

    -- FIX 5: Dive retry — fire ChangeState and retry up to DIVE_RETRY_MAX frames
    if diveScheduled and now >= diveTriggerTime then
        if inAir then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            diveRetryCount = diveRetryCount + 1
            setStatus("DIVE! (try "..diveRetryCount..")", Color3.fromRGB(255,80,200))
            lDive.Text = "Dive: FIRED x"..diveRetryCount
            if diveRetryCount >= DIVE_RETRY_MAX then
                diveScheduled = false; diveRetryCount = 0
            end
        else
            -- No longer in air — dive window missed, cancel
            diveScheduled = false; diveRetryCount = 0
            lDive.Text = "Dive: missed"
        end
    end

    if #threats == 0 then
        jumpPending = false; diveScheduled = false; diveRetryCount = 0
        setStatus("Safe - holding", Color3.fromRGB(80,220,160))
        lDive.Text = "Dive: -"
        if not inAir then moveTo(bestSafe) end
        return
    end

    local primary = threats[1]

    if inAir then
        if jumpPending then moveTo(jumpPendTarget)
        else moveTo(bestSafe) end
        return
    end

    -- Fire pending jump
    if jumpPending and now >= jumpPendTime then
        local safe, _, diveAt = arcSafeWithDive(threats, jumpPendDir, nil, 0)
        if safe then
            jumpCount = jumpCount+1
            lJumps.Text = string.format("Jumps: %d", jumpCount)
            lastJumpTime = now; jumpPending = false; clearMove()
            hum:MoveTo(jumpPendTarget)
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            if diveAt then
                local _,tAir,_,_ = getJump()
                diveScheduled   = true
                diveRetryCount  = 0
                diveTriggerTime = now + diveAt * tAir
                lDive.Text = string.format("Dive: @%.0f%%", diveAt*100)
            else
                diveScheduled = false; diveRetryCount = 0
                lDive.Text = "Dive: none"
            end
            setStatus(diveAt and "JUMP+DIVE!" or "JUMP!", Color3.fromRGB(60,255,100))
            return
        else
            jumpPending = false; diveScheduled = false; diveRetryCount = 0
            setStatus("Replanning", Color3.fromRGB(255,120,40))
        end
    end

    local inWindow   = primary.tti <= JUMP_MAX_TTI
    local needsRepos = primary.tti >  REPOSITION_TTI

    if needsRepos and not jumpPending then
        moveTo(bestSafe)
        setStatus(string.format("Reposition %.1fs", primary.tti), Color3.fromRGB(140,180,255))
        return
    end

    if inWindow and canJump and not jumpPending then
        -- FIX 4: pass full threats list to mustJumpToAvoid
        local needsJump = mustJumpToAvoid(threats, root.Position, bestSafe)
        if not needsJump then
            moveTo(bestSafe)
            setStatus(string.format("No jump %.2fs", primary.tti), Color3.fromRGB(0,220,120))
            return
        end

        local dir, safe, _, diveAt = getBestJumpDir(threats, nil, 0)
        local jp,tAir,g,ws = getJump()
        local landTarget
        if diveAt then
            local tDive = diveAt * tAir
            local md    = Vector3.new(dir.X,0,dir.Z).Unit
            local diveX = root.Position.X + md.X*ws*tDive
            local diveZ = root.Position.Z + md.Z*ws*tDive
            landTarget  = clampArena(Vector3.new(diveX, FLOOR_Y+0.5, diveZ))
        else
            local md = Vector3.new(dir.X,0,dir.Z).Unit
            landTarget = clampArena(Vector3.new(
                root.Position.X+md.X*ws*tAir,
                FLOOR_Y+0.5,
                root.Position.Z+md.Z*ws*tAir))
        end

        if safe then
            local delay = REACT_MIN + math.random()*(REACT_MAX-REACT_MIN)
            jumpPending    = true
            jumpPendTime   = now + delay
            jumpPendDir    = dir
            jumpPendTarget = landTarget
            jumpPendDive   = diveAt
            setStatus("Ready...", Color3.fromRGB(255,200,60))
            lDive.Text = diveAt and string.format("Dive: planned @%.0f%%", diveAt*100) or "Dive: none"
        else
            if primary.tti <= JUMP_MIN_TTI then
                jumpCount = jumpCount+1
                lJumps.Text = string.format("Jumps: %d", jumpCount)
                lastJumpTime = now; clearMove()
                hum:MoveTo(landTarget)
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                if diveAt then
                    diveScheduled   = true
                    diveRetryCount  = 0
                    diveTriggerTime = now + diveAt * tAir
                end
                setStatus("FORCED!", Color3.fromRGB(255,80,80))
            else
                moveTo(bestSafe)
                setStatus("No safe arc", Color3.fromRGB(255,120,40))
            end
        end
        return
    end

    if not jumpPending then
        moveTo(bestSafe)
        setStatus(string.format("Holding %.2fs", primary.tti), Color3.fromRGB(140,180,255))
    end
end)
