				planConns[i].Transparency=1
			end
		else
			wp.Transparency=1; planConns[i].Transparency=1
		end
	end
end

-- ==========================================
-- ARENA CHECK
-- ==========================================
local function checkOnArena()
	local pos  = rootPart.Position
	local flat = Vector3.new(pos.X-mapCenter.X, 0, pos.Z-mapCenter.Z)
	return flat.Magnitude<=ARENA_XZ_RADIUS
		and pos.Y>=ARENA_TOP-1 and pos.Y<=ARENA_TOP+ARENA_Y_MARGIN
end

-- ==========================================
-- ANGULAR VELOCITY
-- ==========================================
local function getLaserTipVelocity(item, oldCF, dt)
	if not oldCF then return Vector3.zero end
	local transVel = (item.Position-oldCF.Position)/dt
	local oldFwd=Vector3.new(oldCF.LookVector.X,0,oldCF.LookVector.Z)
	local newFwd=Vector3.new(item.CFrame.LookVector.X,0,item.CFrame.LookVector.Z)
	if oldFwd.Magnitude<0.01 or newFwd.Magnitude<0.01 then return transVel end
	local cross=oldFwd:Cross(newFwd)
	local angSpeed=cross.Y/dt
	local halfLen=item.Size.Z/2
	local perpDir=Vector3.new(newFwd.Z,0,-newFwd.X)*math.sign(angSpeed+1e-9)
	return transVel+perpDir*math.abs(angSpeed)*halfLen
end

-- ==========================================
-- 2D LINE INTERSECTION
-- ==========================================
local function findLaserIntersection(laserA, laserB)
	local ax=laserA.Position.X; local az=laserA.Position.Z
	local adx=laserA.CFrame.LookVector.X; local adz=laserA.CFrame.LookVector.Z
	local bx=laserB.Position.X; local bz=laserB.Position.Z
	local bdx=laserB.CFrame.LookVector.X; local bdz=laserB.CFrame.LookVector.Z
	local denom=adx*bdz-adz*bdx
	if math.abs(denom)<0.01 then return nil end
	local dx=bx-ax; local dz=bz-az
	local t=(dx*bdz-dz*bdx)/denom
	return Vector3.new(ax+t*adx, ARENA_TOP+0.5, az+t*adz), t
end

-- ==========================================
-- HELPERS
-- ==========================================
local function clampToSafe(pos)
	local off=pos-mapCenter
	local flat=Vector3.new(off.X,0,off.Z)
	if flat.Magnitude>safeRadius then
		local c=flat.Unit*safeRadius
		return Vector3.new(mapCenter.X+c.X, pos.Y, mapCenter.Z+c.Z)
	end
	return pos
end

local function getJumpPhysics()
	local g=workspace.Gravity
	local jp = humanoid.UseJumpPower
		and humanoid.JumpPower
		or  math.sqrt(2*g*humanoid.JumpHeight)
	local tAir = (2*jp)/g
	return jp, tAir, g, humanoid.WalkSpeed
end

-- Simulate where a laser will be after time t (translation only, good enough for planner)
local function laserPosAt(laser, vel, t)
	return laser.CFrame + (vel * t - laser.Position + laser.Position)
end

-- Does point p collide with laser (future CFrame futureCF, size sz)?
local function hitCheck(futureCF, sz, p, padXZ, padY)
	local lp = futureCF:PointToObjectSpace(p)
	return math.abs(lp.X)<sz.X/2+padXZ
		and math.abs(lp.Y)<sz.Y/2+padY
		and math.abs(lp.Z)<sz.Z/2+padXZ
end

-- ==========================================
-- MULTI-LASER ARC PREDICTION
-- startPos overridable for planner
-- ==========================================
local function predictArc(lasers, velocities, moveDir, startPos, showViz, timeOffset)
	if #lasers==0 then return true, math.huge end
	local jp, tAir, g, ws = getJumpPhysics()
	timeOffset = timeOffset or 0

	local md = moveDir
	if not md or md.Magnitude<0.01 then md=rootPart.CFrame.LookVector end
	md=Vector3.new(md.X,0,md.Z)
	if md.Magnitude>0.01 then md=md.Unit end

	local ts=tAir/VIZ_STEPS
	local sp=startPos or rootPart.Position
	local safe=true; local minGap=math.huge

	for i=1,VIZ_STEPS do
		local t=i*ts
		local tp=Vector3.new(
			sp.X+md.X*ws*t,
			sp.Y+jp*t-0.5*g*t*t,
			sp.Z+md.Z*ws*t
		)
		for li,laser in ipairs(lasers) do
			local vel=velocities[li]
			local fcf=laser.CFrame-laser.Position+(laser.Position+vel*(t+timeOffset))
			local lp=fcf:PointToObjectSpace(tp)
			local bX=laser.Size.X/2+1.2; local bY=laser.Size.Y/2+2.6; local bZ=laser.Size.Z/2+1.2
			if math.abs(lp.X)<bX and math.abs(lp.Y)<bY and math.abs(lp.Z)<bZ then safe=false end
			local gap=math.min(bX-math.abs(lp.X), bY-math.abs(lp.Y), bZ-math.abs(lp.Z))
			minGap=math.min(minGap, math.abs(gap))
		end
		if showViz then
			vizParts[i].Position=tp; vizParts[i].Transparency=0
		end
	end

	-- Landing check
	if safe then
		local landPos=Vector3.new(sp.X+md.X*ws*tAir, sp.Y, sp.Z+md.Z*ws*tAir)
		for li,laser in ipairs(lasers) do
			local vel=velocities[li]
			local fcf=laser.CFrame-laser.Position+(laser.Position+vel*(tAir+timeOffset))
			local lp=fcf:PointToObjectSpace(landPos)
			if math.abs(lp.X)<laser.Size.X/2+1.4 and math.abs(lp.Z)<laser.Size.Z/2+1.4 then
				safe=false
			end
		end
	end

	if showViz then
		local col=safe and (minGap<TIGHT_CLEARANCE and Color3.fromRGB(255,160,30) or Color3.fromRGB(60,220,100))
			or Color3.fromRGB(255,50,50)
		for i=1,VIZ_STEPS do vizParts[i].Color=col end
	end
	return safe, minGap
end

-- ==========================================
-- LASER COLLECTION
-- ==========================================
local function collectThreats(dt, now)
	local threats   = {}
	local playerPos = rootPart.Position
	local sp = (now-lastDebugPrint)>=DEBUG_INTERVAL

	for _,item in ipairs(lasersFolder:GetChildren()) do
		if not item:IsA("BasePart") then continue end
		item.CanCollide=false

		local objPos=item.CFrame:PointToObjectSpace(playerPos)
		local localZ=math.abs(objPos.Z)
		local currentSide=math.sign(objPos.Z); if currentSide==0 then currentSide=1 end
		local worldDist=(item.Position-playerPos).Magnitude

		local oldCF=lastLaserCFrames[item]
		lastLaserCFrames[item]=item.CFrame
		local tipVel=getLaserTipVelocity(item, oldCF, dt)
		local speed=tipVel.Magnitude

		if worldDist>RESET_WORLD_DIST then
			laserPassedFlag[item]=false; lastLaserSide[item]=nil; continue
		end

		if not laserPassedFlag[item] then
			if speed>LASER_MOVE_THRESHOLD then
				local toP=Vector3.new(playerPos.X-item.Position.X,0,playerPos.Z-item.Position.Z)
				local fv=Vector3.new(tipVel.X,0,tipVel.Z)
				local dot=toP.Magnitude>0.01 and fv:Dot(toP.Unit) or 0
				if dot<-0.3 and localZ<PASS_CONFIRM_DIST then
					laserPassedFlag[item]=true
					if sp then print(string.format("[PASSED-VEL] '%s'",item.Name)) end
				end
				local prevSide=lastLaserSide[item]
				if prevSide and prevSide~=currentSide then
					laserPassedFlag[item]=true
					if sp then print(string.format("[PASSED-FLIP] '%s'",item.Name)) end
				end
			end
		end

		lastLaserSide[item]=currentSide
		if laserPassedFlag[item] then continue end
		if localZ>AGGRO_DISTANCE then continue end

		local tti=speed>0.1 and (localZ/speed) or localZ
		if sp then print(string.format("[DBG] '%s' lZ=%.1f TTI=%.2f spd=%.1f",item.Name,localZ,tti,speed)) end

		table.insert(threats, {
			laser=item, localZ=localZ, tti=tti,
			velocity=tipVel, objPos=objPos,
			side=currentSide, worldDist=worldDist, speed=speed,
		})
	end

	if sp then lastDebugPrint=now end
	return threats
end

-- ==========================================
-- CROSSING DETECTION
-- ==========================================
local function findCrossing(threats)
	local playerPos=rootPart.Position
	local bestDist=MAX_CROSS_DIST
	local bestPt,bestA,bestB=nil,nil,nil
	for i=1,#threats do
		for j=i+1,#threats do
			local a=threats[i]; local b=threats[j]
			if a.worldDist>CROSS_BOTH_DIST or b.worldDist>CROSS_BOTH_DIST then continue end
			local pt,t=findLaserIntersection(a.laser,b.laser)
			if not pt then continue end
			if t and t<-5 then continue end
			local d=(Vector3.new(pt.X,playerPos.Y,pt.Z)-playerPos).Magnitude
			if d<bestDist then bestDist=d; bestPt=pt; bestA=a; bestB=b end
		end
	end
	return bestPt,bestA,bestB
end

-- ==========================================
-- LOOKAHEAD PLANNER
-- Simulates PLAN_STEPS jumps ahead, returns waypoints table
-- ==========================================
local function runPlanner(threats)
	if #threats==0 then return nil end

	local jp, tAir, g, ws = getJumpPhysics()
	local waypoints = {}
	local simPos    = rootPart.Position
	local timeAcc   = 0   -- total simulated time elapsed

	-- Only use threats as "live" laser references
	local allLasers = {}
	local allVels   = {}
	for _,t in ipairs(threats) do
		table.insert(allLasers, t.laser)
		table.insert(allVels,   t.velocity)
	end

	for step = 1, PLAN_STEPS do
		-- Build list of lasers that will still be relevant at this point in time
		local stepLasers = allLasers
		local stepVels   = allVels

		-- Try PLAN_CANDIDATES directions (spread around forward)
		local bestDir   = nil
		local bestScore = -math.huge
		local bestLandPos = nil

		for ci = 0, PLAN_CANDIDATES-1 do
			-- Sample directions in a circle
			local angle = (ci / PLAN_CANDIDATES) * math.pi * 2
			local dir   = Vector3.new(math.cos(angle), 0, math.sin(angle))

			-- Check arc from simPos in this direction against all lasers at timeAcc offset
			local safe, gap = predictArc(stepLasers, stepVels, dir, simPos, false, timeAcc)

			if safe then
				-- Score: prefer directions toward map center + larger gap
				local landPos=Vector3.new(simPos.X+dir.X*ws*tAir, simPos.Y, simPos.Z+dir.Z*ws*tAir)
				landPos = clampToSafe(landPos)
				local toCentre=(mapCenter-landPos).Magnitude
				local score=gap - toCentre*0.1
				if score>bestScore then
					bestScore=score; bestDir=dir; bestLandPos=landPos
				end
			end
		end

		if not bestLandPos then
			-- No safe direction found at this step, stop planning here
			break
		end

		table.insert(waypoints, bestLandPos)
		simPos   = bestLandPos
		timeAcc  = timeAcc + tAir + 0.1  -- 0.1s landing buffer
	end

	return #waypoints>0 and {waypoints=waypoints} or nil
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
	if not character or humanoid.Health<=0 then
		hideAll(); setStatus("\xe2\x97\x89 Dead",Color3.fromRGB(255,80,80))
		return
	end

	local now = tick()

	if not checkOnArena() then
		hideAll()
		setStatus("\xe2\x97\x89 Off arena",Color3.fromRGB(180,180,180))
		timerLabel.Text=string.format("\xe2\x8f\xb1  %.1fs",now-runStart)
		lastRootPos=nil; return
	end

	timerLabel.Text=string.format("\xe2\x8f\xb1  %.1fs",now-runStart)
	jumpLabel.Text =string.format("\xf0\x9f\xa6\x98 Jumps: %d",jumpCount)

	-- Position-delta move dir
	local realMoveDir=Vector3.zero
	if lastRootPos then
		local flat=Vector3.new(rootPart.Position.X-lastRootPos.X,0,rootPart.Position.Z-lastRootPos.Z)
		if flat.Magnitude>0.005 then realMoveDir=flat.Unit end
	end
	lastRootPos=rootPart.Position

	local threats=collectThreats(dt,now)
	local state  =humanoid:GetState()
	local isInAir=state==Enum.HumanoidStateType.Freefall
	          or state==Enum.HumanoidStateType.Jumping
	local canJump=(now-lastJumpTime)>=JUMP_COOLDOWN

	-- Track when we left the ground
	if isInAir and jumpStartTime==0 then
		jumpStartTime=now
	end
	if not isInAir then
		jumpStartTime=0; didAirdash=false
	end

	-- Dash label update
	local dashReady = not didAirdash and isInAir
		and (now-jumpStartTime)>=AIRDASH_CHECK_START
		and (now-lastAirdashTime)>=AIRDASH_COOLDOWN
	dashLabel.Text = dashReady
		and "\xe2\x9a\xa1 Dash: READY"
		or  "\xe2\x9a\xa1 Dash: " .. (didAirdash and "used" or "wait")
	dashLabel.TextColor3 = dashReady
		and Color3.fromRGB(255,100,200)
		or  Color3.fromRGB(120,120,120)

	if #threats==0 then
		hideAll()
		crossLabel.Text="\xe2\x9c\x96 No crossing"
		crossLabel.TextColor3=Color3.fromRGB(120,200,255)
		setStatus("\xe2\x97\x89 Safe \xe2\x80\x93 holding centre",Color3.fromRGB(80,220,160))
		if not isInAir then humanoid:MoveTo(mapCenter) end
		currentPlan=nil; hidePlan(); return
	end

	-- ---- CROSSING ----
	local crossPoint,crossA,crossB=findCrossing(threats)
	local isCrossing=crossPoint~=nil
	if isCrossing then
		crossLabel.Text=string.format("\xe2\x9c\x96 CROSS: %s+%s",crossA.laser.Name,crossB.laser.Name)
		crossLabel.TextColor3=Color3.fromRGB(0,220,255)
		crossMarker.Position=crossPoint; crossMarker.Transparency=0
	else
		crossLabel.Text="\xe2\x9c\x96 No crossing"
		crossLabel.TextColor3=Color3.fromRGB(120,200,255)
		crossMarker.Transparency=1
	end

	-- ---- PRIMARY THREAT ----
	table.sort(threats,function(a,b) return a.tti<b.tti end)
	local primary=threats[1]

	-- ---- PLANNER (re-plan on interval) ----
	if now-lastPlanTime>=PLAN_INTERVAL then
		lastPlanTime=now
		currentPlan=runPlanner(threats)
	end
	if currentPlan then
		showPlanViz(currentPlan.waypoints)
	else
		hidePlan()
	end

	-- ---- AIR-DASH ----
	if isInAir and dashReady and #threats>0 then
		-- Check if primary laser is going to intersect current arc
		local chkL={primary.laser}; local chkV={primary.velocity}
		local airSafe,_ = predictArc(chkL,chkV,realMoveDir,nil,false,0)
		if not airSafe then
			-- Laser will hit us mid-air - fire airdash
			-- Find a safe lateral direction
			local dashTarget=nil
			local fwd=realMoveDir.Magnitude>0.01 and realMoveDir or rootPart.CFrame.LookVector
			fwd=Vector3.new(fwd.X,0,fwd.Z).Unit
			local right=Vector3.new(fwd.Z,0,-fwd.X)
			for _,testDir in ipairs({fwd, right, -right, -fwd,
				(fwd+right).Unit, (fwd-right).Unit, (-fwd+right).Unit, (-fwd-right).Unit}) do
				local safe2,_ = predictArc(chkL,chkV,testDir,rootPart.Position,false,0)
				if safe2 then
					dashTarget=clampToSafe(rootPart.Position+testDir*15)
					break
				end
			end
			if dashTarget then
				print(string.format("[AIRDASH] '%s'",primary.laser.Name))
				lastAirdashTime=now; didAirdash=true
				humanoid:MoveTo(dashTarget)
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
				setStatus("\xe2\x97\x89 AIR DASH!",Color3.fromRGB(255,100,200))
			end
		end
		hideArc(); return
	end

	if isInAir then
		-- Normal in-air: keep heading to target
		if currentPlan and currentPlan.waypoints[1] then
			humanoid:MoveTo(currentPlan.waypoints[1])
		else
			local farSide=primary.laser.CFrame*Vector3.new(primary.objPos.X,0,-primary.side*15)
			humanoid:MoveTo(clampToSafe(farSide))
		end
		hideArc(); return
	end

	-- ---- ON GROUND: build jump target ----
	local jumpTarget
	local checkLasers={};  local checkVels={}

	if isCrossing then
		local toC=Vector3.new(crossPoint.X-rootPart.Position.X,0,crossPoint.Z-rootPart.Position.Z)
		if toC.Magnitude>0.01 then toC=toC.Unit end
		jumpTarget=Vector3.new(crossPoint.X+toC.X*CROSS_OVERSHOOT,crossPoint.Y,crossPoint.Z+toC.Z*CROSS_OVERSHOOT)
		table.insert(checkLasers,crossA.laser); table.insert(checkVels,crossA.velocity)
		table.insert(checkLasers,crossB.laser); table.insert(checkVels,crossB.velocity)
	elseif currentPlan and currentPlan.waypoints[1] then
		-- Use planner first waypoint
		jumpTarget=currentPlan.waypoints[1]
		table.insert(checkLasers,primary.laser); table.insert(checkVels,primary.velocity)
	else
		jumpTarget=primary.laser.CFrame*Vector3.new(primary.objPos.X,0,-primary.side*15)
		table.insert(checkLasers,primary.laser); table.insert(checkVels,primary.velocity)
	end

	local toTgt=jumpTarget-rootPart.Position
	local flatTgt=Vector3.new(toTgt.X,0,toTgt.Z)
	local predictDir=flatTgt.Magnitude>0.01 and flatTgt.Unit or realMoveDir

	-- Fast-laser early trigger: use TTI instead of distance
	local triggerNow = canJump and
		(primary.localZ<=JUMP_TRIGGER_DISTANCE or primary.tti<=FAST_TTI)

	if triggerNow then
		local safe,gap=predictArc(checkLasers,checkVels,predictDir,nil,true,0)
		if safe then
			print(string.format("[JUMP%s] '%s' lZ=%.2f TTI=%.2f gap=%.2f",
				isCrossing and "(X)" or "", primary.laser.Name, primary.localZ, primary.tti, gap or 0))
			lastJumpTime=now; jumpCount=jumpCount+1
			jumpLabel.Text=string.format("\xf0\x9f\xa6\x98 Jumps: %d",jumpCount)
			humanoid:MoveTo(clampToSafe(jumpTarget))
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			setStatus(isCrossing and "\xe2\x97\x89 CROSSING JUMP!" or "\xe2\x97\x89 Jumping!",
				Color3.fromRGB(60,220,100))
		else
			-- Stand still - let laser come, keep arc live
			predictArc(checkLasers,checkVels,predictDir,nil,true,0)
			setStatus("\xe2\x97\x89 Waiting for safe arc\xe2\x80\xa6",Color3.fromRGB(255,120,40))
		end

	elseif primary.localZ<=APPROACH_START then
		humanoid:MoveTo(clampToSafe(jumpTarget))
		setStatus("\xe2\x97\x89 Approaching",Color3.fromRGB(255,180,40))
		predictArc(checkLasers,checkVels,predictDir,nil,true,0)
	else
		humanoid:MoveTo(mapCenter)
		hideArc()
		setStatus("\xe2\x97\x89 Holding centre",Color3.fromRGB(140,180,255))
	end
end)
