        local p = Instance.new("Part")
        p.Anchored   = true; p.CanCollide=false; p.CastShadow=false
        p.Material   = Enum.Material.Neon
        p.Shape      = Enum.PartType.Cylinder
        p.Transparency = 1; p.Parent=vizRoot
        pool[i]      = p
    end
    return pool
end

