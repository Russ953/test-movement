-- LaserTracerBot v2.0.0
-- Full rewrite: teleport-based, predictive laser dodge
print("[LaserBot] v2.0.0 loaded")

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")

local lp = Players.LocalPlayer

-- =====================
-- ARENA CONSTANTS
-- =====================
local ARENA_CENTER   = Vector3.new(-178.238647, 45, 12.4262772)
local SAFE_RADIUS    = 25     -- studs from center the bot orbits
local LASER_HALF_W   = 4     -- danger half-width (laser Z=1.62 + buffer)
local LOOKAHEAD      = 0.8   -- seconds ahead to predict
local ANGLE_STEP     = 6     -- degrees between candidate slots
local MOVE_COOLDOWN  = 0.2   -- min seconds between teleports
local PROXIMITY      = 18    -- studs: proactive flee threshold

-- =====================
-- LASER FETCH
-- =====================
local function getLasers()
    local result = {}
    local root = workspace:FindFirstChild("Lasers")
    if not root then return result end
    local active = root:FindFirstChild("ActiveLasers")
    if not active then return result end
    for _, p in ipairs(active:GetChildren()) do
        if p:IsA("BasePart") then
            table.insert(result, p)
        end
    end
    return result
end

-- =====================
-- ANGULAR VELOCITY CACHE
-- =====================
local prevAngles = {}

local function getAngVel(laser)
    local id  = laser:GetDebugId()
    local lv  = laser.CFrame.LookVector
    local ang = math.atan2(lv.Z, lv.X)
    if prevAngles[id] then
        local d = ang - prevAngles[id]
        if d >  math.pi then d = d - 2*math.pi end
        if d < -math.pi then d = d + 2*math.pi end
        prevAngles[id] = ang
        return d  -- radians/frame
    end
    prevAngles[id] = ang
    return 0
end

-- =====================
-- DANGER CHECK
-- =====================
-- perpendicular distance from point (px,pz) to the laser line
-- at its predicted angle after 'ahead' seconds
local function isDangerous(px, pz, laser, ahead, angVel)
    local lv  = laser.CFrame.LookVector
    local cur = math.atan2(lv.Z, lv.X)
    local predicted = cur + angVel * 60 * ahead

    local dx   = px - laser.Position.X
    local dz   = pz - laser.Position.Z
    local dist = math.sqrt(dx*dx + dz*dz)
    if dist < 0.1 then return true end

    local pointAngle = math.atan2(dz, dx)
    local diff = pointAngle - predicted
    if diff >  math.pi then diff = diff - 2*math.pi end
    if diff < -math.pi then diff = diff + 2*math.pi end

    local perp = math.abs(math.sin(diff)) * dist
    return perp < LASER_HALF_W
end

-- =====================
-- SAFE SLOT FINDER
-- =====================
local function findSafe(lasers, angVels)
    local bestScore = -math.huge
    local bestPos   = nil

    for deg = 0, 359, ANGLE_STEP do
        local rad = math.rad(deg)
        local cx  = ARENA_CENTER.X + math.cos(rad) * SAFE_RADIUS
        local cz  = ARENA_CENTER.Z + math.sin(rad) * SAFE_RADIUS

        local safe  = true
        local score = 0

        for i, laser in ipairs(lasers) do
            local av = angVels[i]
            -- discard slot if currently in laser path
            if isDangerous(cx, cz, laser, 0, av) then
                safe = false
                break
            end
            -- penalise if predicted path hits this slot
            if isDangerous(cx, cz, laser, LOOKAHEAD, av) then
                score = score - 300
            end
            -- reward distance from laser pivot
            local dx = cx - laser.Position.X
            local dz = cz - laser.Position.Z
            score = score + math.sqrt(dx*dx + dz*dz) * 0.4
        end

        if safe then
            -- small reward for being close to center
            local dx = cx - ARENA_CENTER.X
            local dz = cz - ARENA_CENTER.Z
            score = score - math.sqrt(dx*dx + dz*dz) * 0.15

            if score > bestScore then
                bestScore = score
                bestPos   = Vector3.new(cx, ARENA_CENTER.Y, cz)
            end
        end
    end

    return bestPos
end

-- =====================
-- TELEPORT
-- =====================
local function tp(pos)
    local c = lp.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = CFrame.new(pos)
    end
end

-- =====================
-- MAIN LOOP
-- =====================
local lastMove = 0

RunService.Heartbeat:Connect(function()
    local c = lp.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local lasers = getLasers()
    if #lasers == 0 then return end

    -- sample angular velocities
    local angVels = {}
    for i, laser in ipairs(lasers) do
        angVels[i] = getAngVel(laser)
    end

    local px  = hrp.Position.X
    local pz  = hrp.Position.Z
    local now = tick()

    -- are we in danger right now or imminently?
    local danger = false
    for i, laser in ipairs(lasers) do
        if isDangerous(px, pz, laser, 0, angVels[i]) then
            danger = true; break
        end
        if isDangerous(px, pz, laser, LOOKAHEAD, angVels[i]) then
            danger = true; break
        end
        -- proximity check: laser tip approaching player
        local lv = laser.CFrame.LookVector
        local tipX = laser.Position.X + lv.X * PROXIMITY
        local tipZ = laser.Position.Z + lv.Z * PROXIMITY
        local dx = px - tipX
        local dz = pz - tipZ
        if math.sqrt(dx*dx + dz*dz) < PROXIMITY * 0.5 then
            danger = true; break
        end
    end

    if danger or (now - lastMove) > MOVE_COOLDOWN then
        local safe = findSafe(lasers, angVels)
        if safe then
            tp(safe)
            lastMove = now
        end
    end
end)

print("[LaserBot] v2.0.0 running")
