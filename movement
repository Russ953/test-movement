local lastLaserSide    = setmetatable({}, {__mode = "k"})
local laserPassedFlag  = setmetatable({}, {__mode = "k"})
local lastJumpTime     = 0
local jumpCount        = 0
local runStart         = tick()
local lastRootPos      = nil

local lastDebugPrint = 0
local DEBUG_INTERVAL = 0.3

