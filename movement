-- LaserTracerBot v4.1.0
-- Laser pivots from ARENA CENTER (confirmed from screenshot)
-- Thin red beam, no teleporting, pure smooth tween movement
print("[LaserBot] v4.1.0 loaded")

local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local lp           = Players.LocalPlayer

-- =====================
-- TUNING
-- =====================
local ARENA_CENTER = Vector3.new(-178.238647, 45, 12.4262772)
local ORBIT_RADIUS = 18       -- orbit ring radius (stay away from center & walls)
local LASER_HALF_W = 3.5      -- thin red beam, half-width in studs
local LOOKAHEAD    = 1.0      -- seconds to predict ahead
local ANGLE_STEP   = 6        -- degrees between candidate orbit slots
local PROX_ANGLE   = 25       -- degrees: start moving when laser is this close
local TWEEN_TIME   = 0.25     -- seconds per step (feels human, not instant)
local STEP_SIZE    = 5        -- studs per path waypoint
local VIS_ENABLED  = true     -- debug visuals toggle

-- =====================
-- LASER FETCH
-- =====================
local function getLasers()
    local out = {}
    local root = workspace:FindFirstChild("Lasers")
    if not root then
        -- fallback: scan whole workspace for rotating parts named like lasers
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and (v.Name:lower():find("laser") or v.Name:lower():find("beam")) then
                table.insert(out, v)
            end
        end
        return out
    end
    local active = root:FindFirstChild("ActiveLasers")
    if not active then return out end
    for _, p in ipairs(active:GetChildren()) do
        if p:IsA("BasePart") then table.insert(out, p) end
    end
    return out
end

-- =====================
-- ANGULAR VELOCITY (radians per heartbeat frame)
-- =====================
local prevAng = {}
local function getAngVel(laser)
    local id  = laser:GetDebugId()
    local lv  = laser.CFrame.LookVector
    local ang = math.atan2(lv.Z, lv.X)
    if prevAng[id] then
        local d = ang - prevAng[id]
        if d >  math.pi then d = d - 2*math.pi end
        if d < -math.pi then d = d + 2*math.pi end
        prevAng[id] = ang
        return d
    end
    prevAng[id] = ang
    return 0
end

-- =====================
-- DANGER CHECK
-- Laser pivots from ARENA CENTER (confirmed from screenshot).
-- The beam is a thin line radiating outward.
-- We use perpendicular distance from the point to the predicted beam line.
-- =====================
local function isDangerous(px, pz, laser, ahead, av)
    local lv   = laser.CFrame.LookVector
    local cur  = math.atan2(lv.Z, lv.X)
    local pred = cur + av * 60 * ahead

    -- pivot is arena center, NOT laser.Position
    local ox = ARENA_CENTER.X
    local oz = ARENA_CENTER.Z
    local dx = px - ox
    local dz = pz - oz

    local lineX =  math.cos(pred)
    local lineZ =  math.sin(pred)
    local perpX = -lineZ
    local perpZ =  lineX

    local perp = math.abs(dx * perpX + dz * perpZ)
    -- check both directions the beam extends (it goes both ways from center)
    return perp < LASER_HALF_W
end

-- also check the OPPOSITE direction (beam extends both ways from center)
local function isDangerousFull(px, pz, laser, ahead, av)
    return isDangerous(px, pz, laser, ahead, av)
        or isDangerous(px, pz, laser, ahead, av + math.pi)
end

local function anyDanger(px, pz, lasers, avs, ahead)
    for i, l in ipairs(lasers) do
        if isDangerousFull(px, pz, l, ahead, avs[i]) then return true end
    end
    return false
end

-- =====================
-- ANGULAR PROXIMITY CHECK
-- Returns true if the laser will pass through the player's angle within PROX_ANGLE degrees
-- =====================
local function isApproaching(px, pz, laser, av)
    local lv  = laser.CFrame.LookVector
    local cur = math.atan2(lv.Z, lv.X)
    -- angle from center to player
    local dx  = px - ARENA_CENTER.X
    local dz  = pz - ARENA_CENTER.Z
    local playerAngle = math.atan2(dz, dx)

    -- angular distance (both beam directions)
    local function angDiff(a, b)
        local d = a - b
        if d >  math.pi then d = d - 2*math.pi end
        if d < -math.pi then d = d + 2*math.pi end
        return math.abs(d)
    end

    local diff1 = angDiff(playerAngle, cur)
    local diff2 = angDiff(playerAngle, cur + math.pi)
    local closest = math.min(diff1, diff2)

    -- if spinning toward us (av and diff have same sign), trigger early
    local prox = math.rad(PROX_ANGLE)
    if closest < prox then
        -- predict if it will reach us within LOOKAHEAD seconds
        local future = closest / (math.abs(av) * 60 + 0.001)
        return future < LOOKAHEAD
    end
    return false
end

local function anyApproaching(px, pz, lasers, avs)
    for i, l in ipairs(lasers) do
        if isApproaching(px, pz, l, avs[i]) then return true end
    end
    return false
end

-- =====================
-- SAFE SLOT FINDER
-- Searches orbit ring for the best angle gap between lasers.
-- Scores based on: angular gap from nearest laser, not predicted danger.
-- =====================
local function findSafe(lasers, avs)
    local best, bestPos = -math.huge, nil

    for deg = 0, 359, ANGLE_STEP do
        local rad = math.rad(deg)
        local cx  = ARENA_CENTER.X + math.cos(rad) * ORBIT_RADIUS
        local cz  = ARENA_CENTER.Z + math.sin(rad) * ORBIT_RADIUS

        if not anyDanger(cx, cz, lasers, avs, 0) then
            local score = 0

            -- penalise if predicted danger
            if anyDanger(cx, cz, lasers, avs, LOOKAHEAD) then
                score = score - 400
            end

            -- reward angular gap: how far (in angle) is the nearest beam?
            for i, l in ipairs(lasers) do
                local lv  = l.CFrame.LookVector
                local cur = math.atan2(lv.Z, lv.X)
                local dx  = cx - ARENA_CENTER.X
                local dz  = cz - ARENA_CENTER.Z
                local pa  = math.atan2(dz, dx)
                local d1  = math.abs(pa - cur)
                local d2  = math.abs(pa - cur - math.pi)
                local d3  = math.abs(pa - cur + math.pi)
                local gap = math.min(d1, d2, d3)
                if gap > math.pi then gap = 2*math.pi - gap end
                score = score + gap * 30  -- bigger gap = safer
            end

            if score > best then
                best    = score
                bestPos = Vector3.new(cx, ARENA_CENTER.Y, cz)
            end
        end
    end

    return bestPos
end

-- =====================
-- PATHFINDING
-- Smooth intermediate waypoints. Checks each for safety.
-- =====================
local function buildPath(startPos, goalPos, lasers, avs)
    local path  = {}
    local dx    = goalPos.X - startPos.X
    local dz    = goalPos.Z - startPos.Z
    local dist  = math.sqrt(dx*dx + dz*dz)

    if dist < STEP_SIZE then
        table.insert(path, goalPos)
        return path
    end

    local steps = math.ceil(dist / STEP_SIZE)
    for i = 1, steps do
        local t  = i / steps
        local px = startPos.X + dx * t
        local pz = startPos.Z + dz * t
        -- arc along orbit ring instead of straight line (more natural)
        local ang = math.atan2(pz - ARENA_CENTER.Z, px - ARENA_CENTER.X)
        local wx  = ARENA_CENTER.X + math.cos(ang) * ORBIT_RADIUS
        local wz  = ARENA_CENTER.Z + math.sin(ang) * ORBIT_RADIUS
        if anyDanger(wx, wz, lasers, avs, 0) then
            -- arc is blocked, go straight
            table.insert(path, goalPos)
            return path
        end
        table.insert(path, Vector3.new(wx, ARENA_CENTER.Y, wz))
    end
    return path
end

-- =====================
-- VISUALISATION
-- Green dot  = safe target
-- Yellow dots = path waypoints
-- Red lines  = predicted laser beams
-- =====================
local visFolder = Instance.new("Folder")
visFolder.Name   = "LaserBotVis"
visFolder.Parent = workspace

local function makePart(name, color, size)
    local p = Instance.new("Part")
    p.Name = name; p.Anchored = true; p.CanCollide = false
    p.CastShadow = false; p.Size = size or Vector3.new(1, 0.2, 1)
    p.Color = color; p.Material = Enum.Material.Neon
    p.Transparency = 0.5; p.Parent = visFolder
    return p
end

local targetDot  = makePart("TargetDot", Color3.fromRGB(0, 255, 80), Vector3.new(2.5, 0.4, 2.5))
local pathParts  = {}
local beamLines  = {}

local function updateVis(safePt, path, lasers, avs)
    if not VIS_ENABLED then return end

    if safePt then
        targetDot.CFrame       = CFrame.new(safePt + Vector3.new(0, 0.3, 0))
        targetDot.Transparency = 0.15
    else
        targetDot.Transparency = 1
    end

    for _, p in ipairs(pathParts) do p:Destroy() end; pathParts = {}
    if path then
        for i, pt in ipairs(path) do
            local d = makePart("P"..i, Color3.fromRGB(255, 220, 0), Vector3.new(0.8, 0.3, 0.8))
            d.CFrame = CFrame.new(pt + Vector3.new(0, 0.25, 0)); d.Transparency = 0.3
            table.insert(pathParts, d)
        end
    end

    for _, p in ipairs(beamLines) do p:Destroy() end; beamLines = {}
    if lasers then
        for i, laser in ipairs(lasers) do
            local lv   = laser.CFrame.LookVector
            local av   = avs and avs[i] or 0
            local pred = math.atan2(lv.Z, lv.X) + av * 60 * LOOKAHEAD
            local len  = ORBIT_RADIUS * 2 + 4
            -- beam extends BOTH ways from center
            local dirX = math.cos(pred)
            local dirZ = math.sin(pred)
            local from = ARENA_CENTER - Vector3.new(dirX, 0, dirZ) * (len/2)
            local to   = ARENA_CENTER + Vector3.new(dirX, 0, dirZ) * (len/2)
            local mid  = (from + to) / 2
            local b = makePart("Beam"..i, Color3.fromRGB(255, 50, 50),
                Vector3.new(LASER_HALF_W * 2, 0.3, len))
            b.CFrame = CFrame.new(mid, to); b.Transparency = 0.35
            table.insert(beamLines, b)
        end
    end
end

-- =====================
-- SMOOTH TWEEN WALK — NO TELEPORTING
-- Uses Humanoid:MoveTo for each waypoint so walk animations play.
-- Falls back to TweenService only if stuck.
-- =====================
local moving    = false
local cancelMove = false

local function walkPath(path)
    if moving then return end
    moving     = true
    cancelMove = false

    local c = lp.Character
    if not c then moving = false; return end
    local hum = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then moving = false; return end

    for _, pt in ipairs(path) do
        if cancelMove then break end
        c = lp.Character; if not c then break end
        hum = c:FindFirstChildOfClass("Humanoid")
        hrp = c:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp then break end

        -- use Humanoid:MoveTo so the walk animation plays naturally
        hum:MoveTo(pt)

        -- wait until close enough OR timeout (don't wait forever)
        local deadline = tick() + TWEEN_TIME * 3
        repeat
            RunService.Heartbeat:Wait()
            c   = lp.Character
            hrp = c and c:FindFirstChild("HumanoidRootPart")
        until cancelMove
            or tick() > deadline
            or (hrp and (hrp.Position - pt).Magnitude < 1.5)
    end

    if hum then hum:MoveTo(hrp and hrp.Position or ARENA_CENTER) end
    moving = false
end

-- abort current walk (called when urgent re-path needed)
local function abortWalk()
    cancelMove = true
    moving     = false
    -- small yield so the walk coroutine can exit cleanly
    task.wait(0.05)
end

-- =====================
-- MAIN LOOP
-- =====================
local lastCheck  = 0
local lastSafe   = nil   -- cache last known safe position

RunService.Heartbeat:Connect(function()
    local c = lp.Character; if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local lasers = getLasers()
    if #lasers == 0 then return end

    local avs = {}
    for i, l in ipairs(lasers) do avs[i] = getAngVel(l) end

    local px  = hrp.Position.X
    local pz  = hrp.Position.Z
    local now = tick()

    -- CRITICAL DANGER: laser is on player RIGHT NOW — abort walk, re-path urgently
    -- But NEVER teleport — just redirect the walk
    if anyDanger(px, pz, lasers, avs, 0) then
        if moving then abortWalk() end
        local safe = findSafe(lasers, avs)
        if safe then
            lastSafe = safe
            updateVis(safe, nil, lasers, avs)
            task.spawn(walkPath, {safe})
        end
        return
    end

    -- throttle proactive checks to every 0.15s
    if (now - lastCheck) < 0.15 then return end
    lastCheck = now

    local shouldMove = anyDanger(px, pz, lasers, avs, LOOKAHEAD)
                    or anyApproaching(px, pz, lasers, avs)

    updateVis(nil, nil, lasers, avs)

    if shouldMove then
        local safe = findSafe(lasers, avs)
        if safe then
            lastSafe = safe
            -- only abort and re-path if the new target is significantly different
            local shouldReplan = not moving
            if moving and lastSafe then
                local dd = (safe - lastSafe).Magnitude
                if dd > 6 then shouldReplan = true end
            end
            if shouldReplan then
                if moving then abortWalk() end
                local path = buildPath(hrp.Position, safe, lasers, avs)
                updateVis(safe, path, lasers, avs)
                task.spawn(walkPath, path)
            end
        end
    end
end)

print("[LaserBot] v4.1.0 running — no teleport, human movement")
