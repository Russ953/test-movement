-- ==========================================
-- ARENA CHECK
-- ==========================================
local function checkOnArena()
	local pos    = rootPart.Position
	local flat   = Vector3.new(pos.X - mapCenter.X, 0, pos.Z - mapCenter.Z)
	local inXZ   = flat.Magnitude <= ARENA_XZ_RADIUS
	local inY    = pos.Y >= ARENA_TOP - 1 and pos.Y <= ARENA_TOP + ARENA_Y_MARGIN
	return inXZ and inY
end

-- ==========================================
-- ANGULAR VELOCITY HELPER
-- Returns the world-space tip velocity of a rotating laser.
-- For a laser that pivots around its own centre, the dangerous
-- endpoint sweeps perpendicular to the laser's look vector.
-- ==========================================
local function getLaserTipVelocity(item, oldCF, dt)
	if not oldCF then return Vector3.zero end

	-- Translation component
	local transVel = (item.Position - oldCF.Position) / dt

	-- Rotation: compare old and new look vectors to get angular sweep
	local oldFwd = Vector3.new(oldCF.LookVector.X, 0, oldCF.LookVector.Z)
	local newFwd = Vector3.new(item.CFrame.LookVector.X, 0, item.CFrame.LookVector.Z)

	if oldFwd.Magnitude < 0.01 or newFwd.Magnitude < 0.01 then
		return transVel
	end

	-- cross.Y gives signed rotation rate (rad/frame)
	local cross    = oldFwd:Cross(newFwd)
	local angSpeed = cross.Y / dt   -- approx rad/s (small angle)

	-- Tip velocity direction = perpendicular to look vector, scaled by
	-- half-length and angular speed
	local halfLen  = item.Size.Z / 2
	local perpDir  = Vector3.new(newFwd.Z, 0, -newFwd.X) * math.sign(angSpeed + 1e-9)
	local rotVel   = perpDir * math.abs(angSpeed) * halfLen

	return transVel + rotVel
end

-- ==========================================
-- TRAJECTORY PREDICTION
-- Returns: isSafe (bool), minClearance (number)
-- minClearance = smallest gap between arc and laser bounding box
-- Negative means collision.
-- ==========================================
local function predictTrajectory(laser, laserVelocity, checkLanding)
	if not laser then return false, -1 end

	local g         = workspace.Gravity
	local jumpPower = humanoid.UseJumpPower
		and humanoid.JumpPower
		or  math.sqrt(2 * g * humanoid.JumpHeight)
	local walkSpeed = humanoid.WalkSpeed

	local moveDir = humanoid.MoveDirection
	if moveDir.Magnitude == 0 then moveDir = rootPart.CFrame.LookVector end

	local timeInAir  = (2 * jumpPower) / g
	local steps      = VIZ_STEPS
	local timeStep   = timeInAir / steps
	local startPos   = rootPart.Position
	local isSafe     = true
	local minGap     = math.huge  -- minimum clearance found across all steps

	for i = 1, steps do
		local t  = i * timeStep
		local pX = startPos.X + moveDir.X * walkSpeed * t
		local pZ = startPos.Z + moveDir.Z * walkSpeed * t
		local pY = startPos.Y + jumpPower * t - 0.5 * g * t * t
		local tp = Vector3.new(pX, pY, pZ)

		local futureLaserPos = laser.Position + laserVelocity * t
		local futureCF       = laser.CFrame - laser.Position + futureLaserPos
		local lp             = futureCF:PointToObjectSpace(tp)

		local bX = laser.Size.X / 2 + 1.2
		local bY = laser.Size.Y / 2 + 2.6
		local bZ = laser.Size.Z / 2 + 1.2

		-- Clearance: how much room we have inside the bounding box
		-- Positive = outside (safe), negative = inside (collision)
		local gapX = bX - math.abs(lp.X)
		local gapY = bY - math.abs(lp.Y)
		local gapZ = bZ - math.abs(lp.Z)
		local gapAll = math.min(gapX, gapY, gapZ)  -- positive = inside box

		if gapX > 0 and gapY > 0 and gapZ > 0 then
			isSafe   = false
			minGap   = math.min(minGap, gapAll)  -- how deep inside box we are
		end

		-- Track tightest near-miss for orange warning
		if gapAll < 0 then  -- outside the box
			minGap = math.min(minGap, -gapAll)  -- store as positive "gap to wall"
		end

		vizParts[i].Position    = tp
		vizParts[i].Transparency = 0
	end

	-- ── Landing zone check ───────────────────────────────────────────────────
	-- Even if the arc clears the laser, check that the landing spot won't
	-- put the player on top of where the laser will be at that moment.
	if checkLanding and isSafe then
		local landT       = timeInAir   -- land at t = full air time
		local landX       = startPos.X + moveDir.X * walkSpeed * landT
		local landZ       = startPos.Z + moveDir.Z * walkSpeed * landT
		local landPos     = Vector3.new(landX, startPos.Y, landZ)  -- approx ground level

		local futureLaserPos = laser.Position + laserVelocity * landT
		local futureCF       = laser.CFrame - laser.Position + futureLaserPos
		local lp             = futureCF:PointToObjectSpace(landPos)

		local bX = laser.Size.X / 2 + 1.4
		local bZ = laser.Size.Z / 2 + 1.4
		if math.abs(lp.X) < bX and math.abs(lp.Z) < bZ then
			-- Landing zone will be occupied by the laser
			isSafe = false
			print(string.format("[LAND-UNSAFE] laser='%s' would be at landing zone at t=%.2fs",
				laser.Name, landT))
		end
	end

	-- Arc colour: green=safe, orange=tight, red=unsafe
	local col
	if not isSafe then
		col = Color3.fromRGB(255, 50, 50)      -- red
	elseif minGap < TIGHT_CLEARANCE then
		col = Color3.fromRGB(255, 160, 30)     -- orange
	else
		col = Color3.fromRGB(60, 220, 100)     -- green
	end
	for i = 1, steps do vizParts[i].Color = col end

	return isSafe, minGap
end

-- ==========================================
-- HELPERS
-- ==========================================
local function clampToSafeZone(pos)
	local off  = pos - mapCenter
	local flat = Vector3.new(off.X, 0, off.Z)
	if flat.Magnitude > safeRadius then
		local c = flat.Unit * safeRadius
		return Vector3.new(mapCenter.X + c.X, pos.Y, mapCenter.Z + c.Z)
	end
	return pos
end

-- Time-to-impact: rough estimate of how many seconds until the laser
-- reaches the player at its current velocity. Lower = more urgent.
local function timeToImpact(localZ, laserSpeed)
	if laserSpeed < 0.1 then return localZ / 1  end  -- stationary: use distance as proxy
	return localZ / laserSpeed
end

-- ==========================================
-- LASER SELECTION (lowest TTI)
-- ==========================================
local function getBestLaser(dt, now)
	local bestLaser     = nil
	local bestTTI       = math.huge
	local bestTargetPos = nil
	local bestVelocity  = Vector3.zero
	local bestLocalZ    = math.huge

	local playerPos   = rootPart.Position
	local shouldPrint = (now - lastDebugPrint) >= DEBUG_INTERVAL

	for _, item in ipairs(lasersFolder:GetChildren()) do
		if not item:IsA("BasePart") then continue end
		item.CanCollide = false

		local objPos      = item.CFrame:PointToObjectSpace(playerPos)
		local localZ      = math.abs(objPos.Z)
		local currentSide = math.sign(objPos.Z)
		if currentSide == 0 then currentSide = 1 end

		local worldDist = (item.Position - playerPos).Magnitude

		local oldCF = lastLaserCFrames[item]
		lastLaserCFrames[item] = item.CFrame

		-- Full tip velocity (translation + angular sweep)
		local tipVel = getLaserTipVelocity(item, oldCF, dt)
		local speed  = tipVel.Magnitude

		-- ── RESET ──────────────────────────────────────────────────────────
		if worldDist > RESET_WORLD_DIST then
			if laserPassedFlag[item] then
				print(string.format("[RESET] '%s' worldDist=%.1f", item.Name, worldDist))
			end
			laserPassedFlag[item] = false
			lastLaserSide[item]   = nil
			continue
		end

		-- ── PASSED DETECTION ───────────────────────────────────────────────
		if not laserPassedFlag[item] then
			if speed > LASER_MOVE_THRESHOLD then
				local toPlayer = Vector3.new(
					playerPos.X - item.Position.X, 0,
					playerPos.Z - item.Position.Z)
				local flatVel = Vector3.new(tipVel.X, 0, tipVel.Z)
				local dot = toPlayer.Magnitude > 0.01
					and flatVel:Dot(toPlayer.Unit) or 0

				if dot < -0.3 and localZ < PASS_CONFIRM_DIST then
					laserPassedFlag[item] = true
					print(string.format("[PASSED-VEL] '%s' dot=%.2f localZ=%.1f",
						item.Name, dot, localZ))
				end

				local prevSide = lastLaserSide[item]
				if prevSide and prevSide ~= currentSide then
					laserPassedFlag[item] = true
					print(string.format("[PASSED-FLIP] '%s' %d->%d localZ=%.1f",
						item.Name, prevSide, currentSide, localZ))
				end
			end
		end

		lastLaserSide[item] = currentSide

		if laserPassedFlag[item] then continue end
		if localZ > AGGRO_DISTANCE then continue end

		local tti = timeToImpact(localZ, speed)

		if shouldPrint then
			print(string.format("[DBG] '%s' localZ=%.1f TTI=%.2f spd=%.1f",
				item.Name, localZ, tti, speed))
		end

		if tti < bestTTI then
			bestTTI       = tti
			bestLaser     = item
			bestVelocity  = tipVel
			bestLocalZ    = localZ
			-- Walk to far side of laser
			bestTargetPos = item.CFrame * Vector3.new(objPos.X, 0, -currentSide * 15)
		end
	end

	if shouldPrint then lastDebugPrint = now end
	return bestLaser, bestTargetPos, bestLocalZ, bestVelocity
end

-- ==========================================
-- STRAFE TARGET
-- Instead of charging straight through, walk parallel to the laser
-- face (sideways) while waiting for a clean arc.
-- ==========================================
local function getStrafeTarget(laser)
	local objPos  = laser.CFrame:PointToObjectSpace(rootPart.Position)
	-- RightVector of the laser in world space
	local rightWS = laser.CFrame.RightVector
	-- Strafe toward whichever side keeps us closer to map centre
	local optA    = rootPart.Position + rightWS  * STRAFE_OFFSET
	local optB    = rootPart.Position - rightWS  * STRAFE_OFFSET
	local distA   = (optA - mapCenter).Magnitude
	local distB   = (optB - mapCenter).Magnitude
	return distA < distB and optA or optB
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
	if not character or humanoid.Health <= 0 then
		hideVisualizer()
		setStatus("● Dead", Color3.fromRGB(255,80,80))
		return
	end

	local now = tick()

	-- ── Arena check ────────────────────────────────────────────────────────
	isOnArena = checkOnArena()
	if not isOnArena then
		hideVisualizer()
		setStatus("● Off arena – idle", Color3.fromRGB(180,180,180))
		-- Update timer but don't move
		timerLabel.Text = string.format("⏱  %.1fs", now - runStart)
		return
	end

	-- ── HUD update ─────────────────────────────────────────────────────────
	timerLabel.Text = string.format("⏱  %.1fs", now - runStart)
	jumpLabel.Text  = string.format("🦘 Jumps: %d", jumpCount)

	local laser, targetPos, dist, laserVelocity = getBestLaser(dt, now)
	local state   = humanoid:GetState()
	local isInAir = state == Enum.HumanoidStateType.Freefall
	             or state == Enum.HumanoidStateType.Jumping
	local canJump = (now - lastJumpTime) >= JUMP_COOLDOWN

	if laser and targetPos then
		setStatus("● Reacting to laser", Color3.fromRGB(255, 160, 40))

		-- ── Jump gate: only jump if walking TOWARD the laser ───────────────
		local towardLaser = false
		if humanoid.MoveDirection.Magnitude > 0.1 then
			local toLaser = (laser.Position - rootPart.Position)
			local flat    = Vector3.new(toLaser.X, 0, toLaser.Z)
			if flat.Magnitude > 0.01 then
				towardLaser = humanoid.MoveDirection:Dot(flat.Unit) > 0.2
			end
		end

		if not isInAir then
			if canJump and dist <= JUMP_TRIGGER_DISTANCE + 5 and towardLaser then
				local safe, gap = predictTrajectory(laser, laserVelocity, true)

				if dist <= JUMP_TRIGGER_DISTANCE and safe then
					-- Jump!
					print(string.format("[JUMP] '%s' dist=%.1f gap=%.2f",
						laser.Name, dist, gap or 0))
					lastJumpTime = now
					jumpCount    = jumpCount + 1
					jumpLabel.Text = string.format("🦘 Jumps: %d", jumpCount)
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
					humanoid:MoveTo(clampToSafeZone(targetPos))
				else
					-- Arc is unsafe: strafe sideways to wait for a clear window
					local strafeTarget = getStrafeTarget(laser)
					humanoid:MoveTo(clampToSafeZone(strafeTarget))
					setStatus("● Strafing (unsafe arc)", Color3.fromRGB(255,120,30))
				end
			else
				-- Not yet in jump range or not facing laser: walk to far side
				humanoid:MoveTo(clampToSafeZone(targetPos))
			end
		else
			-- In air: just keep moving toward target
			humanoid:MoveTo(clampToSafeZone(targetPos))
			hideVisualizer()
		end
	else
		hideVisualizer()
		setStatus("● Safe – holding centre", Color3.fromRGB(80, 220, 160))
		if not isInAir then humanoid:MoveTo(mapCenter) end
	end
end)
