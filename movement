    box.Adornee      = laser
    box.Color3       = COL_SAFE
    box.LineThickness = 0.06
    box.SurfaceTransparency = 0.85
    box.SurfaceColor3 = COL_SAFE
    box.Parent       = vizRoot

    -- BillboardGui for TTI label
    local bb = Instance.new("BillboardGui")
    bb.Adornee        = laser
    bb.Size           = UDim2.new(0, 120, 0, 54)
    bb.StudsOffset    = Vector3.new(0, laser.Size.Y/2 + 3.5, 0)
    bb.AlwaysOnTop    = true
    bb.MaxDistance    = 120
    bb.ResetOnSpawn   = false
    bb.Parent         = vizRoot

    local bg = Instance.new("Frame", bb)
    bg.Size = UDim2.new(1,0,1,0)
    bg.BackgroundColor3 = Color3.fromRGB(0,0,0)
    bg.BackgroundTransparency = 0.35
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0,5)

    local nameLbl = Instance.new("TextLabel", bg)
    nameLbl.Size = UDim2.new(1,-4,0,18)
    nameLbl.Position = UDim2.new(0,2,0,2)
    nameLbl.BackgroundTransparency = 1
    nameLbl.TextColor3 = COL_SAFE
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 11
    nameLbl.Text = laser.Name
    nameLbl.TextXAlignment = Enum.TextXAlignment.Center

    local ttiLbl = Instance.new("TextLabel", bg)
    ttiLbl.Size = UDim2.new(1,-4,0,16)
    ttiLbl.Position = UDim2.new(0,2,0,20)
    ttiLbl.BackgroundTransparency = 1
    ttiLbl.TextColor3 = COL_SAFE
    ttiLbl.Font = Enum.Font.Gotham
    ttiLbl.TextSize = 13
    ttiLbl.Text = "TTI: -"
    ttiLbl.TextXAlignment = Enum.TextXAlignment.Center

    local distLbl = Instance.new("TextLabel", bg)
    distLbl.Size = UDim2.new(1,-4,0,14)
    distLbl.Position = UDim2.new(0,2,0,36)
    distLbl.BackgroundTransparency = 1
    distLbl.TextColor3 = Color3.fromRGB(180,255,200)
    distLbl.Font = Enum.Font.Gotham
    distLbl.TextSize = 11
    distLbl.Text = "dist: -"
    distLbl.TextXAlignment = Enum.TextXAlignment.Center

    local v = {box=box, billboard=bb, nameLbl=nameLbl, ttiLbl=ttiLbl, distLbl=distLbl}
    laserVizCache[laser] = v
    return v
end

local function updateLaserViz(laser, tti, dist, isPassed)
    local v = getOrCreateViz(laser)
    local col
    if isPassed then
        col = COL_PASSED
        v.ttiLbl.Text = "PASSED"
        v.distLbl.Text = string.format("dist %.1f", dist)
    elseif tti < TTI_DANGER then
        col = COL_DANGER
        v.ttiLbl.Text = string.format("TTI %.2fs !", tti)
        v.distLbl.Text = string.format("dist %.1f", dist)
    elseif tti < TTI_WARN then
        col = COL_WARN
        v.ttiLbl.Text = string.format("TTI %.2fs", tti)
        v.distLbl.Text = string.format("dist %.1f", dist)
    else
        col = COL_SAFE
        v.ttiLbl.Text = string.format("TTI %.1fs", tti)
        v.distLbl.Text = string.format("dist %.1f", dist)
    end
    v.box.Color3          = col
    v.box.SurfaceColor3   = col
    v.nameLbl.TextColor3  = col
    v.ttiLbl.TextColor3   = col

    -- StudsOffset tracks laser height live
    v.billboard.StudsOffset = Vector3.new(0, laser.Size.Y/2 + 3.5, 0)
end

local function hideAllViz()
    for laser, v in pairs(laserVizCache) do
        if not laser or not laser.Parent then
            v.box:Destroy(); v.billboard:Destroy()
            laserVizCache[laser]=nil
        end
    end
end

