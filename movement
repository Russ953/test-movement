local function drawConn(part, a, b, color, alpha)
    local diff = b - a
    local len  = diff.Magnitude
    if len < 0.05 then part.Transparency=1; return end
    part.Size        = Vector3.new(0.12, 0.12, len)
    part.CFrame      = CFrame.lookAt((a+b)*0.5, b)
    part.Color       = color
    part.Transparency = alpha or 0.45
end

