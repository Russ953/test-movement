local function smartMoveTo(pos)
    if lastMoveTarget then
        local dx = pos.X - lastMoveTarget.X
        local dz = pos.Z - lastMoveTarget.Z
        if dx*dx + dz*dz < MOVE_RETARGET_DIST*MOVE_RETARGET_DIST then return end
    end
    lastMoveTarget = pos
    humanoid:MoveTo(pos)
end

local function clearMoveTarget()
    lastMoveTarget = nil
end

