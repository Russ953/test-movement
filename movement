local function drawArc(startPos, dir, safe)
    local g  = workspace.Gravity
    local jp = hum.UseJumpPower and hum.JumpPower or math.sqrt(2*g*hum.JumpHeight)
    local ws = hum.WalkSpeed
    local tAir = (2*jp)/g
    local ts   = tAir/ARC_DOTS
    local col  = safe and Color3.fromRGB(60,220,100) or Color3.fromRGB(255,60,60)
    for i=1,ARC_DOTS do
        local t   = i*ts
        local pos = Vector3.new(
            startPos.X + dir.X*ws*t,
            startPos.Y + jp*t - 0.5*g*t*t,
            startPos.Z + dir.Z*ws*t
        )
        arcDotPool[i].Position=pos; arcDotPool[i].Color=col
        arcDotPool[i].Transparency=0.15
    end
    -- landing sphere
    local lp = Vector3.new(startPos.X+dir.X*ws*tAir, FLOOR_Y+0.5, startPos.Z+dir.Z*ws*tAir)
    landDot.Position=lp; landDot.Transparency=0.15
    landDot.Color=safe and Color3.fromRGB(255,220,30) or Color3.fromRGB(255,60,60)
end

local function hideArc()
    for _,p in ipairs(arcDotPool) do p.Transparency=1 end
    landDot.Transparency=1
end

-- ==========================================
-- PHYSICS HELPERS
-- ==========================================
local function getJump()
    local g  = workspace.Gravity
    local jp = hum.UseJumpPower and hum.JumpPower or math.sqrt(2*g*hum.JumpHeight)
    return jp, (2*jp)/g, g, hum.WalkSpeed
end

local function clamp(pos)
    local dx=pos.X-MAP_X; local dz=pos.Z-MAP_Z
    local m=math.sqrt(dx*dx+dz*dz)
    if m>ARENA_R then
        local s=ARENA_R/m
        return Vector3.new(MAP_X+dx*s, pos.Y, MAP_Z+dz*s)
    end
    return pos
end

local function futureCF(laser, vel, av, t)
    local fp  = laser.Position + vel*t
    local ba  = math.atan2(laser.CFrame.LookVector.X, laser.CFrame.LookVector.Z)
    return CFrame.new(fp) * CFrame.Angles(0, ba+av*t, 0)
end

local function getLaserMotion(laser, oldCF, dt)
    if not oldCF or dt<0.001 then return Vector3.zero,0 end
    local tv  = (laser.Position - oldCF.Position)/dt
    local of  = Vector3.new(oldCF.LookVector.X,0,oldCF.LookVector.Z)
    local nf  = Vector3.new(laser.CFrame.LookVector.X,0,laser.CFrame.LookVector.Z)
    local av  = 0
    if of.Magnitude>0.01 and nf.Magnitude>0.01 then
        av = of:Cross(nf).Y / dt
    end
    local hL  = laser.Size.Z/2
    local pd  = Vector3.new(nf.Z,0,-nf.X)*math.sign(av+1e-9)
    return tv + pd*math.abs(av)*hL, av
end

-- ==========================================
-- ARC SAFETY CHECK
-- ==========================================
-- Returns (safe:bool, minGap:number)
-- Checks ALL lasers in the threats list
local function arcSafe(threats, dir, startPos, timeOffset)
    if #threats==0 then return true, 999 end
    local jp, tAir, g, ws = getJump()
    timeOffset = timeOffset or 0
    local sp  = startPos or root.Position
    local safe= true
    local mg  = math.huge

    local md = Vector3.new(dir.X,0,dir.Z)
    if md.Magnitude>0.01 then md=md.Unit else return false,0 end

    local ts = tAir/ARC_DOTS
    for i=1,ARC_DOTS do
        local t  = i*ts
        local tp = Vector3.new(
            sp.X + md.X*ws*t,
            sp.Y + jp*t - 0.5*g*t*t,
            sp.Z + md.Z*ws*t
        )
        for _,th in ipairs(threats) do
            local fcf = futureCF(th.laser, th.vel, th.av, t+timeOffset)
            local lp  = fcf:PointToObjectSpace(tp)
            local bX  = th.laser.Size.X/2+PAD_X
            local bY  = th.laser.Size.Y/2+PAD_Y
            local bZ  = th.laser.Size.Z/2+PAD_Z
            if math.abs(lp.X)<bX and math.abs(lp.Y)<bY and math.abs(lp.Z)<bZ then
                safe=false
            end
            local g2 = math.min(
                bX - math.abs(lp.X),
                bY - math.abs(lp.Y),
                bZ - math.abs(lp.Z)
            )
            mg = math.min(mg, math.abs(g2))
        end
    end

    -- Also check landing spot
    if safe then
        local lp = clamp(Vector3.new(sp.X+md.X*ws*tAir, FLOOR_Y+0.5, sp.Z+md.Z*ws*tAir))
        for _,th in ipairs(threats) do
            local fcf = futureCF(th.laser, th.vel, th.av, tAir+timeOffset)
            local op  = fcf:PointToObjectSpace(lp)
            if math.abs(op.X)<th.laser.Size.X/2+PAD_X
            and math.abs(op.Z)<th.laser.Size.Z/2+PAD_Z then
                safe=false
            end
        end
    end

    return safe, mg
end

-- ==========================================
-- COLLECT THREATS
-- ==========================================
local function collectThreats(dt)
    local out = {}
    local pp  = root.Position

    for _,item in ipairs(lasersFolder:GetChildren()) do
        if not item:IsA("BasePart") then continue end
        item.CanCollide=false

        local wd = (item.Position-pp).Magnitude
        if wd>WORLD_RESET then passed[item]=false; lastSide[item]=nil; continue end

        local objPos  = item.CFrame:PointToObjectSpace(pp)
        local localZ  = math.abs(objPos.Z)
        local curSide = math.sign(objPos.Z); if curSide==0 then curSide=1 end

        local oldCF = lastCF[item]
        lastCF[item] = item.CFrame
        local vel, av = getLaserMotion(item, oldCF, dt)
        local spd = vel.Magnitude

        -- Check if laser has passed
        if not passed[item] then
            if spd > LASER_MIN_SPD then
                local toP = Vector3.new(pp.X-item.Position.X, 0, pp.Z-item.Position.Z)
                local fv  = Vector3.new(vel.X,0,vel.Z)
                if toP.Magnitude>0.01 then
                    local dot = fv:Dot(toP.Unit)
                    if dot < PASS_VEL_DOT and localZ < PASS_DIST then
                        passed[item]=true
                    end
                end
                local prev=lastSide[item]
                if prev and prev~=curSide then passed[item]=true end
            end
        end

        lastSide[item]=curSide
        if passed[item] then continue end
        if localZ>AGGRO_DIST then continue end

        local tti = spd>0.1 and (localZ/spd) or 999

        -- Reject if laser is moving AWAY from player
        if spd > LASER_MIN_SPD then
            local fcf = futureCF(item, vel, av, 0.1)
            local fop = fcf:PointToObjectSpace(pp)
            if math.abs(fop.Z) > localZ + 2.0 then continue end
        end

        table.insert(out, {
            laser=item, localZ=localZ, tti=tti,
            vel=vel, av=av, objPos=objPos,
            side=curSide, wd=wd, spd=spd
        })
    end

    table.sort(out, function(a,b) return a.tti<b.tti end)
    return out
end

-- ==========================================
-- PERPENDICULAR JUMP DIRECTION
-- ==========================================
-- Returns the best direction to jump straight
-- over a laser. Tries straight perp first, then
-- small angle adjustments if unsafe.
local function getBestJumpDir(primary, threats)
    local laser = primary.laser

    -- Perpendicular to the laser's length axis
    -- laser.CFrame.LookVector points along the laser length
    -- perpendicular (across width) = RightVector
    local fwd   = Vector3.new(laser.CFrame.LookVector.X, 0, laser.CFrame.LookVector.Z)
    if fwd.Magnitude < 0.01 then fwd = Vector3.new(1,0,0) end
    fwd = fwd.Unit

    -- There are two perp directions: +right or -right
    -- Pick the one that takes us AWAY from arena edge (stays more central)
    local perpA = Vector3.new(fwd.Z, 0, -fwd.X)   -- right of laser
    local perpB = Vector3.new(-fwd.Z, 0, fwd.X)   -- left of laser

    -- Both directions should land us on the other side of the laser
    -- The laser is a slab: we want to land past it
    -- Choose the side that results in landing closer to arena center
    local jp, tAir, _, ws = getJump()
    local sp = root.Position

    local function landDist(dir)
        local lp = clamp(Vector3.new(sp.X+dir.X*ws*tAir, FLOOR_Y+0.5, sp.Z+dir.Z*ws*tAir))
        local dx=lp.X-MAP_X; local dz=lp.Z-MAP_Z
        return math.sqrt(dx*dx+dz*dz)
    end

    -- Primary candidate: the perp direction that lands more centrally
    local baseDir = (landDist(perpA) <= landDist(perpB)) and perpA or perpB

    -- Try angle sweep to find safe arc
    for _, deg in ipairs(ANGLE_STEPS) do
        local rad = math.rad(deg)
        local cos = math.cos(rad); local sin = math.sin(rad)
        local testDir = Vector3.new(
            baseDir.X*cos - baseDir.Z*sin,
            0,
            baseDir.X*sin + baseDir.Z*cos
        )
        local safe, gap = arcSafe(threats, testDir, nil, 0)
        if safe then
            return testDir, true, gap
        end
    end

    -- Try the other perpendicular direction too
    local altBase = (baseDir == perpA) and perpB or perpA
    for _, deg in ipairs(ANGLE_STEPS) do
        local rad = math.rad(deg)
        local cos = math.cos(rad); local sin = math.sin(rad)
        local testDir = Vector3.new(
            altBase.X*cos - altBase.Z*sin,
            0,
            altBase.X*sin + altBase.Z*cos
        )
        local safe, gap = arcSafe(threats, testDir, nil, 0)
        if safe then
            return testDir, true, gap
        end
    end

    -- Nothing safe found — return best guess
    return baseDir, false, 0
end

-- ==========================================
-- SAFE POSITION
-- ==========================================
local function scorePos(pos, threats)
    local score = 0
    for _,th in ipairs(threats) do
        local op   = th.laser.CFrame:PointToObjectSpace(pos)
        local lZ   = math.abs(op.Z)
        local tti  = math.max(th.tti, 0.05)
        local fop  = futureCF(th.laser, th.vel, th.av, tti*0.5):PointToObjectSpace(pos)
        local fZ   = math.abs(fop.Z)
        score = score + (lZ*0.5 + fZ*0.5) / tti
    end
    return score
end

local function getBestSafe(threats, now)
    if cachedSafe and (now-lastSafeTime)<SAFE_UPDATE_HZ then
        return cachedSafe
    end
    if #threats==0 then
        cachedSafe=mapCenter; lastSafeTime=now; return mapCenter
    end
    local best=-math.huge; local bestPos=mapCenter
    local fy = FLOOR_Y+0.5
    for i=0,SAFE_SCORE_ANGLES-1 do
        local a = (i/SAFE_SCORE_ANGLES)*math.pi*2
        local c = Vector3.new(
            MAP_X + math.cos(a)*SAFE_RADIUS_RING,
            fy,
            MAP_Z + math.sin(a)*SAFE_RADIUS_RING
        )
        local s = scorePos(c, threats)
        if s>best then best=s; bestPos=c end
    end
    -- Also check center
    local cs = scorePos(mapCenter, threats)
    if cs>best then bestPos=mapCenter end

    cachedSafe=bestPos; lastSafeTime=now; return bestPos
end

-- ==========================================
-- MOVEMENT HELPERS
-- ==========================================
local function moveTo(pos)
    if lastMovePos then
        local dx=pos.X-lastMovePos.X; local dz=pos.Z-lastMovePos.Z
        if dx*dx+dz*dz < MOVE_THRESH*MOVE_THRESH then return end
    end
    lastMovePos=pos; hum:MoveTo(pos)
end

local function clearMove() lastMovePos=nil end

local function onArena()
    local p=root.Position
    local dx=p.X-MAP_X; local dz=p.Z-MAP_Z
    return math.sqrt(dx*dx+dz*dz)<=(ARENA_R+6)
        and p.Y>=FLOOR_Y-1 and p.Y<=FLOOR_Y+9
end

-- ==========================================
-- MAIN LOOP
-- ==========================================
RunService.Heartbeat:Connect(function(dt)
    if not char or hum.Health<=0 then
        hideArc(); safeDot.Transparency=1
        setStatus("Dead",Color3.fromRGB(255,80,80))
        clearMove(); return
    end

    local now = tick()
    lTimer.Text = string.format("[v22] %.1fs", now-runStart)

    if not onArena() then
        hideArc(); safeDot.Transparency=1
        setStatus("Off arena",Color3.fromRGB(180,180,180))
        clearMove(); lastRootPos=nil; return
    end

    -- Track real movement direction
    if lastRootPos then
        local fl=Vector3.new(root.Position.X-lastRootPos.X,0,root.Position.Z-lastRootPos.Z)
        if fl.Magnitude>0.005 then realMoveDir=fl.Unit end
    end
    lastRootPos=root.Position

    local threats = collectThreats(dt)
    local state   = hum:GetState()
    local inAir   = state==Enum.HumanoidStateType.Freefall
                 or state==Enum.HumanoidStateType.Jumping
    local canJump = (now-lastJumpTime)>=JUMP_COOLDOWN

    -- ---- Update HUD TTI ----
    if #threats>0 then
        lTTI.Text = string.format("TTI: %.2fs  lZ=%.1f", threats[1].tti, threats[1].localZ)
    else
        lTTI.Text = "TTI: safe"
    end

    local bestSafe = getBestSafe(threats, now)
    safeDot.Position=bestSafe; safeDot.Transparency=0.3

    -- ====== NO THREATS: stand calmly at safe pos ======
    if #threats==0 then
        hideArc()
        jumpPending=false
        setStatus("Safe - holding pos",Color3.fromRGB(80,220,160))
        if not inAir then moveTo(bestSafe) end
        return
    end

    local primary = threats[1]

    -- ====== IN AIR: steer toward landing target ======
    if inAir then
        if jumpPending then
            -- Steer toward our planned landing spot
            moveTo(jumpPendingTarget)
        else
            -- Not our jump, just keep going toward safe
            moveTo(bestSafe)
        end
        return
    end

    -- ====== ON GROUND ======

    -- Fire a pending jump if its delay has elapsed
    if jumpPending and now >= jumpPendingTime then
        -- Re-validate the arc is still safe (threats may have changed)
        local safe, gap = arcSafe(threats, jumpPendingDir, nil, 0)
        if safe then
            jumpCount=jumpCount+1
            lJumps.Text=string.format("Jumps: %d",jumpCount)
            lastJumpTime=now; jumpPending=false
            clearMove()
            hum:MoveTo(jumpPendingTarget)
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
            setStatus("JUMP!",Color3.fromRGB(60,255,100))
            drawArc(root.Position, jumpPendingDir, true)
            return
        else
            -- Arc became unsafe during reaction delay - cancel and replan
            jumpPending=false
            setStatus("Arc unsafe - replanning",Color3.fromRGB(255,120,40))
        end
    end

    -- Current position safety: is primary threat in our TTI window?
    local inWindow = primary.tti <= JUMP_MAX_TTI
    local mustJump = primary.tti <= JUMP_MIN_TTI

    -- ---- Decide whether to reposition or hold ----
    local needsReposition = primary.tti > REPOSITION_TTI

    if needsReposition and not jumpPending then
        -- Safe to walk to best position, laser is far away
        moveTo(bestSafe)
        setStatus("Walking to safe pos",Color3.fromRGB(140,180,255))
        hideArc()
        return
    end

    -- ---- Laser is approaching: prepare jump ----
    if inWindow and canJump and not jumpPending then
        local dir, safe, gap = getBestJumpDir(primary, threats)

        -- Compute landing target
        local _, tAir, _, ws = getJump()
        local rawLand = Vector3.new(
            root.Position.X + dir.X*ws*tAir,
            FLOOR_Y+0.5,
            root.Position.Z + dir.Z*ws*tAir
        )
        local landTarget = clamp(rawLand)

        drawArc(root.Position, dir, safe)

        if safe then
            -- Queue jump with human reaction delay
            local delay = REACT_DELAY_MIN + math.random()*(REACT_DELAY_MAX-REACT_DELAY_MIN)
            jumpPending       = true
            jumpPendingTime   = now + delay
            jumpPendingDir    = dir
            jumpPendingTarget = landTarget
            setStatus("Ready to jump...",Color3.fromRGB(255,200,60))
        else
            -- No safe arc found
            if mustJump then
                -- Have to jump even if risky - find least-bad direction
                jumpCount=jumpCount+1
                lJumps.Text=string.format("Jumps: %d",jumpCount)
                lastJumpTime=now
                clearMove()
                hum:MoveTo(landTarget)
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
                setStatus("FORCED JUMP",Color3.fromRGB(255,80,80))
                drawArc(root.Position, dir, false)
            else
                -- Wait for better timing
                moveTo(bestSafe)
                setStatus("No safe arc yet",Color3.fromRGB(255,120,40))
            end
        end
        return
    end

    -- ---- Laser too far: hold position ----
    if not jumpPending then
        moveTo(bestSafe)
        setStatus(string.format("Holding - TTI %.2fs",primary.tti),Color3.fromRGB(140,180,255))
        hideArc()
    end
end)
